+
+/// [lifecycle Level 1] Profile H rule H9: the pre-check uses the same caps, budget and ordering as the
+/// KMS connectors' `profile_h` settings. Every field is ignored while `enabled` is false (the default),
+/// and the pre-check then runs as before, with `erc1271_gas_limit`.
+#[derive(Debug, Deserialize, Clone, PartialEq)]
+#[serde(default)]
+pub struct ProfileHPrecheckConfig {
+    pub enabled: bool,
+    /// Ordering of the signature check (H2, H8): `off`, `shadow` or `enforce`.
+    pub code_first_mode: String,
+    /// `B_exec`: execution gas for `isValidSignature`, excluding the intrinsic and calldata gas (H3).
+    pub erc1271_execution_budget: u64,
+    /// H1 caps, in bytes, checked before any host-chain read.
+    pub max_user_signature_bytes: usize,
+    pub max_public_key_bytes: usize,
+    pub max_extra_data_bytes: usize,
+    /// H4: ERC-1271 negatives allowed per request, a block apart.
+    pub max_erc1271_attempts: u8,
+    /// H2's narrow EIP-7702 fallback (Profile Q switches it off).
+    pub eip7702_fallback: bool,
+}
+
+impl Default for ProfileHPrecheckConfig {
+    fn default() -> Self {
+        let policy = SignaturePolicy::default();
+        Self {
+            enabled: false,
+            code_first_mode: CodeFirstMode::Off.as_str().to_string(),
+            erc1271_execution_budget: policy.erc1271_execution_budget,
+            max_user_signature_bytes: policy.max_user_signature_bytes,
+            max_public_key_bytes: policy.max_public_key_bytes,
+            max_extra_data_bytes: policy.max_extra_data_bytes,
+            max_erc1271_attempts: policy.max_erc1271_attempts,
+            eip7702_fallback: policy.eip7702_fallback,
+        }
+    }
+}
+
+impl ProfileHPrecheckConfig {
+    /// The shared-crate policy for these values, or `None` while Profile H is disabled.
+    pub fn signature_policy(&self) -> Result<Option<SignaturePolicy>, AppConfigError> {
+        if !self.enabled {
+            return Ok(None);
+        }
+        let mode = self.code_first_mode.parse().map_err(|e: String| {
+            AppConfigError::Config(format!(
+                "user_decrypt_signature_check.profile_h.code_first_mode: {e}"
+            ))
+        })?;
+        Ok(Some(SignaturePolicy {
+            mode,
+            erc1271_execution_budget: self.erc1271_execution_budget,
+            max_user_signature_bytes: self.max_user_signature_bytes,
+            max_public_key_bytes: self.max_public_key_bytes,
+            max_extra_data_bytes: self.max_extra_data_bytes,
+            max_erc1271_attempts: self.max_erc1271_attempts,
+            eip7702_fallback: self.eip7702_fallback,
+        }))
+    }
 }
 

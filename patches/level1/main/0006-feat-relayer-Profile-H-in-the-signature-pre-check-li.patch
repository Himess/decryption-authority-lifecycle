+
+    /// [lifecycle Level 1] The pre-check under Profile H (H9): the shared crate applies the
+    /// verifier's caps before any read (H1), its ordering at one block (H2) and its budget (H3).
+    /// What is retried stays as above: transport failures and empty reverts, within the retry
+    /// window, and an empty revert only at a later block (H4). Every other rejection is
+    /// definitive.
+    async fn verify_profile_h(
+        &self,
+        provider: &RootProvider,
+        chain_id: u64,
+        input: &SignatureInput<'_>,
+        policy: &SignaturePolicy,
+    ) -> Result<(), SigPreCheckError> {
+        let signer = input.signer;
+        let max_attempts = self.retry.max_attempts.max(1);
+        let interval = Duration::from_millis(self.retry.retry_interval_ms);
+        let mut attempts = AttemptState::default();
+        let mut last_retryable: Option<Erc1271Error> = None;
+
+        for attempt in 0..max_attempts {
+            let outcome = verify_user_decryption_signature(provider, input, policy, attempts).await;
+            attempts = outcome.attempts;
+            if let Some(report) = outcome.shadow() {
+                if report.would_reject() || report.would_accept() {
+                    info!(
+                        signer = %signer,
+                        chain_id,
+                        would_reject = report.would_reject(),
+                        would_accept = report.would_accept(),
+                        served = ?report.served,
+                        code_first = ?report.code_first,
+                        code = ?report.code,
+                        "Profile H shadow: the code-first ordering decides differently"
+                    );
+                }
+            }
+            let rejection = match outcome.result {
+                Ok(_) => return Ok(()),
+                Err(rejection) => rejection,
+            };
+            match (rejection.disposition, rejection.error) {
+                (Disposition::Transport, e) => last_retryable = Some(e),
+                (Disposition::RetryNextBlock, e @ Erc1271Error::EmptyRevert(_)) => {
+                    last_retryable = Some(e)
+                }
+                // Nothing was called: the earlier empty revert stands until a later block.
+                (Disposition::AwaitingNextBlock, _) => {}
+                (_, e) => {
+                    return Err(SigPreCheckError::Invalid {
+                        signer,
+                        reason: e.to_string(),
+                    });
+                }
+            }
+            if attempt + 1 < max_attempts {
+                warn!(
+                    signer = %signer,
+                    chain_id,
+                    attempt = attempt + 1,
+                    max_attempts,
+                    disposition = ?rejection.disposition,
+                    "Profile H signature pre-check not decided yet, retrying"
+                );
+                tokio::time::sleep(interval).await;
+            }
+        }
+
+        match last_retryable {
+            Some(e @ Erc1271Error::EmptyRevert(_)) => Err(SigPreCheckError::Invalid {
+                signer,
+                reason: e.to_string(),
+            }),
+            Some(e) => Err(SigPreCheckError::HostCallFailed(e.to_string())),
+            None => Err(SigPreCheckError::HostCallFailed(
+                "signature pre-check exhausted its attempts without a result".to_string(),
+            )),
+        }
+    }
 }
 
 /// All handles in a unified request share one host chain (the EIP-712 domain carries a single
@@ -241,6 +336,7 @@ mod tests {
                 max_attempts: 3,
                 retry_interval_ms: 0,
             },
+            profile_h: None,
         }
     }
 
@@ -335,4 +431,179 @@ mod tests {
         assert_eq!(single_chain_id([&h1, &h1]).unwrap(), 8009);
         assert!(single_chain_id(std::iter::empty()).is_err());
     }
+
+    // [lifecycle Level 1] Profile H in the pre-check (H9). The mock answers in queue order and
+    // fails any request beyond the queue, so each test pins the RPC sequence.
+
+    use alloy::primitives::{B256, U64};
+    use alloy::signers::{local::PrivateKeySigner, SignerSync};
+    use user_decryption_signature::{CodeFirstMode, ERC1271_MAGIC_VALUE};
+
+    fn profile_h_checker(
+        asserter: Asserter,
+        mode: CodeFirstMode,
+    ) -> UserDecryptSignaturePreChecker {
+        let mut checker = checker(asserter);
+        checker.profile_h = Some(SignaturePolicy {
+            mode,
+            ..SignaturePolicy::default()
+        });
+        checker
+    }
+
+    /// The digest `verify` recomputes for `unified_request(_)` from `user`.
+    fn digest_of(user: Address) -> B256 {
+        let payload = UserDecryptionRequestPayload {
+            userAddress: user,
+            publicKey: Bytes::new(),
+            allowedContracts: vec![],
+            requestValidity: SolRequestValiditySeconds {
+                startTimestamp: U256::ZERO,
+                durationSeconds: U256::ZERO,
+            },
+            extraData: Bytes::new(),
+            signature: Bytes::new(),
+        };
+        let domain = default_user_decrypt_domain(TEST_CHAIN_ID, Address::from([0xCA; 20]));
+        compute_user_decrypt_digest(&payload, &domain)
+    }
+
+    /// A unified request from a fresh key's address, with that key's 65-byte signature.
+    fn signed_request() -> UserDecryptRequest {
+        let key = PrivateKeySigner::random();
+        let signature = key
+            .sign_hash_sync(&digest_of(key.address()))
+            .unwrap()
+            .as_bytes();
+        let mut request = unified_request(Bytes::copy_from_slice(&signature));
+        if let UserDecryptRequest::Eip712UnifiedV1 { user_address, .. } = &mut request {
+            *user_address = key.address();
+        }
+        request
+    }
+
+    fn word(prefix: [u8; 4]) -> Bytes {
+        let mut r = [0u8; 32];
+        r[..4].copy_from_slice(&prefix);
+        Bytes::copy_from_slice(&r)
+    }
+
+    fn eip7702_code(delegate: Address) -> Bytes {
+        let mut code = vec![0xef, 0x01, 0x00];
+        code.extend_from_slice(delegate.as_slice());
+        Bytes::from(code)
+    }
+
+    #[tokio::test]
+    async fn profile_h_caps_refuse_before_any_rpc() {
+        // H1: a 65,537-byte signature is refused with no host-chain read (the queue is empty).
+        let err = profile_h_checker(Asserter::new(), CodeFirstMode::Enforce)
+            .verify(&unified_request(Bytes::from(vec![0x11; 65_537])))
+            .await
+            .unwrap_err();
+        match err {
+            SigPreCheckError::Invalid { reason, .. } => {
+                assert!(reason.contains("65537"), "{reason}")
+            }
+            other => panic!("expected Invalid, got {other:?}"),
+        }
+    }
+
+    #[tokio::test]
+    async fn profile_h_off_accepts_an_eoa_signature_with_no_rpc() {
+        // `off` keeps today's ordering: ecrecover first, no host-chain read.
+        profile_h_checker(Asserter::new(), CodeFirstMode::Off)
+            .verify(&signed_request())
+            .await
+            .unwrap();
+    }
+
+    #[tokio::test]
+    async fn profile_h_enforce_refuses_a_7702_root_key_its_delegate_rejects() {
+        // H2: the code is read first at block B; the 7702 account's delegate answers wrong
+        // magic at the same B, and the root key's ECDSA signature does not override it.
+        let asserter = Asserter::new();
+        asserter.push_success(&U64::from(16));
+        asserter.push_success(&eip7702_code(Address::from([0x77; 20])));
+        asserter.push_success(&word([0xff, 0xff, 0xff, 0xff]));
+        let err = profile_h_checker(asserter, CodeFirstMode::Enforce)
+            .verify(&signed_request())
+            .await
+            .unwrap_err();
+        match err {
+            SigPreCheckError::Invalid { reason, .. } => {
+                assert!(reason.to_lowercase().contains("magic"), "{reason}")
+            }
+            other => panic!("expected Invalid, got {other:?}"),
+        }
+    }
+
+    #[tokio::test]
+    async fn profile_h_enforce_accepts_an_eoa_after_one_code_read() {
+        let asserter = Asserter::new();
+        asserter.push_success(&U64::from(16));
+        asserter.push_success(&Bytes::new());
+        profile_h_checker(asserter, CodeFirstMode::Enforce)
+            .verify(&signed_request())
+            .await
+            .unwrap();
+    }
+
+    #[tokio::test]
+    async fn profile_h_empty_revert_is_retried_only_at_a_later_block() {
+        // H4: attempt 1 reverts with no reason at block 16; attempt 2 sees block 16 again and
+        // makes no call; attempt 3 sees block 17 and the wallet answers the magic value.
+        let asserter = Asserter::new();
+        asserter.push_success(&U64::from(16));
+        asserter.push_failure(empty_revert());
+        asserter.push_success(&U64::from(16));
+        asserter.push_success(&U64::from(17));
+        asserter.push_success(&word(ERC1271_MAGIC_VALUE));
+        profile_h_checker(asserter, CodeFirstMode::Off)
+            .verify(&unified_request(Bytes::from(vec![0x11; 100])))
+            .await
+            .unwrap();
+    }
+
+    #[tokio::test]
+    async fn profile_h_wrong_magic_is_definitive_for_the_precheck() {
+        // As before Profile H, only empty reverts and transport failures are retried.
+        let asserter = Asserter::new();
+        asserter.push_success(&U64::from(16));
+        asserter.push_success(&word([0xff, 0xff, 0xff, 0xff]));
+        let err = profile_h_checker(asserter, CodeFirstMode::Off)
+            .verify(&unified_request(Bytes::from(vec![0x11; 100])))
+            .await
+            .unwrap_err();
+        assert!(matches!(err, SigPreCheckError::Invalid { .. }), "{err:?}");
+    }
+
+    #[test]
+    fn profile_h_settings_default_off_and_reject_an_unknown_mode() {
+        use crate::config::settings::ProfileHPrecheckConfig;
+        assert!(ProfileHPrecheckConfig::default()
+            .signature_policy()
+            .unwrap()
+            .is_none());
+        let enabled = ProfileHPrecheckConfig {
+            enabled: true,
+            code_first_mode: "enforce".to_string(),
+            ..ProfileHPrecheckConfig::default()
+        };
+        let policy = enabled.signature_policy().unwrap().unwrap();
+        assert_eq!(policy.mode, CodeFirstMode::Enforce);
+        assert_eq!(
+            policy,
+            SignaturePolicy {
+                mode: CodeFirstMode::Enforce,
+                ..SignaturePolicy::default()
+            }
+        );
+        let bogus = ProfileHPrecheckConfig {
+            enabled: true,
+            code_first_mode: "bogus".to_string(),
+            ..ProfileHPrecheckConfig::default()
+        };
+        assert!(bogus.signature_policy().is_err());
+    }
 }

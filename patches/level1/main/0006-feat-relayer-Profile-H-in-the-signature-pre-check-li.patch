 #[derive(Debug, Deserialize, Clone)]
 pub struct UserDecryptSignatureCheckConfig {
     pub erc1271_gas_limit: u64,
+    /// [lifecycle Level 1] Profile H for the pre-check. Off by default.
+    #[serde(default)]
+    pub profile_h: ProfileHPrecheckConfig,

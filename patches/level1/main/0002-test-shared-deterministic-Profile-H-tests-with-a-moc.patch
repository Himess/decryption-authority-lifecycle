+#[tokio::test]
+async fn h8_shadow_shares_one_isvalidsignature_call() {
+    // A contract wallet that returns magic: both orderings accept, with ONE isValidSignature call at ONE block.
+    let digest = B256::repeat_byte(21);
+    let signer = Address::repeat_byte(22);
+    let sig = vec![0x55u8; 1_000];
+    let a = Asserter::new();
+    push_block(&a, BLOCK); // served (Off): blockNumber, then the call
+    a.push_success(&magic());
+    a.push_success(&regular_code()); // code-first: getCode at the same block, call reused
+    let out = verify_user_decryption_signature(
+        &provider(&a),
+        &input(signer, digest, &sig),
+        &policy(CodeFirstMode::Shadow),
+        AttemptState::default(),
+    )
+    .await;
+    let v = out.result.unwrap();
+    assert_eq!(v.erc1271_calls, 1);
+    let s = v.shadow.unwrap();
+    assert_eq!(s.served, VerdictSummary::Accept(AcceptPath::Erc1271));
+    assert_eq!(s.code_first, VerdictSummary::Accept(AcceptPath::Erc1271));
+    assert!(!s.would_reject() && !s.would_accept());
+    assert_eq!(rpcs_left(&a), 0);
+}

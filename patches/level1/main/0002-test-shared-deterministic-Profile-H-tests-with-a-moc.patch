+#[tokio::test]
+async fn h4_off_mode_is_bounded_too() {
+    let digest = B256::repeat_byte(18);
+    let signer = Address::repeat_byte(19);
+    let sig = vec![0x44u8; 100];
+    let p = policy(CodeFirstMode::Off);
+    let a = Asserter::new();
+    push_block(&a, BLOCK);
+    a.push_success(&wrong_magic());
+    let o1 = verify_user_decryption_signature(
+        &provider(&a),
+        &input(signer, digest, &sig),
+        &p,
+        AttemptState::default(),
+    )
+    .await;
+    let a = Asserter::new();
+    push_block(&a, BLOCK + 1);
+    a.push_failure(revert("0x"));
+    let o2 = verify_user_decryption_signature(
+        &provider(&a),
+        &input(signer, digest, &sig),
+        &p,
+        o1.attempts,
+    )
+    .await;
+    assert_eq!(o2.result.unwrap_err().disposition, Disposition::Final);
+}

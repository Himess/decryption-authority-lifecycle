+#[tokio::test]
+async fn h8_shadow_serves_off_and_reports_would_reject() {
+    let digest = B256::repeat_byte(20);
+    let (signer, sig) = signed(digest);
+    // Served: ecrecover (no RPC). Code-first: blockNumber, getCode (7702), isValidSignature -> wrong magic.
+    let a = Asserter::new();
+    push_block(&a, BLOCK);
+    a.push_success(&eip7702_code(Address::repeat_byte(0xd5)));
+    a.push_success(&wrong_magic());
+    let out = verify_user_decryption_signature(
+        &provider(&a),
+        &input(signer, digest, &sig),
+        &policy(CodeFirstMode::Shadow),
+        AttemptState::default(),
+    )
+    .await;
+    let shadow = out.shadow().cloned().unwrap();
+    assert_eq!(shadow.served, VerdictSummary::Accept(AcceptPath::Ecrecover));
+    assert!(matches!(
+        shadow.code_first,
+        VerdictSummary::Reject(Erc1271Error::WrongMagic(..))
+    ));
+    assert!(shadow.would_reject());
+    let v = out.result.unwrap();
+    assert_eq!(v.path, AcceptPath::Ecrecover, "the served verdict is Off's");
+    assert_eq!(
+        out.attempts,
+        AttemptState::default(),
+        "the hypothetical verdict is not counted"
+    );
+    assert_eq!(rpcs_left(&a), 0);
+}

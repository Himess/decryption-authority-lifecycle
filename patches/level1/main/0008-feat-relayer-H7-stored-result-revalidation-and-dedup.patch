+    /// [lifecycle Level 1, Profile H, H7] Revalidates stored results with `acl` before serving them.
+    pub fn with_stored_result_acl(mut self, acl: Arc<HostAclChecker>) -> Self {
+        self.stored_result_acl = Some(acl);
+        self
+    }
+
+    /// [lifecycle Level 1, Profile H, H7] Rule V6, before stored shares are served: the host-ACL check
+    /// of the stored request at a fresh decision block. `Some(response)` refuses, `None` serves.
+    async fn revalidate_stored_result(
+        &self,
+        job_id: Uuid,
+        request_id: Uuid,
+    ) -> Option<axum::response::Response> {
+        let acl = self.stored_result_acl.as_ref()?;
+        let refused = |status: StatusCode, error: V2ErrorResponseBody| {
+            Some(
+                (
+                    status,
+                    Json(UserDecryptStatusResponseJson {
+                        status: ApiResponseStatus::Failed,
+                        request_id: request_id.to_string(),
+                        result: None,
+                        error: Some(error),
+                    }),
+                )
+                    .into_response(),
+            )
+        };
+        let (int_job_id, request) = match self
+            .user_decrypt_repo
+            .find_request_by_ext_job_id(job_id)
+            .await
+        {
+            Ok(Some(found)) => found,
+            Ok(None) => {
+                error!(ext_job_id = %job_id, "PROFILE-H H7: stored request not found");
+                return refused(
+                    StatusCode::INTERNAL_SERVER_ERROR,
+                    V2ErrorResponseBody::internal_server_error("Internal server error"),
+                );
+            }
+            Err(e) => {
+                error!(ext_job_id = %job_id, error = %e, "PROFILE-H H7: stored request unreadable");
+                return refused(
+                    StatusCode::INTERNAL_SERVER_ERROR,
+                    V2ErrorResponseBody::internal_server_error("Internal server error"),
+                );
+            }
+        };
+        let Ok(job) = JobId::try_from(int_job_id.as_slice()) else {
+            return refused(
+                StatusCode::INTERNAL_SERVER_ERROR,
+                V2ErrorResponseBody::internal_server_error("Internal server error"),
+            );
+        };
+        match acl.check_stored_user_decrypt(&job, &request).await {
+            Ok(()) => {
+                info!(ext_job_id = %job_id, "PROFILE-H H7: stored result revalidated");
+                None
+            }
+            Err(e @ HostAclError::NotAllowed { .. }) => {
+                info!(ext_job_id = %job_id, error = %e, "PROFILE-H H7: stored result not served");
+                refused(
+                    StatusCode::BAD_REQUEST,
+                    V2ErrorResponseBody::not_allowed_on_host_acl(&format!(
+                        "{NOT_ALLOWED_ON_HOST_ACL_PREFIX} {e} (stored result revalidated, Profile H H7)"
+                    )),
+                )
+            }
+            Err(e) => {
+                warn!(ext_job_id = %job_id, error = %e, "PROFILE-H H7: revalidation failed; not serving");
+                refused(
+                    StatusCode::INTERNAL_SERVER_ERROR,
+                    V2ErrorResponseBody::host_acl_failed(&format!("{HOST_ACL_FAILED_PREFIX} {e}")),
+                )
+            }
         }
     }
 

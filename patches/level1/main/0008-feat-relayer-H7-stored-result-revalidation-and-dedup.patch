+use std::sync::atomic::{AtomicBool, Ordering};
+
+/// [lifecycle Level 1, Profile H, H7] Set once at startup from
+/// `user_decrypt_signature_check.profile_h`: the dedup key of a user decryption request then also
+/// covers its signature and validity window (see [`UserDecryptRequest::dedup_key`]). Process-wide
+/// because every component derives the job id from [`ContentHasher::content_hash`].
+static H7_DEDUP_KEY: AtomicBool = AtomicBool::new(false);
+
+/// [lifecycle Level 1, Profile H, H7] Turns the H7 dedup key on or off for this process.
+pub fn set_h7_dedup_key(on: bool) {
+    H7_DEDUP_KEY.store(on, Ordering::Relaxed);
+}
 
 impl ContentHasher for UserDecryptRequest {
+    /// The dedup key of the request: [`UserDecryptRequest::dedup_key`], with H7 as configured.
+    fn content_hash(&self) -> [u8; 32] {
+        self.dedup_key(H7_DEDUP_KEY.load(Ordering::Relaxed))
+    }
+}
+
+impl UserDecryptRequest {
+    /// [lifecycle Level 1, Profile H, H7] The dedup key. Without H7, the content hash below. With H7, a
+    /// hash of that content hash, the signature and the validity window: only the very same signed
+    /// request deduplicates, so a stored result is never matched to a new authorization.
+    pub fn dedup_key(&self, h7: bool) -> [u8; 32] {
+        let base = self.base_content_hash();
+        if !h7 {
+            return base;
+        }
+        let (signature, start, duration) = match self {
+            UserDecryptRequest::LegacyDirect {
+                signature,
+                request_validity,
+                ..
+            }
+            | UserDecryptRequest::LegacyDelegated {
+                signature,
+                request_validity,
+                ..
+            } => (
+                signature,
+                request_validity.start_timestamp,
+                request_validity.duration_days,
+            ),
+            UserDecryptRequest::Eip712UnifiedV1 {
+                signature,
+                request_validity,
+                ..
+            } => (
+                signature,
+                request_validity.start_timestamp,
+                request_validity.duration_seconds,
+            ),
+        };
+        let mut hasher = Sha256::new();
+        hasher.update(b"h7:");
+        hasher.update(base);
+        hasher.update(b"signature:");
+        hasher.update(signature);
+        hasher.update(b"validity:");
+        hasher.update(start.to_be_bytes::<32>());
+        hasher.update(duration.to_be_bytes::<32>());
+        hasher.finalize().into()
+    }
+

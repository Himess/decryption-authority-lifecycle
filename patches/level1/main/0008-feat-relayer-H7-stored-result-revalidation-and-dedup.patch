+    fn h7_dedup_key_covers_signature_and_validity() {
+        for request in [
+            sample_legacy_direct(),
+            sample_legacy_delegated(),
+            sample_eip712_unified(),
+        ] {
+            assert_eq!(request.dedup_key(false), request.base_content_hash());
+            assert_eq!(request.dedup_key(true), request.dedup_key(true));
+            assert_ne!(request.dedup_key(true), request.dedup_key(false));
+
+            let mut resigned = request.clone();
+            let mut later = request.clone();
+            match (&mut resigned, &mut later) {
+                (
+                    UserDecryptRequest::LegacyDirect { signature, .. },
+                    UserDecryptRequest::LegacyDirect {
+                        request_validity, ..
+                    },
+                )
+                | (
+                    UserDecryptRequest::LegacyDelegated { signature, .. },
+                    UserDecryptRequest::LegacyDelegated {
+                        request_validity, ..
+                    },
+                ) => {
+                    *signature = Bytes::from(vec![0x01; 65]);
+                    request_validity.start_timestamp += U256::from(1);
+                }
+                (
+                    UserDecryptRequest::Eip712UnifiedV1 { signature, .. },
+                    UserDecryptRequest::Eip712UnifiedV1 {
+                        request_validity, ..
+                    },
+                ) => {
+                    *signature = Bytes::from(vec![0x01; 65]);
+                    request_validity.start_timestamp += U256::from(1);
+                }
+                _ => unreachable!(),
+            }
+            for other in [&resigned, &later] {
+                assert_eq!(other.dedup_key(false), request.dedup_key(false));
+                assert_ne!(other.dedup_key(true), request.dedup_key(true));
+            }
+        }
+    }

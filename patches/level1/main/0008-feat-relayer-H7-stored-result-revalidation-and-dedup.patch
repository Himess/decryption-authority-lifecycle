diff --git a/relayer/tests/user_decrypt_v3_h7_test.rs b/relayer/tests/user_decrypt_v3_h7_test.rs
new file mode 100644
index 00000000..5e83388b
--- /dev/null
+++ b/relayer/tests/user_decrypt_v3_h7_test.rs
@@ -0,0 +1,211 @@
+//! [lifecycle Level 1, Profile H, H7] Stored user decryption results, end to end through the v3
+//! endpoint with the in-process `TestSetup` harness and the `ethereum_rpc_mock` JSON-RPC mock.
+//!
+//! A request completes while the host ACL allows it. Then every host-ACL answer becomes false, as it
+//! does once the user retires on a registry with the Decryption Authority Lifecycle Core. The same
+//! request is sent again, and an equivalent one (the same user, handle and key, a new validity window
+//! and signature):
+//! - without H7 (today), both are deduplicated onto the stored job and its shares are served, with no
+//!   new host-ACL check;
+//! - with H7, the identical request still deduplicates but its stored shares are refused by the
+//!   revalidation (`not_allowed_on_host_acl`), and the equivalent one is a new job, refused by the
+//!   readiness check.
+//!
+//! Run with one test thread: the H7 dedup key is a process-wide switch set at relayer startup.
+
+mod common;
+
+use crate::common::utils::{
+    register_host_acl_deny_all, sign_v3_user_decrypt_envelope, user_decrypt_test_signer, TestSetup,
+};
+use alloy::primitives::{Address, B256};
+use ethereum_rpc_mock::fhevm::UserDecryptKind;
+use fhevm_relayer::http::endpoints::v2::types::error::ApiResponseStatus;
+use fhevm_relayer::http::endpoints::v2::types::user_decrypt::{
+    UserDecryptPostResponseJson, UserDecryptStatusResponseJson,
+};
+use serde_json::json;
+use std::str::FromStr;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+fn post_url(setup: &TestSetup) -> String {
+    format!("http://localhost:{}/v3/user-decrypt", setup.http_port)
+}
+
+fn get_url(setup: &TestSetup, job_id: &str) -> String {
+    format!(
+        "http://localhost:{}/v3/user-decrypt/{}",
+        setup.http_port, job_id
+    )
+}
+
+/// A unified v3 envelope for one direct handle, signed by the fixed test signer; `start` is the
+/// validity window's start (Unix seconds).
+fn envelope(handle: &str, contract: Address, public_key: &str, start: u64) -> serde_json::Value {
+    let signer = user_decrypt_test_signer();
+    let user = signer.address();
+    let mut envelope = json!({
+        "attestationType": "eip712-unified-user-decrypt-v1",
+        "attestedPayload": {
+            "version": "2.0",
+            "type": "user_decryption",
+            "handles": [{
+                "ctHandle": handle,
+                "contractAddress": format!("{:?}", contract),
+                "ownerAddress": format!("{:?}", user),
+            }],
+            "userAddress": format!("{:?}", user),
+            "allowedContracts": [format!("{:?}", contract)],
+            "requestValidity": {
+                "startTimestamp": start.to_string(),
+                "durationSeconds": "604800",
+            },
+            "publicKey": public_key,
+            "extraData": "0x00",
+        },
+        "signature": "0x",
+    });
+    sign_v3_user_decrypt_envelope(&mut envelope, &signer);
+    envelope
+}
+
+async fn post(setup: &TestSetup, payload: &serde_json::Value) -> String {
+    let response = reqwest::Client::new()
+        .post(post_url(setup))
+        .header("Content-Type", "application/json")
+        .timeout(Duration::from_secs(10))
+        .json(payload)
+        .send()
+        .await
+        .expect("POST failed");
+    assert_eq!(response.status(), reqwest::StatusCode::ACCEPTED);
+    let body: UserDecryptPostResponseJson = response.json().await.expect("POST body");
+    body.result.job_id
+}
+
+/// Polls GET until it is no longer 202: (HTTP status, API status, error label, share count).
+async fn get_terminal(setup: &TestSetup, job_id: &str) -> (u16, ApiResponseStatus, String, usize) {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    loop {
+        tokio::time::sleep(Duration::from_millis(300)).await;
+        let response = reqwest::Client::new()
+            .get(get_url(setup, job_id))
+            .timeout(Duration::from_secs(10))
+            .send()
+            .await
+            .expect("GET failed");
+        let status = response.status();
+        if status == reqwest::StatusCode::ACCEPTED {
+            assert!(
+                Instant::now() < deadline,
+                "job {job_id} never reached a terminal state"
+            );
+            continue;
+        }
+        let body: UserDecryptStatusResponseJson = response.json().await.expect("GET body");
+        let label = body
+            .error
+            .as_ref()
+            .map(|e| e.label().to_string())
+            .unwrap_or_else(|| "-".to_string());
+        let shares = body.result.as_ref().map(|r| r.result.len()).unwrap_or(0);
+        return (status.as_u16(), body.status, label, shares);
+    }
+}
+
+async fn run(h7: bool) {
+    let variant = if h7 { "h7" } else { "unmodified" };
+    let setup = if h7 {
+        TestSetup::new_with_settings(|s| {
+            s.user_decrypt_signature_check.profile_h.enabled = true;
+            s.user_decrypt_signature_check
+                .profile_h
+                .revalidate_stored_results = true;
+        })
+        .await
+    } else {
+        TestSetup::new().await
+    }
+    .expect("test setup");
+
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    let handle = crate::common::utils::random_handle();
+    let contract = crate::common::utils::random_address();
+    let public_key = format!("0x{}", "ab".repeat(32));
+    let first = envelope(&handle, contract, &public_key, now - 2);
+    let handles: Vec<B256> =
+        vec![B256::from_str(handle.strip_prefix("0x").unwrap_or(&handle)).unwrap()];
+    let user = user_decrypt_test_signer().address();
+    setup.fhevm_mock.on_user_decrypt_success(
+        UserDecryptKind::Unified,
+        handles,
+        user,
+        ethereum_rpc_mock::SubscriptionTarget::All,
+    );
+
+    // 1. Served while the host ACL allows it.
+    let job = post(&setup, &first).await;
+    let (status, api, label, shares) = get_terminal(&setup, &job).await;
+    println!("H7-RESULT variant={variant} step=first status={status} api={api:?} error={label} shares={shares} job_same=-");
+    assert_eq!(status, 200, "{variant}: the first request must be served");
+
+    // 2. The user retires: every host-ACL answer is now false.
+    let acl = Address::from_str(&setup.settings.host_chains[0].acl_address).unwrap();
+    setup.host_server.reset_state();
+    register_host_acl_deny_all(&setup.host_server, acl);
+
+    // 3. The same request again.
+    let again = post(&setup, &first).await;
+    let (status, api, label, shares) = get_terminal(&setup, &again).await;
+    println!(
+        "H7-RESULT variant={variant} step=same-request-after-retirement status={status} api={api:?} error={label} shares={shares} job_same={}",
+        again == job
+    );
+    assert_eq!(again, job, "{variant}: an identical request deduplicates");
+    if h7 {
+        assert_eq!((status, label.as_str()), (400, "not_allowed_on_host_acl"));
+    } else {
+        assert_eq!(
+            (status, shares > 0),
+            (200, true),
+            "today the stored shares are served"
+        );
+    }
+
+    // 4. An equivalent request: a new validity window and signature.
+    let equivalent = envelope(&handle, contract, &public_key, now - 1);
+    let other = post(&setup, &equivalent).await;
+    let (status, api, label, shares) = get_terminal(&setup, &other).await;
+    println!(
+        "H7-RESULT variant={variant} step=equivalent-request-after-retirement status={status} api={api:?} error={label} shares={shares} job_same={}",
+        other == job
+    );
+    if h7 {
+        assert_ne!(
+            other, job,
+            "under H7 the dedup key covers the signature and the window"
+        );
+        assert_eq!((status, label.as_str()), (400, "not_allowed_on_host_acl"));
+    } else {
+        assert_eq!(
+            other, job,
+            "today the dedup key ignores the signature and the window"
+        );
+        assert_eq!((status, shares > 0), (200, true));
+    }
+
+    setup.shutdown().await;
+}
+
+#[tokio::test]
+async fn h7_stored_results_unmodified() {
+    run(false).await;
+}
+
+#[tokio::test]
+async fn h7_stored_results_revalidated() {
+    run(true).await;
+}

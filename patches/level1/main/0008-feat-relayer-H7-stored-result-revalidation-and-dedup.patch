+    /// An ECDSA-disabled delegation indicator (EIP-7851, Draft): `0xef0101 ‖ delegate`.
+    fn eip7851_code(delegate: Address) -> Bytes {
+        let mut code = vec![0xef, 0x01, 0x01];
+        code.extend_from_slice(delegate.as_slice());
+        Bytes::from(code)
+    }
+
+    #[tokio::test]
+    async fn profile_h_enforce_refuses_the_root_key_of_an_ecdsa_disabled_account() {
+        // [lifecycle Phase 4, P0.4] `0xef0101 ‖ delegate` is regular code for H2: the root key's
+        // ECDSA signature counts only through ERC-1271, and the delegate answers wrong magic.
+        let asserter = Asserter::new();
+        asserter.push_success(&U64::from(16));
+        asserter.push_success(&eip7851_code(Address::from([0x77; 20])));
+        asserter.push_success(&word([0xff, 0xff, 0xff, 0xff]));
+        let err = profile_h_checker(asserter, CodeFirstMode::Enforce)
+            .verify(&signed_request())
+            .await
+            .unwrap_err();
+        match err {
+            SigPreCheckError::Invalid { reason, .. } => {
+                assert!(reason.to_lowercase().contains("magic"), "{reason}")
+            }
+            other => panic!("expected Invalid, got {other:?}"),
+        }
+    }
+
+    #[tokio::test]
+    async fn profile_h_enforce_gives_no_shim_to_an_ecdsa_disabled_account() {
+        // [lifecycle Phase 4, P0.4] An empty success from the delegate of `0xef0101 ‖ delegate`
+        // does not open the narrow 7702 fallback: regular code is ERC-1271 only.
+        let asserter = Asserter::new();
+        asserter.push_success(&U64::from(16));
+        asserter.push_success(&eip7851_code(Address::from([0x77; 20])));
+        asserter.push_success(&Bytes::new());
+        let err = profile_h_checker(asserter, CodeFirstMode::Enforce)
+            .verify(&signed_request())
+            .await
+            .unwrap_err();
+        assert!(matches!(err, SigPreCheckError::Invalid { .. }), "{err:?}");
+    }

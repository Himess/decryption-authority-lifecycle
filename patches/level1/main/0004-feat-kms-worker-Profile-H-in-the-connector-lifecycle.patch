+++ b/kms-connector/crates/kms-worker/src/core/event_processor/error.rs
@@ -98,16 +98,25 @@ impl std::error::Error for ProcessingError {
 // terminal, but smart-account validation can depend on mutable wallet state, so negative ERC-1271
 // results (and transport blips) stay recoverable and are retried through the existing attempt and
 // validity-window limits.
+// [lifecycle Level 1] Profile H adds four variants. A cap violation (H1) and an exhausted attempt
+// budget (H4) are final; an empty return on a code-bearing account (H2) and a retry waiting for the
+// next block (H4) are recoverable. Under Profile H the caller maps by `Disposition` instead (see
+// `DecryptionProcessor`), which agrees with this table.
 impl From<Erc1271Error> for ProcessingError {
     fn from(err: Erc1271Error) -> Self {
         match err {
-            Erc1271Error::EoaMismatchNoCode(_) | Erc1271Error::EmptySigOnEoa(_) => {
+            Erc1271Error::EoaMismatchNoCode(_)
+            | Erc1271Error::EmptySigOnEoa(_)
+            | Erc1271Error::CapExceeded { .. }
+            | Erc1271Error::AttemptsExhausted { .. } => {
                 Self::irrecoverable(ErrorCode::UserSignatureRejected, err)
             }
             Erc1271Error::Transport(_) => Self::transient(err),
             Erc1271Error::WrongMagic(..)
             | Erc1271Error::Rejected(..)
-            | Erc1271Error::EmptyRevert(_) => {
+            | Erc1271Error::EmptyRevert(_)
+            | Erc1271Error::EmptyReturn(_)
+            | Erc1271Error::AwaitingNextBlock { .. } => {
                 Self::recoverable(ErrorCode::UserSignatureRejected, err)
             }
         }
@@ -207,7 +216,11 @@ impl From<Erc1271Error> for RequestCheckError {
             | Erc1271Error::EmptySigOnEoa(_)
             | Erc1271Error::EoaMismatchNoCode(_)
             | Erc1271Error::Rejected(..)
-            | Erc1271Error::WrongMagic(..) => RequestCheckKind::Signature,
+            | Erc1271Error::WrongMagic(..)
+            | Erc1271Error::CapExceeded { .. }
+            | Erc1271Error::EmptyReturn(_)
+            | Erc1271Error::AwaitingNextBlock { .. }
+            | Erc1271Error::AttemptsExhausted { .. } => RequestCheckKind::Signature,
         };

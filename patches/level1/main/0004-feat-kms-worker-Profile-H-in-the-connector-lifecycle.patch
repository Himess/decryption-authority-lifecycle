+/// [lifecycle Level 1] Profile H configuration. Every field is ignored while `enabled` is false (the default).
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[cfg_attr(test, derive(Serialize))]
+#[serde(default)]
+pub struct ProfileHConfig {
+    /// Master switch. Off: today's behaviour (`verify_signature` with `erc1271_gas_limit`, retried ACL denials).
+    pub enabled: bool,
+    /// Ordering of the RFC-016 signature check (H2, H8): `off`, `shadow` or `enforce`.
+    pub code_first_mode: String,
+    /// `B_exec`: execution gas for `isValidSignature`, excluding the intrinsic and calldata gas (H3).
+    pub erc1271_execution_budget: u64,
+    /// H1 caps, in bytes, checked before any host-chain read.
+    pub max_user_signature_bytes: usize,
+    pub max_public_key_bytes: usize,
+    pub max_extra_data_bytes: usize,
+    /// H4: ERC-1271 negatives allowed per request, a block apart.
+    pub max_erc1271_attempts: u8,
+    /// H2's narrow EIP-7702 fallback (Profile Q switches it off).
+    pub eip7702_fallback: bool,
+    /// H5 (rule V7): a denial caused by a retired account is final and typed `account_retired`.
+    pub final_retirement_denials: bool,
+    /// H6: refuse requests on the legacy gateway path, where the user's signature is checked by ECDSA only, when the
+    /// user has regular code on the host chain (EIP-7702 delegated accounts are not regular code).
+    pub refuse_regular_code_on_legacy: bool,
+}
+
+impl Default for ProfileHConfig {
+    fn default() -> Self {
+        let policy = SignaturePolicy::default();
+        Self {
+            enabled: false,
+            code_first_mode: CodeFirstMode::Off.as_str().to_string(),
+            erc1271_execution_budget: policy.erc1271_execution_budget,
+            max_user_signature_bytes: policy.max_user_signature_bytes,
+            max_public_key_bytes: policy.max_public_key_bytes,
+            max_extra_data_bytes: policy.max_extra_data_bytes,
+            max_erc1271_attempts: policy.max_erc1271_attempts,
+            eip7702_fallback: policy.eip7702_fallback,
+            final_retirement_denials: true,
+            refuse_regular_code_on_legacy: false,
+        }
+    }
+}
+
+impl ProfileHConfig {
+    /// The shared-crate policy for these values. Panics on an unknown `code_first_mode` (a startup error).
+    pub fn signature_policy(&self) -> SignaturePolicy {
+        SignaturePolicy {
+            mode: self
+                .code_first_mode
+                .parse()
+                .unwrap_or_else(|e| panic!("invalid profile_h.code_first_mode: {e}")),
+            erc1271_execution_budget: self.erc1271_execution_budget,
+            max_user_signature_bytes: self.max_user_signature_bytes,
+            max_public_key_bytes: self.max_public_key_bytes,
+            max_extra_data_bytes: self.max_extra_data_bytes,
+            max_erc1271_attempts: self.max_erc1271_attempts,
+            eip7702_fallback: self.eip7702_fallback,
+        }
+    }
+}

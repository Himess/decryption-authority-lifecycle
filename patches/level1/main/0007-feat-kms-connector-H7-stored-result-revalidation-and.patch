+/// [lifecycle Level 1, Profile H, H7] Rule V6. With `revalidate_stored_results`, a stored user decryption
+/// payload is not served as is: the endpoint drops it and puts the request back to `pending`, keeping
+/// `already_sent`, and the client gets what the kms-worker's new decision produces (here: a retirement).
+#[rstest]
+#[timeout(Duration::from_secs(60))]
+#[tokio::test]
+async fn test_h7_stored_user_payload_is_revalidated() -> anyhow::Result<()> {
+    let endpoint = setup_with(|config| Config {
+        revalidate_stored_results: true,
+        ..config
+    })
+    .await?;
+
+    info!("A first request, served by the worker...");
+    let request = user_request();
+    let id = request.id();
+    let first = endpoint.spawn_udec(&request);
+    wait_for_request_row(&endpoint.db, USER_REQUESTS, id).await;
+    sqlx::query(
+        "UPDATE user_decryption_requests SET status = 'completed', already_sent = TRUE, error_counter = 1
+        WHERE decryption_id = $1",
+    )
+    .bind(db_id(id).as_le_slice().to_vec())
+    .execute(&endpoint.db)
+    .await?;
+    complete_udec(&endpoint.db, id).await?;
+    assert_eq!(first.await?.status(), StatusCode::OK);
+
+    info!("The same request again: the stored payload goes back to the worker...");
+    let second = endpoint.spawn_udec(&request);
+    wait_for_request_status(&endpoint.db, USER_REQUESTS, id, "pending").await;
+    let row = wait_for_request_row(&endpoint.db, USER_REQUESTS, id).await;
+    assert!(row.get::<bool, _>("already_sent"));
+    assert_eq!(row.get::<i16, _>("error_counter"), 0);
+    assert_eq!(
+        count_rows(&endpoint.db, "user_decryption_responses").await,
+        0
+    );
+
+    info!("Playing the worker: the new decision refuses...");
+    fail_user(&endpoint.db, id, "account_retired", "the user has retired").await?;
+    assert_error(
+        second.await?,
+        StatusCode::FORBIDDEN,
+        ErrorCode::AccountRetired,
+        id,
+    )
+    .await;
+    endpoint.stop().await
+}
+
+/// [lifecycle Level 1, Profile H, H7] A stored payload with no request row (as left for an equivalent
+/// request) is revalidated too: the request is stored for the worker. A concurrent duplicate attaches to
+/// the same revalidation, and both get the new decision's payload.
+#[rstest]
+#[timeout(Duration::from_secs(60))]
+#[tokio::test]
+async fn test_h7_duplicates_attach_to_one_revalidation() -> anyhow::Result<()> {
+    let endpoint = setup_with(|config| Config {
+        revalidate_stored_results: true,
+        ..config
+    })
+    .await?;
+
+    let request = user_request();
+    let id = request.id();
+    complete_udec(&endpoint.db, id).await?;
+    let first = endpoint.spawn_udec(&request);
+    wait_for_request_status(&endpoint.db, USER_REQUESTS, id, "pending").await;
+    let second = endpoint.spawn_udec(&request);
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(count_rows(&endpoint.db, USER_REQUESTS).await, 1);
+    assert_eq!(
+        count_rows(&endpoint.db, "user_decryption_responses").await,
+        0
+    );
+
+    info!("Playing the worker: the new decision serves...");
+    let inserted = complete_udec(&endpoint.db, id).await?;
+    for pending in [first, second] {
+        let response = pending.await?;
+        assert_eq!(response.status(), StatusCode::OK);
+        let body: UserDecryptionResponse = response.json().await?;
+        assert_eq!(
+            body.user_decrypted_shares.to_vec(),
+            inserted.user_decrypted_shares
+        );
+    }
+    endpoint.stop().await
+}
+
+/// [lifecycle Level 1, Profile H, H7] Public decryption results do not depend on an account's authority:
+/// they are still served from the stored row.
+#[rstest]
+#[timeout(Duration::from_secs(60))]
+#[tokio::test]
+async fn test_h7_public_payload_is_served_as_is() -> anyhow::Result<()> {
+    let endpoint = setup_with(|config| Config {
+        revalidate_stored_results: true,
+        ..config
+    })
+    .await?;
+
+    let public = public_request();
+    let inserted = complete_public(&endpoint.db, public.id()).await?;
+    let response = endpoint.post_public(&public).await;
+    assert_eq!(response.status(), StatusCode::OK);
+    let body: PublicDecryptionResponse = response.json().await?;
+    assert_eq!(body.decrypted_result.to_vec(), inserted.decrypted_result);
+    assert_eq!(count_rows(&endpoint.db, PUBLIC_REQUESTS).await, 0);
+    endpoint.stop().await
+}

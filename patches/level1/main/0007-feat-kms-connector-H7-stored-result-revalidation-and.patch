+-- [lifecycle Level 1, Profile H, rule H4] ERC-1271 attempt state of user decryption requests, keyed by the
+-- request's EIP-712 digest. Kept in the database, so a restart of the kms-worker no longer grants a request
+-- further attempts. A row is deleted when its request's signature is accepted.
+CREATE TABLE IF NOT EXISTS profile_h_erc1271_attempts (
+    digest BYTEA PRIMARY KEY,
+    negatives SMALLINT NOT NULL,
+    last_negative_block BIGINT,
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);

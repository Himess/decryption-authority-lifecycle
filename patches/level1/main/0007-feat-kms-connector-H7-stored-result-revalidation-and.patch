+/// [lifecycle Level 1, Profile H, H7] Prepares a stored HTTP-sourced user decryption result for
+/// revalidation (rule V6): drops its payload row and puts the request back to `pending` with a fresh
+/// attempt budget. `already_sent` is kept, so the kms-worker runs every check again at a fresh
+/// decision block and then polls the KMS Core for the result instead of sending a new request.
+///
+/// Returns `false`, and changes nothing, when there is no stored payload row to revalidate.
+pub async fn reset_user_decryption_for_revalidation(
+    conn: &mut PgConnection,
+    id: B256,
+) -> anyhow::Result<bool> {
+    let db_id = id_to_db_bytes(id);
+    let dropped = sqlx::query(
+        "DELETE FROM user_decryption_responses
+        WHERE decryption_id = $1 AND source = 'http' AND error_code IS NULL",
+    )
+    .bind(db_id.as_slice())
+    .execute(&mut *conn)
+    .await?
+    .rows_affected();
+    if dropped == 0 {
+        return Ok(false);
+    }
+    sqlx::query(
+        "UPDATE user_decryption_requests
+        SET status = 'pending', error_counter = 0, created_at = $2
+        WHERE decryption_id = $1 AND source = 'http'",
+    )
+    .bind(db_id.as_slice())
+    .bind(Utc::now())
+    .execute(&mut *conn)
+    .await?;
+    Ok(true)
+}

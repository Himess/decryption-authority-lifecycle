+    /// [lifecycle Level 1, Profile H, H4] Keeps the ERC-1271 attempt state in the connector's database, so a
+    /// restart of the worker grants a request no further attempts.
+    pub fn with_attempt_store(mut self, db_pool: Pool<Postgres>) -> Self {
+        self.attempt_store = Some(db_pool);
+        self
+    }
+
+    /// [lifecycle Level 1, Profile H, H4] The attempt state of the request `digest`. A database error is a
+    /// recoverable check failure: the state is unknown, so no attempt is granted.
+    async fn load_attempts(
+        &self,
+        profile_h: &ProfileH,
+        digest: B256,
+    ) -> Result<AttemptState, RequestCheckError> {
+        let Some(db) = &self.attempt_store else {
+            return Ok(profile_h
+                .attempts
+                .lock()
+                .expect("profile_h attempts lock")
+                .get(&digest)
+                .copied()
+                .unwrap_or_default());
+        };
+        let row: Option<(i16, Option<i64>)> = sqlx::query_as(
+            "SELECT negatives, last_negative_block FROM profile_h_erc1271_attempts WHERE digest = $1",
+        )
+        .bind(digest.as_slice())
+        .fetch_optional(db)
+        .await
+        .map_err(|e| RequestCheckError::network(anyhow!("PROFILE-H attempt state unavailable: {e}")))?;
+        Ok(
+            row.map_or_else(AttemptState::default, |(negatives, last)| AttemptState {
+                negatives: u8::try_from(negatives).unwrap_or(u8::MAX),
+                last_negative_block: last.map(|b| b.max(0) as u64),
+            }),
+        )
+    }
+
+    /// [lifecycle Level 1, Profile H, H4] Records the attempt state of the request `digest` after a rejection.
+    async fn save_attempts(
+        &self,
+        profile_h: &ProfileH,
+        digest: B256,
+        state: AttemptState,
+    ) -> Result<(), RequestCheckError> {
+        let Some(db) = &self.attempt_store else {
+            profile_h
+                .attempts
+                .lock()
+                .expect("profile_h attempts lock")
+                .insert(digest, state);
+            return Ok(());
+        };
+        sqlx::query(
+            "INSERT INTO profile_h_erc1271_attempts (digest, negatives, last_negative_block, updated_at)
+            VALUES ($1, $2, $3, NOW())
+            ON CONFLICT (digest) DO UPDATE SET

+// Delegation indicators: a 3-byte prefix and the delegate's address, 23 bytes in all.
+const EIP7702_INDICATOR_PREFIX = '0xef0100';
+const EIP7851_INDICATOR_PREFIX = '0xef0101';
+const DELEGATION_INDICATOR_BYTES = 23;
+
 export type GetAuthorityStatusParameters = {
   readonly address: string;
 };
 
+/**
+ * The account's code as an off-chain verifier reads it (`eth_getCode`):
+ * - `empty`: no code. The account's ECDSA key signs for it.
+ * - `eip7702`: an EIP-7702 delegation indicator, `0xef0100 ‖ delegate`. The ECDSA key still signs for it.
+ * - `eip7851`: an ECDSA-disabled delegation indicator, `0xef0101 ‖ delegate` (EIP-7851, a draft). The key no longer
+ *   authorizes the account on the host chain. Under Profile H, verifiers accept only ERC-1271 signatures from it.
+ * - `regular`: any other code, such as a contract account.
+ */
+export type AccountCode =
+  | { readonly kind: 'empty' }
+  | { readonly kind: 'eip7702' | 'eip7851'; readonly delegate: ChecksummedAddress }
+  | { readonly kind: 'regular' };
+
 export type AuthorityStatus = {
   readonly chainId: number;
   readonly aclAddress: ChecksummedAddress;
   readonly account: ChecksummedAddress;
+  /** The account's code: none, an EIP-7702 or EIP-7851 indicator, or other code. `undefined` when the client's
+   *  Ethereum module cannot read code. */
+  readonly accountCode: AccountCode | undefined;
   /** Whether the ACL declares the lifecycle Core (ERC-165 `0x556d2088`). Without it, no account can retire there. */
   readonly lifecycle: boolean;
   /** Whether the account has retired its decryption authority on this chain. Retirement is one-way. */
@@ -46,10 +68,31 @@ export type GetAuthorityStatusReturnType = AuthorityStatus;
 
 ////////////////////////////////////////////////////////////////////////////////
 
+/** Classifies code as Profile H2 does: only an exact 23-byte indicator is a delegation; anything else is regular. */
+function toAccountCode(code: unknown): AccountCode {
+  assertIsBytesHex(code, { subject: 'account code' });
+  const hex = code.toLowerCase();
+  if (hex === '0x') {
+    return { kind: 'empty' };
+  }
+  if (hex.length === 2 + 2 * DELEGATION_INDICATOR_BYTES) {
+    const prefix = hex.slice(0, 2 + 2 * 3);
+    const kind =
+      prefix === EIP7702_INDICATOR_PREFIX ? 'eip7702' : prefix === EIP7851_INDICATOR_PREFIX ? 'eip7851' : undefined;
+    if (kind !== undefined) {
+      const delegate = `0x${hex.slice(2 + 2 * 3)}`;
+      assertIsAddress(delegate, {});
+      return { kind, delegate: addressToChecksummedAddress(delegate) };
+    }
+  }
+  return { kind: 'regular' };
+}

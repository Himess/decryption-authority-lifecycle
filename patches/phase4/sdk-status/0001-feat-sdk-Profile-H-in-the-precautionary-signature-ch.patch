+  let verdict: Verdict;
+  try {
+    verdict = policy.codeFirstMode === 'enforce' ? await codeFirstVerdict() : await legacyVerdict();
+  } catch (err) {
+    // Inconclusive: no read provider, a module without the reads, or a transport error.
+    const reason = err instanceof Error ? err.message : String(err);

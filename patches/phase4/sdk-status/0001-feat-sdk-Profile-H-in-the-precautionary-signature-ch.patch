+/** [lifecycle Level 1] Field-by-field equality of two Profile H signature policies. */
+export function signaturePoliciesAreEqual(
+  a: UserDecryptSignaturePolicy | undefined,
+  b: UserDecryptSignaturePolicy | undefined,
+): boolean {
+  if (a === undefined || b === undefined) {
+    return a === b;
+  }
+  return (
+    a.codeFirstMode === b.codeFirstMode &&
+    a.erc1271ExecutionBudget === b.erc1271ExecutionBudget &&
+    a.maxUserSignatureBytes === b.maxUserSignatureBytes &&
+    a.maxPublicKeyBytes === b.maxPublicKeyBytes &&
+    a.maxExtraDataBytes === b.maxExtraDataBytes &&
+    a.eip7702Fallback === b.eip7702Fallback
+  );

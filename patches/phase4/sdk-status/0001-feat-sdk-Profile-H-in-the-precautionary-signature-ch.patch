+
+////////////////////////////////////////////////////////////////////////////////
+// [lifecycle Level 1] Profile H (rule H9: the verifiers' caps, budget and ordering)
+////////////////////////////////////////////////////////////////////////////////
+
+const DELEGATE = 'ab'.repeat(20);
+const CODE_7702 = `0xef0100${DELEGATE}` as BytesHex;
+const CODE_REGULAR = '0x6080604052' as BytesHex;
+const BLOCK = 16n;
+
+function policy(codeFirstMode: UserDecryptSignaturePolicy['codeFirstMode'], eip7702Fallback = true) {
+  return { ...PROFILE_H_DEFAULT_SIGNATURE_POLICY, codeFirstMode, eip7702Fallback };
+}
+
+/** The account has `code`; the block number is fixed. */
+function reads(code: BytesHex): Pick<MockOptions, 'getCode' | 'getBlockNumber'> {
+  return { getCode: vi.fn(async () => code), getBlockNumber: vi.fn(async () => BLOCK) };
+}
+
+type CallArgs = { data: string; gas: bigint; blockNumber?: bigint };
+
+function callArgs(call: EthereumModule['call']): CallArgs {
+  const mockCalls = (call as unknown as { mock: { calls: [unknown, CallArgs][] } }).mock.calls;
+  const args = mockCalls[0];
+  if (args === undefined) {
+    throw new Error('expected the mocked eth_call to have been invoked');
+  }
+  return args[1];
+}
+
+describe('verifyErc1271UserDecrypt with a Profile H policy', () => {
+  it('H1: refuses a signature above the cap before any RPC', async () => {
+    const { context, ethereum } = makeContext({ ...reads(CODE_REGULAR) });
+    const signature = ('0x' + '11'.repeat(65_537)) as BytesHex;
+
+    await expect(
+      verifyErc1271UserDecrypt(context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature,
+        policy: policy('enforce'),
+      }),
+    ).rejects.toBeInstanceOf(Erc1271RejectedError);
+    expect(ethereum.call).toHaveBeenCalledTimes(0);
+    expect(ethereum.getCode).toHaveBeenCalledTimes(0);
+  });
+
+  it('H1: refuses a transport public key above the cap', async () => {
+    const eip712 = makeEip712();
+    const big = { ...eip712, message: { ...eip712.message, publicKey: ('0x' + '00'.repeat(4_097)) as BytesHex } };
+
+    await expect(
+      verifyErc1271UserDecrypt(makeContext({}).context, {
+        userAddress: WALLET,
+        eip712: big,
+        signature: SIG_65,
+        policy: policy('off'),
+      }),
+    ).rejects.toBeInstanceOf(Erc1271RejectedError);
+  });
+
+  it('H3: gives isValidSignature B_exec + 21,000 + 64 per calldata byte, not 250,000', async () => {
+    // A 2,420-byte ML-DSA-44 signature, which the 250,000 cap cannot verify.
+    const signature = ('0x' + '33'.repeat(2_420)) as BytesHex;
+    const call = queuedCall({ success: true, data: RETURN_MAGIC });
+    const { context } = makeContext({ call });
+
+    await expect(
+      verifyErc1271UserDecrypt(context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature,
+        policy: policy('off'),
+      }),
+    ).resolves.toBeUndefined();
+
+    const { data, gas, blockNumber } = callArgs(call);
+    const calldataBytes = (data.length - 2) / 2;
+    expect(calldataBytes).toBe(4 + 32 + 2_420); // selector, digest and signature in the mock's encoding
+    expect(gas).toBe(2_000_000n + 21_000n + 64n * BigInt(calldataBytes));
+    expect(gas).toBe(erc1271GasLimit(2_000_000n, 2_456));
+    expect(blockNumber).toBeUndefined(); // `off` reads no code and pins no block
+  });
+
+  it('off: ecrecover first, with no RPC, as without a policy', async () => {
+    const { context, ethereum } = makeContext({ recover: vi.fn(async () => WALLET), ...reads(CODE_7702) });
+
+    await expect(
+      verifyErc1271UserDecrypt(context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_65,
+        policy: policy('off'),
+      }),
+    ).resolves.toBeUndefined();
+    expect(ethereum.call).toHaveBeenCalledTimes(0);
+    expect(ethereum.getCode).toHaveBeenCalledTimes(0);
+  });
+
+  it('enforce (H2): refuses a 7702 root key whose delegate answers wrong magic, at the code block', async () => {
+    const call = queuedCall({ success: true, data: RETURN_WRONG_MAGIC });
+    const { context, ethereum } = makeContext({ recover: vi.fn(async () => WALLET), call, ...reads(CODE_7702) });
+
+    await expect(
+      verifyErc1271UserDecrypt(context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_65,
+        policy: policy('enforce'),
+      }),
+    ).rejects.toBeInstanceOf(Erc1271WrongMagicError);
+    expect(ethereum.getCode).toHaveBeenCalledTimes(1);
+    expect(callArgs(call).blockNumber).toBe(BLOCK);
+  });
+
+  it('enforce (H2): the 7702 shim accepts only a successful empty return and the account key', async () => {
+    const accept = makeContext({
+      recover: vi.fn(async () => WALLET),
+      call: queuedCall({ success: true, data: RETURN_EMPTY }),
+      ...reads(CODE_7702),
+    });
+    await expect(
+      verifyErc1271UserDecrypt(accept.context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_65,
+        policy: policy('enforce'),
+      }),
+    ).resolves.toBeUndefined();
+
+    // Shim off (Profile Q): the same answer is a rejection.
+    const off = makeContext({
+      recover: vi.fn(async () => WALLET),
+      call: queuedCall({ success: true, data: RETURN_EMPTY }),
+      ...reads(CODE_7702),
+    });
+    await expect(
+      verifyErc1271UserDecrypt(off.context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_65,
+        policy: policy('enforce', false),
+      }),
+    ).rejects.toBeInstanceOf(Erc1271RejectedError);
+
+    // A revert never falls back, even with the account key.
+    const reverted = makeContext({
+      recover: vi.fn(async () => WALLET),
+      call: queuedCall({ success: false, reason: 'execution reverted' }),
+      ...reads(CODE_7702),
+    });
+    await expect(
+      verifyErc1271UserDecrypt(reverted.context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_65,
+        policy: policy('enforce'),
+      }),
+    ).rejects.toBeInstanceOf(Erc1271RejectedError);
+  });
+
+  it('enforce (H2): regular code is ERC-1271 only, even when the signature recovers the address', async () => {
+    const call = queuedCall({ success: true, data: RETURN_EMPTY });
+    const { context } = makeContext({ recover: vi.fn(async () => WALLET), call, ...reads(CODE_REGULAR) });
+
+    await expect(
+      verifyErc1271UserDecrypt(context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_65,
+        policy: policy('enforce'),
+      }),
+    ).rejects.toBeInstanceOf(Erc1271RejectedError);
+  });
+
+  it('enforce (H2): no code means a 65-byte ecrecover only, after one code read', async () => {
+    const eoa = makeContext({ recover: vi.fn(async () => WALLET), ...reads('0x' as BytesHex) });
+    await expect(
+      verifyErc1271UserDecrypt(eoa.context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_65,
+        policy: policy('enforce'),
+      }),
+    ).resolves.toBeUndefined();
+    expect(eoa.ethereum.getCode).toHaveBeenCalledTimes(1);
+    expect(eoa.ethereum.call).toHaveBeenCalledTimes(0);
+
+    const blob = makeContext({ ...reads('0x' as BytesHex) });
+    await expect(
+      verifyErc1271UserDecrypt(blob.context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_130,
+        policy: policy('enforce'),
+      }),
+    ).rejects.toBeInstanceOf(Erc1271EoaMismatchNoCodeError);
+    expect(blob.ethereum.call).toHaveBeenCalledTimes(0);
+  });
+
+  it('shadow (H8): serves the `off` verdict and logs a would-be rejection', async () => {
+    const warn = vi.fn();
+    const { context } = makeContext({
+      logger: { warn } as unknown as Logger,
+      recover: vi.fn(async () => WALLET),
+      call: queuedCall({ success: true, data: RETURN_WRONG_MAGIC }),
+      ...reads(CODE_7702),
+    });
+
+    await expect(
+      verifyErc1271UserDecrypt(context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_65,
+        policy: policy('shadow'),
+      }),
+    ).resolves.toBeUndefined();
+    expect(warn).toHaveBeenCalledTimes(1);
+    expect(String(warn.mock.calls[0]?.[0])).toContain('PROFILE-H-SHADOW');
+  });
+
+  it('a module that cannot read code forwards under enforce (inconclusive)', async () => {
+    const warn = vi.fn();
+    const { context, ethereum } = makeContext({ logger: { warn } as unknown as Logger });
+
+    await expect(
+      verifyErc1271UserDecrypt(context, {
+        userAddress: WALLET,
+        eip712: makeEip712(),
+        signature: SIG_130,
+        policy: policy('enforce'),
+      }),
+    ).resolves.toBeUndefined();
+    expect(warn).toHaveBeenCalledTimes(1);
+    expect(ethereum.call).toHaveBeenCalledTimes(0);
+  });
+});
+
+describe('signaturePoliciesAreEqual', () => {
+  it('compares field by field', () => {
+    expect(signaturePoliciesAreEqual(undefined, undefined)).toBe(true);
+    expect(signaturePoliciesAreEqual(PROFILE_H_DEFAULT_SIGNATURE_POLICY, undefined)).toBe(false);
+    expect(
+      signaturePoliciesAreEqual(PROFILE_H_DEFAULT_SIGNATURE_POLICY, { ...PROFILE_H_DEFAULT_SIGNATURE_POLICY }),
+    ).toBe(true);
+    expect(signaturePoliciesAreEqual(PROFILE_H_DEFAULT_SIGNATURE_POLICY, policy('enforce'))).toBe(false);
+  });
+});

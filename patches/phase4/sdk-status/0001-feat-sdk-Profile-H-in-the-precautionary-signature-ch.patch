--- /dev/null
+++ b/sdk/js-sdk/src/core/utils-p/decrypt/userDecryptSignaturePolicy.ts
@@ -0,0 +1,42 @@
+// [lifecycle Level 1] Profile H (Decryption Authority Lifecycle draft): the value set shared by
+// the precautionary user-decryption signature check and the runtime config. No imports, so the
+// `types` entry point can export it without pulling in runtime code.
+
+/**
+ * The Profile H value set. Rule H9: advisory prechecks SHOULD use the same caps,
+ * budget and ordering as the verifiers. Mirrors `SignaturePolicy` in the shared
+ * crate (`shared/user-decryption-signature/src/profile_h.rs`) and the
+ * `profile_h` settings of the KMS connector and the relayer: set it to the
+ * values the deployment's verifiers state.
+ */
+export type UserDecryptSignaturePolicy = {
+  /**
+   * H2/H8 ordering. `off`: ecrecover first, as without a policy. `shadow`: the
+   * `off` verdict decides, and a different code-first verdict is logged.
+   * `enforce`: code-first, reading the account's code at one block.
+   */
+  readonly codeFirstMode: 'off' | 'shadow' | 'enforce';
+  /** H3 `B_exec`: execution gas for `isValidSignature`, excluding the intrinsic and calldata gas. */
+  readonly erc1271ExecutionBudget: bigint;
+  /** H1 caps, in bytes, checked before any RPC. */
+  readonly maxUserSignatureBytes: number;
+  readonly maxPublicKeyBytes: number;
+  readonly maxExtraDataBytes: number;
+  /** H2's narrow EIP-7702 fallback (Profile Q switches it off). */
+  readonly eip7702Fallback: boolean;
+};
+
+/** The draft's recommended values, with the `off` ordering. */
+export const PROFILE_H_DEFAULT_SIGNATURE_POLICY: UserDecryptSignaturePolicy = Object.freeze({
+  codeFirstMode: 'off',
+  erc1271ExecutionBudget: 2_000_000n,
+  maxUserSignatureBytes: 65_536,
+  maxPublicKeyBytes: 4_096,
+  maxExtraDataBytes: 1_024,
+  eip7702Fallback: true,
+});
+
+/** H3: `B_exec + 21,000 + 64 × len(calldata)`, the calldata length in bytes. */
+export function erc1271GasLimit(executionBudget: bigint, calldataByteLength: number): bigint {
+  return executionBudget + 21_000n + 64n * BigInt(calldataByteLength);
+}

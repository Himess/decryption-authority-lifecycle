@@ -0,0 +1,31 @@
+import type { Fhevm } from '../../types/coreFhevmClient.js';
+import type { FhevmChain } from '../../types/fhevmChain.js';
+import type { TransportKeyRing } from '../../kms/TransportKeyRing.js';
+import type { AuthorityStatus } from '../host/getAuthorityStatus.js';
+import { getAuthorityStatus } from '../host/getAuthorityStatus.js';
+
+////////////////////////////////////////////////////////////////////////////////
+
+export type PurgeIfRetiredParameters = {
+  readonly ring: TransportKeyRing;
+  readonly address: string;
+};
+
+export type PurgeIfRetiredReturnType = {
+  readonly status: AuthorityStatus;
+  readonly purged: { readonly keys: number; readonly permits: number } | undefined;
+};
+
+////////////////////////////////////////////////////////////////////////////////
+
+/**
+ * Reads the authority status of `address` and, if it is retired, zero-fills and forgets every transport key pair the
+ * ring tracks for it and drops its permits (Decryption Authority Lifecycle, Level 2).
+ */
+export async function purgeIfRetired(
+  fhevm: Fhevm<FhevmChain>,
+  parameters: PurgeIfRetiredParameters,
+): Promise<PurgeIfRetiredReturnType> {
+  const status = await getAuthorityStatus(fhevm, { address: parameters.address });
+  return { status, purged: status.retired ? parameters.ring.purge(parameters.address) : undefined };
+}
diff --git a/sdk/js-sdk/src/core/actions/host/getAuthorityStatus.test.ts b/sdk/js-sdk/src/core/actions/host/getAuthorityStatus.test.ts
new file mode 100644
index 0000000..33b3d2a
--- /dev/null
+++ b/sdk/js-sdk/src/core/actions/host/getAuthorityStatus.test.ts
@@ -0,0 +1,121 @@
+import type { EthereumModule } from '../../modules/ethereum/types.js';
+import type { RelayerModule } from '../../modules/relayer/types.js';
+import type { FhevmRuntime } from '../../types/coreFhevmRuntime.js';
+import type { FhevmClientFrozenContext } from '../../types/fhevmClientFrozenContext-p.js';
+import { describe, expect, it, vi } from 'vitest';
+import { PRIVATE_ETHERS_TOKEN } from '../../../ethers/internal/ethers-p.js';
+import { sepolia } from '../../chains/definitions/sepolia.js';
+import { createCoreFhevm, setFrozenContext } from '../../runtime/CoreFhevm-p.js';
+import { createFhevmRuntime } from '../../runtime/CoreFhevmRuntime-p.js';
+import { createFhevmClientFrozenContext } from '../../frozenContext/fhevmClientFrozenContext-p.js';
+import { isTransportKeyPairDisposed, toTransportKeyPair } from '../../kms/TransportKeyPair-p.js';
+import { createTransportKeyRing } from '../../kms/TransportKeyRing.js';
+import { purgeIfRetired } from '../decrypt/purgeIfRetired.js';
+import { getAuthorityStatus, getAuthorityStatusOnChains } from './getAuthorityStatus.js';
+
+////////////////////////////////////////////////////////////////////////////////
+// npx vitest run --config src/vitest.config.ts src/core/actions/host/getAuthorityStatus.test.ts
+//
+// Decryption Authority Lifecycle, Level 2: one status call per chain (Core, retired, E1 successor), and the purge of
+// a ring once the account is retired.
+////////////////////////////////////////////////////////////////////////////////
+
+const ACCOUNT = '0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266';
+const SUCCESSOR = '0x70997970C51812dc3A010C7d01b50e0d17dc79C8';
+const ZERO = '0x0000000000000000000000000000000000000000';
+const CORE = '0x556d2088';
+const E1 = '0x7dc5e209';
+
+type Handlers = Record<string, (args: readonly unknown[]) => unknown>;
+
+function makeClient(handlers: Handlers) {
+  const readContract = vi.fn(
+    async (
+      _trustedClient: unknown,
+      parameters: { readonly functionName: string; readonly args: readonly unknown[] },
+    ) => {
+      const handler = handlers[parameters.functionName];
+      if (handler === undefined) {
+        throw new Error(`No mocked handler for ${parameters.functionName}`);
+      }
+      return handler(parameters.args);
+    },
+  );
+  const runtime = createFhevmRuntime(PRIVATE_ETHERS_TOKEN, {
+    ethereum: { readContract } as unknown as EthereumModule,
+    relayer: {} as RelayerModule,
+    config: {},
+  });
+  const client = createCoreFhevm(PRIVATE_ETHERS_TOKEN, { chain: sepolia, client: {}, runtime });
+  setFrozenContext(client, createFhevmClientFrozenContext({ hostContractVersions: {} }));
+  return client;
+}
+
+const registry = (o: { core: boolean; e1: boolean; retired: boolean; successor?: string; pending?: string }) =>
+  makeClient({
+    supportsInterface: ([id]) => (id === CORE ? o.core : id === E1 ? o.e1 : false),
+    isAccountRetired: () => o.retired,
+    successorOf: () => o.successor ?? ZERO,
+    pendingSuccessorOf: () => [o.pending ?? ZERO, 1_800_000_000n, false],
+  });
+
+describe('getAuthorityStatus', () => {
+  it('reports a registry without the lifecycle Core', async () => {
+    const s = await getAuthorityStatus(registry({ core: false, e1: false, retired: false }), { address: ACCOUNT });
+    expect(s).toMatchObject({ chainId: sepolia.id, lifecycle: false, retired: false });
+    expect(s.successor).toBeUndefined();
+  });
+
+  it('reports a retired account and its confirmed successor', async () => {
+    const s = await getAuthorityStatus(registry({ core: true, e1: true, retired: true, successor: SUCCESSOR }), {
+      address: ACCOUNT.toLowerCase(),
+    });
+    expect(s).toMatchObject({ lifecycle: true, retired: true, successor: SUCCESSOR, pendingSuccessor: null });
+    expect(s.account).toBe(ACCOUNT);
+  });
+
+  it('reports a pending designation, and no E1 fields on a Core-only registry', async () => {
+    const pending = await getAuthorityStatus(registry({ core: true, e1: true, retired: false, pending: SUCCESSOR }), {
+      address: ACCOUNT,
+    });
+    expect(pending.successor).toBeNull();
+    expect(pending.pendingSuccessor).toEqual({ address: SUCCESSOR, confirmableAt: 1_800_000_000n, accepted: false });
+    const coreOnly = await getAuthorityStatus(registry({ core: true, e1: false, retired: false }), {
+      address: ACCOUNT,
+    });
+    expect(coreOnly).toMatchObject({ lifecycle: true, retired: false });
+    expect(coreOnly.pendingSuccessor).toBeUndefined();
+  });
+
+  it('answers per chain', async () => {
+    const all = await getAuthorityStatusOnChains(
+      [registry({ core: true, e1: true, retired: true }), registry({ core: true, e1: true, retired: false })],
+      { address: ACCOUNT },
+    );
+    expect(all.map((s) => s.retired)).toEqual([true, false]);
+  });
+});
+
+describe('purgeIfRetired', () => {
+  const keyPair = () =>
+    toTransportKeyPair(
+      { runtime: {} as unknown as FhevmRuntime, chain: sepolia },
+      {
+        value: { publicKey: `0x${'11'.repeat(32)}`, privateKey: new Uint8Array(32).fill(9) },
+        fhevmContext: {} as unknown as FhevmClientFrozenContext,
+      },
+    );
+
+  it('purges the ring only once the account is retired', async () => {
+    const ring = createTransportKeyRing(async () => keyPair());
+    const k = await ring.issue(ACCOUNT);
+
+    const active = await purgeIfRetired(registry({ core: true, e1: true, retired: false }), { ring, address: ACCOUNT });
+    expect(active.purged).toBeUndefined();
+    expect(isTransportKeyPairDisposed(k)).toBe(false);
+
+    const retired = await purgeIfRetired(registry({ core: true, e1: true, retired: true }), { ring, address: ACCOUNT });
+    expect(retired.purged).toEqual({ keys: 1, permits: 0 });
+    expect(isTransportKeyPairDisposed(k)).toBe(true);
+  });
+});
diff --git a/sdk/js-sdk/src/core/actions/host/getAuthorityStatus.ts b/sdk/js-sdk/src/core/actions/host/getAuthorityStatus.ts
new file mode 100644
index 0000000..ecc17d4
--- /dev/null
+++ b/sdk/js-sdk/src/core/actions/host/getAuthorityStatus.ts
@@ -0,0 +1,147 @@
+import type { Fhevm } from '../../types/coreFhevmClient.js';
+import type { FhevmChain } from '../../types/fhevmChain.js';
+import type { ChecksummedAddress } from '../../types/primitives.js';
+import {
+  isAccountRetiredAbi,
+  pendingSuccessorOfAbi,
+  successorOfAbi,
+  supportsInterfaceAbi,
+} from '../../host-contracts/abi-fragments/fragments.js';
+import { getTrustedClient, initPublicAction } from '../../runtime/CoreFhevm-p.js';
+import { addressToChecksummedAddress, assertIsAddress } from '../../base/address.js';
+
+////////////////////////////////////////////////////////////////////////////////
+
+// ERC-165 interface ids of the Decryption Authority Lifecycle.
+const LIFECYCLE_CORE_INTERFACE_ID = '0x556d2088';
+const LIFECYCLE_SUCCESSION_INTERFACE_ID = '0x7dc5e209';
+const ZERO_ADDRESS = '0x0000000000000000000000000000000000000000';
+
+export type GetAuthorityStatusParameters = {
+  readonly address: string;
+};
+
+export type AuthorityStatus = {
+  readonly chainId: number;
+  readonly aclAddress: ChecksummedAddress;
+  readonly account: ChecksummedAddress;
+  /** Whether the ACL declares the lifecycle Core (ERC-165 `0x556d2088`). Without it, no account can retire there. */
+  readonly lifecycle: boolean;
+  /** Whether the account has retired its decryption authority on this chain. Retirement is one-way. */
+  readonly retired: boolean;
+  /** E1: the confirmed successor, or `null`. `undefined` when the ACL does not declare E1 (`0x7dc5e209`). */
+  readonly successor: ChecksummedAddress | null | undefined;
+  /** E1: the pending designation, or `null`. `undefined` when the ACL does not declare E1. */
+  readonly pendingSuccessor:
+    | {
+        readonly address: ChecksummedAddress;
+        readonly confirmableAt: bigint;
+        readonly accepted: boolean;
+      }
+    | null
+    | undefined;
+};
+
+export type GetAuthorityStatusReturnType = AuthorityStatus;
+
+////////////////////////////////////////////////////////////////////////////////
+
+/**
+ * The decryption authority status of `address` on the client's chain: whether the ACL supports the Decryption
+ * Authority Lifecycle, whether the account is retired, and its successor (E1). Wallets use it to show one status and
+ * to purge transport keys and permits once the account is retired.
+ */
+export async function getAuthorityStatus(
+  fhevm: Fhevm<FhevmChain>,
+  parameters: GetAuthorityStatusParameters,
+): Promise<GetAuthorityStatusReturnType> {
+  assertIsAddress(parameters.address, {});
+  const account = addressToChecksummedAddress(parameters.address);
+  const aclAddress = fhevm.chain.fhevm.contracts.acl.address as ChecksummedAddress;
+
+  // no context needed
+  await initPublicAction(fhevm);
+  const trustedClient = getTrustedClient(fhevm);
+
+  const supports = async (interfaceId: string): Promise<boolean> => {
+    try {
+      const res = await fhevm.runtime.ethereum.readContract(trustedClient, {
+        address: aclAddress,
+        abi: supportsInterfaceAbi,
+        args: [interfaceId],
+        functionName: supportsInterfaceAbi[0].name,
+      });
+      return res === true;
+    } catch {
+      return false;
+    }
+  };
+
+  const status = {
+    chainId: fhevm.chain.id,
+    aclAddress,
+    account,
+  };
+
+  if (!(await supports(LIFECYCLE_CORE_INTERFACE_ID))) {
+    return { ...status, lifecycle: false, retired: false, successor: undefined, pendingSuccessor: undefined };
+  }
+
+  const retired = await fhevm.runtime.ethereum.readContract(trustedClient, {
+    address: aclAddress,
+    abi: isAccountRetiredAbi,
+    args: [account],
+    functionName: isAccountRetiredAbi[0].name,
+  });
+  if (typeof retired !== 'boolean') {
+    throw new Error(`Invalid isAccountRetired result.`);
+  }
+
+  if (!(await supports(LIFECYCLE_SUCCESSION_INTERFACE_ID))) {
+    return { ...status, lifecycle: true, retired, successor: undefined, pendingSuccessor: undefined };
+  }
+
+  const successor = String(
+    await fhevm.runtime.ethereum.readContract(trustedClient, {
+      address: aclAddress,
+      abi: successorOfAbi,
+      args: [account],
+      functionName: successorOfAbi[0].name,
+    }),
+  );
+  assertIsAddress(successor, {});
+  const pending = (await fhevm.runtime.ethereum.readContract(trustedClient, {
+    address: aclAddress,
+    abi: pendingSuccessorOfAbi,
+    args: [account],
+    functionName: pendingSuccessorOfAbi[0].name,
+  })) as readonly [unknown, bigint | number, unknown];
+  const pendingAddress = pending[0];
+  assertIsAddress(pendingAddress, {});
+
+  return {
+    ...status,
+    lifecycle: true,
+    retired,
+    successor: successor.toLowerCase() === ZERO_ADDRESS ? null : addressToChecksummedAddress(successor),
+    pendingSuccessor:
+      pendingAddress.toLowerCase() === ZERO_ADDRESS
+        ? null
+        : {
+            address: addressToChecksummedAddress(pendingAddress),
+            confirmableAt: BigInt(pending[1]),
+            accepted: pending[2] === true,
+          },
+  };
+}
+
+/**
+ * The status of `address` on several chains, one client per chain. Retirement is per chain: an answer on one chain
+ * says nothing about another.
+ */
+export async function getAuthorityStatusOnChains(
+  fhevms: ReadonlyArray<Fhevm<FhevmChain>>,
+  parameters: GetAuthorityStatusParameters,
+): Promise<readonly GetAuthorityStatusReturnType[]> {
+  return await Promise.all(fhevms.map((fhevm) => getAuthorityStatus(fhevm, parameters)));
+}

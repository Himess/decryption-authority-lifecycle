index 0000000..4678c27
--- /dev/null
+++ b/sdk/js-sdk/src/core/kms/TransportKeyRing.ts
@@ -0,0 +1,86 @@
+import type { SignedDecryptionPermit } from '../types/signedDecryptionPermit.js';
+import type { TransportKeyPair } from './TransportKeyPair-p.js';
+import { assertIsAddress } from '../base/address.js';
+import { disposeTransportKeyPair, isTransportKeyPairDisposed } from './TransportKeyPair-p.js';
+
+////////////////////////////////////////////////////////////////////////////////
+
+/**
+ * Transport-key hygiene (Decryption Authority Lifecycle, Level 2).
+ *
+ * The shares a user decryption releases are encrypted to the request's transport key, so their secrecy lasts only as
+ * long as that key stays private. Today an app may keep one key pair, and the permit that authorizes it, for up to
+ * 365 days. A ring instead hands out a fresh key pair per request and zero-fills it once the request is done. When an
+ * account retires, {@link TransportKeyRing.purge} zero-fills every key pair still tracked for it and drops its
+ * permits.
+ */
+export type TransportKeyRing = {
+  /** Generates a fresh key pair for one request of `account`, and tracks it until it is released or purged. */
+  readonly issue: (account: string) => Promise<TransportKeyPair>;
+  /** Zero-fills and forgets a key pair whose request is done. */
+  readonly release: (transportKeyPair: TransportKeyPair) => void;
+  /** Keeps a signed permit of `account`, so that a purge drops it too. */
+  readonly keepPermit: (account: string, signedPermit: SignedDecryptionPermit) => void;
+  /** The permits kept for `account`. */
+  readonly permitsOf: (account: string) => readonly SignedDecryptionPermit[];
+  /** Zero-fills and forgets every key pair tracked for `account`, and drops its permits. */
+  readonly purge: (account: string) => { readonly keys: number; readonly permits: number };
+  /** The number of key pairs tracked for `account`. */
+  readonly keyCount: (account: string) => number;
+};
+
+/**
+ * Creates a {@link TransportKeyRing}. `generate` makes one key pair, for example
+ * `() => client.generateTransportKeyPair()`.
+ */
+export function createTransportKeyRing(generate: () => Promise<TransportKeyPair>): TransportKeyRing {
+  const keys = new Map<string, Set<TransportKeyPair>>();
+  const permits = new Map<string, SignedDecryptionPermit[]>();
+
+  // Addresses are compared lowercase, as the ACL prechecks do.
+  const key = (account: string): string => {
+    assertIsAddress(account, {});
+    return account.toLowerCase();
+  };
+
+  return Object.freeze({
+    issue: async (account: string): Promise<TransportKeyPair> => {
+      const k = key(account);
+      const transportKeyPair = await generate();
+      let set = keys.get(k);
+      if (set === undefined) {
+        set = new Set();
+        keys.set(k, set);
+      }
+      set.add(transportKeyPair);
+      return transportKeyPair;
+    },
+    release: (transportKeyPair: TransportKeyPair): void => {
+      for (const set of keys.values()) {
+        set.delete(transportKeyPair);
+      }
+      if (!isTransportKeyPairDisposed(transportKeyPair)) {
+        disposeTransportKeyPair(transportKeyPair);
+      }
+    },
+    keepPermit: (account: string, signedPermit: SignedDecryptionPermit): void => {
+      const k = key(account);
+      permits.set(k, [...(permits.get(k) ?? []), signedPermit]);
+    },
+    permitsOf: (account: string): readonly SignedDecryptionPermit[] => permits.get(key(account)) ?? [],
+    purge: (account: string): { readonly keys: number; readonly permits: number } => {
+      const k = key(account);
+      const set = keys.get(k) ?? new Set<TransportKeyPair>();
+      for (const transportKeyPair of set) {
+        if (!isTransportKeyPairDisposed(transportKeyPair)) {
+          disposeTransportKeyPair(transportKeyPair);
+        }
+      }
+      const dropped = { keys: set.size, permits: permits.get(k)?.length ?? 0 };
+      keys.delete(k);
+      permits.delete(k);
+      return dropped;
+    },
+    keyCount: (account: string): number => keys.get(key(account))?.size ?? 0,
+  });
+}

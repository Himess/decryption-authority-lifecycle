diff --git a/sdk/js-sdk/src/core/errors/AclError.ts b/sdk/js-sdk/src/core/errors/AclError.ts
index 4acc533..d6b4d3e 100644
--- a/sdk/js-sdk/src/core/errors/AclError.ts
+++ b/sdk/js-sdk/src/core/errors/AclError.ts
@@ -53,3 +53,42 @@ export class AclUserDecryptionError extends ContractErrorBase {
     });
   }
 }
+
+////////////////////////////////////////////////////////////////////////////////
+// AclAccountRetiredError
+////////////////////////////////////////////////////////////////////////////////
+
+export type AclAccountRetiredErrorType = AclAccountRetiredError & {
+  name: 'AclAccountRetiredError';
+};
+
+/**
+ * A user decryption refused because an account it rests on has retired its decryption authority
+ * (Decryption Authority Lifecycle, `ACL.isAccountRetired`). Retirement is one-way, so unlike other ACL refusals
+ * this one never clears: retrying cannot succeed. It extends {@link AclUserDecryptionError}, so existing handlers
+ * still catch it.
+ */
+export class AclAccountRetiredError extends AclUserDecryptionError {
+  readonly #accounts: ChecksummedAddress[];
+
+  constructor({
+    contractAddress,
+    accounts,
+    message,
+  }: {
+    contractAddress: Address;
+    accounts: ChecksummedAddress[];
+    message: string;
+  }) {
+    super({ contractAddress, message });
+    this.#accounts = accounts;
+  }
+
+  /** The machine-readable reason, the same code the verifier returns over HTTP (`account_retired`). */
+  public readonly code = 'ACCOUNT_RETIRED' as const;
+
+  /** The retired accounts among the request's subjects. */
+  public get accounts(): ChecksummedAddress[] {
+    return this.#accounts;
+  }
+}

--- /dev/null
+++ b/sdk/js-sdk/src/core/host-contracts/isAccountRetired.test.ts
@@ -0,0 +1,168 @@
+import type { EthereumModule } from '../modules/ethereum/types.js';
+import type { RelayerModule } from '../modules/relayer/types.js';
+import type { ChecksummedAddress } from '../types/primitives.js';
+import { describe, expect, it, vi } from 'vitest';
+import { PRIVATE_ETHERS_TOKEN } from '../../ethers/internal/ethers-p.js';
+import { sepolia } from '../chains/definitions/sepolia.js';
+import { createCoreFhevm } from '../runtime/CoreFhevm-p.js';
+import { createFhevmRuntime } from '../runtime/CoreFhevmRuntime-p.js';
+import { buildHandle } from '../handle/FhevmHandle.js';
+import { AclAccountRetiredError, AclUserDecryptionError } from '../errors/AclError.js';
+import { checkPersistAllowed } from './checkPersistAllowed.js';
+import { checkDelegation } from './checkDelegation.js';
+import { findRetiredAccounts, isAccountRetired } from './isAccountRetired.js';
+
+////////////////////////////////////////////////////////////////////////////////
+// npx vitest run --config src/vitest.config.ts src/core/host-contracts/isAccountRetired.test.ts
+//
+// Decryption Authority Lifecycle, Level 2: a precheck refusal that rests on a retired account is typed
+// (AclAccountRetiredError, code ACCOUNT_RETIRED); every other refusal keeps its generic AclUserDecryptionError; an
+// allowed request makes no extra call; an ACL without the lifecycle Core leaves the generic error in place.
+////////////////////////////////////////////////////////////////////////////////
+
+const ACL = sepolia.fhevm.contracts.acl.address as ChecksummedAddress;
+const USER = '0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266' as ChecksummedAddress;
+const DELEGATE = '0x70997970C51812dc3A010C7d01b50e0d17dc79C8' as ChecksummedAddress;
+const APP = '0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC' as ChecksummedAddress;
+const HANDLE = buildHandle({ chainId: 11155111n, hash21: `0x${'ab'.repeat(21)}`, fheTypeId: 5 });
+
+type Handlers = Record<string, (args: readonly unknown[]) => unknown>;
+
+/** A real core client whose readContract dispatches on the function name; a missing handler throws. */
+function makeClient(handlers: Handlers) {
+  const readContract = vi.fn(
+    async (
+      _trustedClient: unknown,
+      parameters: { readonly functionName: string; readonly args: readonly unknown[] },
+    ) => {
+      const handler = handlers[parameters.functionName];
+      if (handler === undefined) {
+        throw new Error(`No mocked handler for ${parameters.functionName}`);
+      }
+      return handler(parameters.args);
+    },
+  );
+  const runtime = createFhevmRuntime(PRIVATE_ETHERS_TOKEN, {
+    ethereum: { readContract } as unknown as EthereumModule,
+    relayer: {} as RelayerModule,
+    config: {},
+  });
+  const client = createCoreFhevm(PRIVATE_ETHERS_TOKEN, { chain: sepolia, client: {}, runtime });
+  const called = (): string[] =>
+    readContract.mock.calls.map((call) => (call[1] as { readonly functionName: string }).functionName);
+  return { client, called };
+}
+
+const lower = (a: unknown): string => String(a).toLowerCase();
+const pairs = [{ handle: HANDLE, contractAddress: APP }];
+
+describe('checkPersistAllowed', () => {
+  it('types the refusal when the user is retired', async () => {
+    const { client, called } = makeClient({
+      persistAllowed: ([, account]) => lower(account) !== lower(USER),
+      isAccountRetired: ([account]) => lower(account) === lower(USER),
+    });
+    const err = await checkPersistAllowed(client, {
+      aclAddress: ACL,
+      userAddress: USER,
+      handleContractPairs: pairs,
+    }).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(AclAccountRetiredError);
+    expect(err).toBeInstanceOf(AclUserDecryptionError);
+    expect((err as AclAccountRetiredError).code).toBe('ACCOUNT_RETIRED');
+    expect((err as AclAccountRetiredError).accounts).toEqual([USER]);
+    expect(called().filter((f) => f === 'isAccountRetired')).toHaveLength(1);
+  });
+
+  it('types the refusal when the app contract is retired', async () => {
+    const { client } = makeClient({
+      persistAllowed: ([, account]) => lower(account) !== lower(APP),
+      isAccountRetired: ([account]) => lower(account) === lower(APP),
+    });
+    const err = await checkPersistAllowed(client, {
+      aclAddress: ACL,
+      userAddress: USER,
+      handleContractPairs: pairs,
+    }).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(AclAccountRetiredError);
+    expect((err as AclAccountRetiredError).accounts).toEqual([APP]);
+  });
+
+  it('keeps the generic error for an ordinary refusal', async () => {
+    const { client } = makeClient({ persistAllowed: () => false, isAccountRetired: () => false });
+    const err = await checkPersistAllowed(client, {
+      aclAddress: ACL,
+      userAddress: USER,
+      handleContractPairs: pairs,
+    }).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(AclUserDecryptionError);
+    expect(err).not.toBeInstanceOf(AclAccountRetiredError);
+  });
+
+  it('keeps the generic error when the ACL has no lifecycle Core', async () => {
+    const { client, called } = makeClient({ persistAllowed: () => false });
+    const err = await checkPersistAllowed(client, {
+      aclAddress: ACL,
+      userAddress: USER,
+      handleContractPairs: pairs,
+    }).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(AclUserDecryptionError);
+    expect(err).not.toBeInstanceOf(AclAccountRetiredError);
+    expect(called()).toContain('isAccountRetired');
+  });
+
+  it('makes no extra call when the request is allowed', async () => {
+    const { client, called } = makeClient({ persistAllowed: () => true });
+    await checkPersistAllowed(client, { aclAddress: ACL, userAddress: USER, handleContractPairs: pairs });
+    expect(called()).not.toContain('isAccountRetired');
+  });
+});
+
+describe('checkDelegation', () => {
+  it('types the refusal when the delegator is retired', async () => {
+    const { client } = makeClient({
+      isHandleDelegatedForUserDecryption: () => false,
+      isAccountRetired: ([account]) => lower(account) === lower(USER),
+    });
+    const err = await checkDelegation(client, {
+      aclAddress: ACL,
+      delegator: USER,
+      delegate: DELEGATE,
+      handleContractPairs: pairs,
+    }).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(AclAccountRetiredError);
+    expect((err as AclAccountRetiredError).accounts).toEqual([USER]);
+  });
+
+  it("passes a retired delegator's successor, which the delegated view allows, with no extra call", async () => {
+    const { client, called } = makeClient({ isHandleDelegatedForUserDecryption: () => true });
+    await checkDelegation(client, { aclAddress: ACL, delegator: USER, delegate: DELEGATE, handleContractPairs: pairs });
+    expect(called()).not.toContain('isAccountRetired');
+  });
+
+  it('keeps the generic error for an ordinary refusal', async () => {
+    const { client } = makeClient({ isHandleDelegatedForUserDecryption: () => false, isAccountRetired: () => false });
+    const err = await checkDelegation(client, {
+      aclAddress: ACL,
+      delegator: USER,
+      delegate: DELEGATE,
+      handleContractPairs: pairs,
+    }).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(AclUserDecryptionError);
+    expect(err).not.toBeInstanceOf(AclAccountRetiredError);
+  });
+});
+
+describe('isAccountRetired / findRetiredAccounts', () => {
+  it('reads each account and returns the retired ones without duplicates', async () => {
+    const { client } = makeClient({ isAccountRetired: ([account]) => lower(account) !== lower(APP) });
+    expect(await isAccountRetired(client, { aclAddress: ACL, accounts: [USER, APP] })).toEqual([true, false]);
+    expect(await findRetiredAccounts(client, { aclAddress: ACL, accounts: [USER, APP, USER] })).toEqual([USER]);
+  });
+
+  it('answers nothing when the ACL has no lifecycle Core', async () => {
+    const { client } = makeClient({});
+    await expect(isAccountRetired(client, { aclAddress: ACL, accounts: [USER] })).rejects.toThrow();
+    expect(await findRetiredAccounts(client, { aclAddress: ACL, accounts: [USER] })).toEqual([]);
+  });
+});
diff --git a/sdk/js-sdk/src/core/host-contracts/isAccountRetired.ts b/sdk/js-sdk/src/core/host-contracts/isAccountRetired.ts
new file mode 100644
index 0000000..e882c70
--- /dev/null
+++ b/sdk/js-sdk/src/core/host-contracts/isAccountRetired.ts
@@ -0,0 +1,84 @@
+import type { ChecksummedAddress } from '../types/primitives.js';
+import type { FhevmRuntime } from '../types/coreFhevmRuntime.js';
+import { isAccountRetiredAbi } from './abi-fragments/fragments.js';
+import { getTrustedClient } from '../runtime/CoreFhevm-p.js';
+import { executeWithBatching } from '../base/promise.js';
+
+////////////////////////////////////////////////////////////////////////////////
+
+type Context = {
+  readonly runtime: FhevmRuntime;
+  readonly client: NonNullable<object>;
+  readonly options: { readonly batchRpcCalls: boolean };
+};
+
+type Parameters = {
+  readonly aclAddress: ChecksummedAddress;
+  readonly accounts: readonly ChecksummedAddress[];
+};
+
+////////////////////////////////////////////////////////////////////////////////
+
+/**
+ * Reads `ACL.isAccountRetired(account)` (Decryption Authority Lifecycle, Core) for each account.
+ * Throws if the ACL has no lifecycle Core.
+ */
+export async function isAccountRetired(context: Context, parameters: Parameters): Promise<boolean[]> {
+  const { aclAddress, accounts } = parameters;
+
+  const rpcCalls = accounts.map((account) => () => _isAccountRetired(context, { aclAddress, account }));
+
+  return await executeWithBatching(rpcCalls, context.options.batchRpcCalls);
+}
+
+/**
+ * Returns the retired accounts among `accounts`, without duplicates. Used after a precheck has refused, to type the
+ * refusal: an ACL without the lifecycle Core answers nothing here (an empty list), so the precheck's generic error
+ * stands.
+ */
+export async function findRetiredAccounts(context: Context, parameters: Parameters): Promise<ChecksummedAddress[]> {
+  const unique: ChecksummedAddress[] = [];
+  const seen = new Set<string>();
+  for (const account of parameters.accounts) {
+    // runtime defensive check, use lowercase
+    if (!seen.has(account.toLowerCase())) {
+      seen.add(account.toLowerCase());
+      unique.push(account);
+    }
+  }
+
+  let retired: boolean[];
+  try {
+    retired = await isAccountRetired(context, { aclAddress: parameters.aclAddress, accounts: unique });
+  } catch {
+    return [];
+  }
+
+  return unique.filter((_, i) => retired[i] === true);
+}
+
+////////////////////////////////////////////////////////////////////////////////
+
+async function _isAccountRetired(
+  context: Context,
+  parameters: {
+    readonly aclAddress: ChecksummedAddress;
+    readonly account: ChecksummedAddress;
+  },
+): Promise<boolean> {
+  const { aclAddress, account } = parameters;
+  const trustedClient = getTrustedClient(context);
+
+  const res = await context.runtime.ethereum.readContract(trustedClient, {
+    address: aclAddress,
+    abi: isAccountRetiredAbi,
+    args: [account],
+    functionName: isAccountRetiredAbi[0].name,
+  });
+
+  if (typeof res !== 'boolean') {
+    throw new Error(`Invalid isAccountRetired result.`);
+  }
+
+  return res;
+}

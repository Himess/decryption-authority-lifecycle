diff --git a/sdk/js-sdk/src/core/kms/TransportKeyRing.test.ts b/sdk/js-sdk/src/core/kms/TransportKeyRing.test.ts
new file mode 100644
index 0000000..74da6b6
--- /dev/null
+++ b/sdk/js-sdk/src/core/kms/TransportKeyRing.test.ts
@@ -0,0 +1,100 @@
+import type { FhevmRuntime } from '../types/coreFhevmRuntime.js';
+import type { FhevmClientFrozenContext } from '../types/fhevmClientFrozenContext-p.js';
+import type { SignedDecryptionPermit } from '../types/signedDecryptionPermit.js';
+import type { TransportKeyPair } from './TransportKeyPair-p.js';
+import { describe, expect, it } from 'vitest';
+import { sepolia } from '../chains/definitions/sepolia.js';
+import {
+  disposeTransportKeyPair,
+  isTransportKeyPairDisposed,
+  serializeTransportKeyPair,
+  toTransportKeyPair,
+} from './TransportKeyPair-p.js';
+import { createTransportKeyRing } from './TransportKeyRing.js';
+
+////////////////////////////////////////////////////////////////////////////////
+// npx vitest run --config src/vitest.config.ts src/core/kms/TransportKeyRing.test.ts
+//
+// Decryption Authority Lifecycle, Level 2: transport-key hygiene. A disposed key pair is zero-filled and unusable;
+// a ring hands out one key pair per request and purges an account's key pairs and permits.
+////////////////////////////////////////////////////////////////////////////////
+
+const ALICE = '0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266';
+const BOB = '0x70997970C51812dc3A010C7d01b50e0d17dc79C8';
+const runtime = {} as unknown as FhevmRuntime;
+const fhevmContext = {} as unknown as FhevmClientFrozenContext;
+
+let seed = 0;
+/** A key pair over caller-supplied bytes (no WASM needed); also returns the private key buffer. */
+function makeKeyPair(): { readonly transportKeyPair: TransportKeyPair; readonly privateKey: Uint8Array } {
+  seed++;
+  const privateKey = new Uint8Array(32).fill(seed);
+  const transportKeyPair = toTransportKeyPair(
+    { runtime, chain: sepolia },
+    { value: { publicKey: `0x${seed.toString(16).padStart(2, '0').repeat(32)}`, privateKey }, fhevmContext },
+  );
+  return { transportKeyPair, privateKey };
+}
+
+describe('disposeTransportKeyPair', () => {
+  it('zero-fills the private key and makes the key pair unusable', () => {
+    const { transportKeyPair, privateKey } = makeKeyPair();
+    expect(serializeTransportKeyPair({ transportKeyPair, fhevmContext }).privateKey).not.toMatch(/^0+$/);
+    expect(isTransportKeyPairDisposed(transportKeyPair)).toBe(false);
+
+    disposeTransportKeyPair(transportKeyPair);
+
+    expect(isTransportKeyPairDisposed(transportKeyPair)).toBe(true);
+    expect(privateKey.every((b) => b === 0)).toBe(true);
+    expect(() => serializeTransportKeyPair({ transportKeyPair, fhevmContext })).toThrow('TransportKeyPair is disposed');
+    expect(JSON.stringify(transportKeyPair)).toContain('publicKey');
+  });
+});
+
+describe('createTransportKeyRing', () => {
+  it('issues a fresh key pair per request and zero-fills it on release', async () => {
+    const issued: Uint8Array[] = [];
+    const ring = createTransportKeyRing(async () => {
+      const { transportKeyPair, privateKey } = makeKeyPair();
+      issued.push(privateKey);
+      return transportKeyPair;
+    });
+
+    const k1 = await ring.issue(ALICE);
+    const k2 = await ring.issue(ALICE);
+    expect(k1).not.toBe(k2);
+    expect(k1.publicKey).not.toBe(k2.publicKey);
+    expect(ring.keyCount(ALICE)).toBe(2);
+
+    ring.release(k1);
+    expect(ring.keyCount(ALICE)).toBe(1);
+    expect(isTransportKeyPairDisposed(k1)).toBe(true);
+    expect(issued[0]!.every((b) => b === 0)).toBe(true);
+    expect(isTransportKeyPairDisposed(k2)).toBe(false);
+  });
+
+  it("purges every key pair and permit of a retired account, and only that account's", async () => {
+    const ring = createTransportKeyRing(async () => makeKeyPair().transportKeyPair);
+    const a1 = await ring.issue(ALICE);
+    const a2 = await ring.issue(ALICE.toLowerCase());
+    const b1 = await ring.issue(BOB);
+    ring.keepPermit(ALICE, { signerAddress: ALICE } as unknown as SignedDecryptionPermit);
+    ring.keepPermit(BOB, { signerAddress: BOB } as unknown as SignedDecryptionPermit);
+
+    expect(ring.purge(ALICE)).toEqual({ keys: 2, permits: 1 });
+
+    expect(isTransportKeyPairDisposed(a1)).toBe(true);
+    expect(isTransportKeyPairDisposed(a2)).toBe(true);
+    expect(ring.keyCount(ALICE)).toBe(0);
+    expect(ring.permitsOf(ALICE)).toEqual([]);
+    expect(isTransportKeyPairDisposed(b1)).toBe(false);
+    expect(ring.keyCount(BOB)).toBe(1);
+    expect(ring.permitsOf(BOB)).toHaveLength(1);
+    expect(ring.purge(ALICE)).toEqual({ keys: 0, permits: 0 });
+  });
+
+  it('rejects an invalid account address', async () => {
+    const ring = createTransportKeyRing(async () => makeKeyPair().transportKeyPair);
+    await expect(ring.issue('not-an-address')).rejects.toThrow();
+  });
+});

     stateMutability: 'view',
   },
 ] as const;
+
+////////////////////////////////////////////////////////////////////////////////
+// ACL.isAccountRetired(account) (Decryption Authority Lifecycle, Core)
+////////////////////////////////////////////////////////////////////////////////
+
+export const isAccountRetiredAbi: readonly [Record<string, unknown> & { readonly name: 'isAccountRetired' }] = [
+  {
+    inputs: [{ internalType: 'address', name: 'account', type: 'address' }],
+    name: 'isAccountRetired',
+    outputs: [{ internalType: 'bool', name: '', type: 'bool' }],
+    stateMutability: 'view',
+    type: 'function',
+  },
+] as const;
+
+////////////////////////////////////////////////////////////////////////////////
+// ACL.supportsInterface(interfaceId) (ERC-165)
+////////////////////////////////////////////////////////////////////////////////
+
+export const supportsInterfaceAbi: readonly [Record<string, unknown> & { readonly name: 'supportsInterface' }] = [
+  {
+    inputs: [{ internalType: 'bytes4', name: 'interfaceId', type: 'bytes4' }],
+    name: 'supportsInterface',
+    outputs: [{ internalType: 'bool', name: '', type: 'bool' }],
+    stateMutability: 'view',
+    type: 'function',
+  },
+] as const;
+
+////////////////////////////////////////////////////////////////////////////////
+// ACL.successorOf(account) (Decryption Authority Lifecycle, E1)
+////////////////////////////////////////////////////////////////////////////////
+
+export const successorOfAbi: readonly [Record<string, unknown> & { readonly name: 'successorOf' }] = [
+  {
+    inputs: [{ internalType: 'address', name: 'account', type: 'address' }],
+    name: 'successorOf',
+    outputs: [{ internalType: 'address', name: '', type: 'address' }],
+    stateMutability: 'view',
+    type: 'function',
+  },
+] as const;
+
+////////////////////////////////////////////////////////////////////////////////
+// ACL.pendingSuccessorOf(account) (Decryption Authority Lifecycle, E1)
+////////////////////////////////////////////////////////////////////////////////
+
+export const pendingSuccessorOfAbi: readonly [Record<string, unknown> & { readonly name: 'pendingSuccessorOf' }] = [
+  {
+    inputs: [{ internalType: 'address', name: 'account', type: 'address' }],
+    name: 'pendingSuccessorOf',
+    outputs: [
+      { internalType: 'address', name: 'successor', type: 'address' },
+      { internalType: 'uint64', name: 'confirmableAt', type: 'uint64' },
+      { internalType: 'bool', name: 'accepted', type: 'bool' },
+    ],
+    stateMutability: 'view',
+    type: 'function',
+  },
+] as const;

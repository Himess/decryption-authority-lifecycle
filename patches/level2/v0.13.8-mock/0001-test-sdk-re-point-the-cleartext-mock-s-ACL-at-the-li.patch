+        if (!succession.accepted) {
+            revert SuccessionNotAccepted(pending);
+        }
+        uint64 confirmableAt = succession.confirmableAt;
+        if (block.timestamp < confirmableAt) {
+            revert SuccessorNotYetConfirmable(pending, confirmableAt);

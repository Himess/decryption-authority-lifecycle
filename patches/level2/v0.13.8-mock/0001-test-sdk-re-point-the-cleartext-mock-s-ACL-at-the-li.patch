+        }
+        if (delay <= _effectiveSuccessorDelay($, msg.sender) || delay > MAX_SUCCESSOR_DELAY) {
+            revert SuccessorDelayInvalid(delay);
+        }
+        $.successorDelayOf[msg.sender] = delay;
+        emit SuccessorDelayRaised(msg.sender, delay);
     }
 

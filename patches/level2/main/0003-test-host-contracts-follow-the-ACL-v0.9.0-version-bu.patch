From 92a1806f37c4157e328109ebd74f23ad657bb87c Mon Sep 17 00:00:00 2001
From: Himess <semihcvlk53@gmail.com>
Date: Wed, 21 Oct 2026 14:57:08 +0300
Subject: [PATCH 3/8] test(host-contracts): follow the ACL v0.9.0 version bump
 in the Hardhat upgrade test

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 host-contracts/test/upgrades/upgrades.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/host-contracts/test/upgrades/upgrades.ts b/host-contracts/test/upgrades/upgrades.ts
index d3cc919e..0a3f5ee9 100644
--- a/host-contracts/test/upgrades/upgrades.ts
+++ b/host-contracts/test/upgrades/upgrades.ts
@@ -28,7 +28,7 @@ describe('Upgrades', function () {
     });
     await acl.waitForDeployment();
     const ownerBef = await acl.owner();
-    expect(await acl.getVersion()).to.equal('ACL v0.8.0');
+    expect(await acl.getVersion()).to.equal('ACL v0.9.0');
     const acl2 = await upgrades.upgradeProxy(acl, this.aclFactoryUpgraded);
     await acl2.waitForDeployment();
     const ownerAft = await acl2.owner();
@@ -181,7 +181,7 @@ describe('Upgrades', function () {
     const origACLAdd = readHostAddress('ACL_CONTRACT_ADDRESS');
     const deployer = new ethers.Wallet(process.env.DEPLOYER_PRIVATE_KEY!).connect(ethers.provider);
     const acl = (await this.aclFactory.attach(origACLAdd, deployer)) as ACL;
-    expect(await acl.getVersion()).to.equal('ACL v0.8.0');
+    expect(await acl.getVersion()).to.equal('ACL v0.9.0');
     const newaclFactoryUpgraded = await ethers.getContractFactory('ACLUpgradedExample', deployer);
     const acl2 = (await upgrades.upgradeProxy(acl, newaclFactoryUpgraded)) as unknown as ACLUpgradedExample;
     await acl2.waitForDeployment();

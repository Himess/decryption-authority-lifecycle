@@ -0,0 +1,442 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+pragma solidity ^0.8.24;
+
+import {MulticallUpgradeable} from "@openzeppelin/contracts-upgradeable/utils/MulticallUpgradeable.sol";
+import {ACL} from "../../contracts/ACL.sol";
+import {FheType} from "../../contracts/shared/FheType.sol";
+import {HostContractsDeployerTestUtils} from "../../fhevm-foundry/HostContractsDeployerTestUtils.sol";
+import {aclAdd, inputVerifierAdd} from "../../addresses/FHEVMHostAddresses.sol";
+import {euint64, externalEuint64} from "../../lib/FHE.sol";
+import {ERC7984} from "./retirement/oz-confidential-contracts-0.5.3/token/ERC7984/ERC7984.sol";
+import {ERC7984ObserverAccess} from "./retirement/oz-confidential-contracts-0.5.3/token/ERC7984/extensions/ERC7984ObserverAccess.sol";
+import {ERC7984ObserverToken, ERC7984ProfileAToken, ERC7984NaiveGateToken, ERC7984PostGrantAssertToken, ProfileAMockInputVerifier, GenericCallVault, GenericCallVaultProfileA, RetirementHelperReader} from "./retirement/ProfileAMocks.sol";
+
+/**
+ * @title ACLRetirementProfileATest
+ * @notice Level 2, Profile A (applications) of the Decryption Authority Lifecycle draft: TC23 (rules A1-A4) on
+ *         ACL v0.9.0, with OpenZeppelin ERC-7984 0.5.3 and its observer extension (vendored test-only copies), and
+ *         the library helper `FHE.isAccountRetired`. Each Profile A rule is shown next to the variant without it.
+ *         The key of `holder` is compromised in the observer and operator tests: the owner and the thief both sign
+ *         as `holder`, so `vm.prank(holder)` stands for either of them.
+ */
+contract ACLRetirementProfileATest is HostContractsDeployerTestUtils {
+    ACL internal acl;
+    address internal aclImplementation;
+
+    address internal constant owner = address(456);
+
+    address internal holder = makeAddr("holder");
+    address internal sender = makeAddr("sender");
+    address internal thiefObserver = makeAddr("thiefObserver");
+    address internal thiefObserver2 = makeAddr("thiefObserver2");
+    address internal friendObserver = makeAddr("friendObserver");
+    address internal operator = makeAddr("operator");
+    address internal recipient = makeAddr("recipient");
+    address internal admin = makeAddr("admin");
+    address internal attacker = makeAddr("attacker");
+
+    ERC7984ObserverToken internal vanilla;
+    ERC7984ProfileAToken internal profileA;
+
+    function setUp() public {
+        (, aclImplementation) = _deployACL(owner);
+        _deployPauserSet();
+        _deployFHEVMExecutor(owner);
+        _deployHCULimit(owner);
+        acl = ACL(aclAdd);
+        vanilla = new ERC7984ObserverToken();
+        profileA = new ERC7984ProfileAToken();
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // helpers
+    ////////////////////////////////////////////////////////////////////////////
+
+    function _retire(address who) internal {
+        vm.prank(who);
+        acl.retireAccount();
+        assertTrue(acl.isAccountRetired(who));
+    }
+
+    function _balance(ERC7984ObserverToken token, address account) internal view returns (bytes32) {
+        return euint64.unwrap(token.confidentialBalanceOf(account));
+    }
+
+    /// @dev `sender` (never retired) is funded and sends its whole balance handle to `to`. Returns the transferred
+    ///      amount handle. The token's grants are persistent, so transient storage is cleaned around the call.
+    function _transferTo(ERC7984ObserverToken token, address to) internal returns (bytes32 transferred) {
+        token.mint(sender, 100);
+        acl.cleanTransientStorage();
+        bytes32 amount = _balance(token, sender);
+        vm.prank(sender);
+        transferred = euint64.unwrap(token.confidentialTransfer(to, euint64.wrap(amount)));
+        acl.cleanTransientStorage();
+    }
+
+    /// @dev A fresh input handle of type Uint64 (the mock input verifier accepts any proof).
+    function _freshInput(string memory seed) internal pure returns (bytes32) {
+        return
+            (keccak256(bytes(seed)) & 0xffffffffffffffffffffffffffffffffffffffffff0000000000000000000000) |
+            bytes32(uint256(uint8(FheType.Uint64)) << 8);
+    }
+
+    /// @dev The thief adds an observer while `holder` is still active, then the owner retires `holder`.
+    function _thiefObserverThenRetire(ERC7984ObserverToken token) internal returns (bytes32 balanceAtAdd) {
+        token.mint(holder, 1_000);
+        acl.cleanTransientStorage();
+        vm.prank(holder);
+        token.setObserver(holder, thiefObserver);
+        balanceAtAdd = _balance(token, holder);
+        assertTrue(acl.persistAllowed(balanceAtAdd, thiefObserver), "the observer reads the balance from the start");
+        _retire(holder);
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // the library helper
+    ////////////////////////////////////////////////////////////////////////////
+
+    function test_Helper_FHEIsAccountRetiredFollowsTheRegistry() public {
+        RetirementHelperReader reader = new RetirementHelperReader();
+        assertFalse(reader.read(holder));
+        _retire(holder);
+        assertTrue(reader.read(holder));
+        assertFalse(reader.read(sender));
+    }
+
+    /// @dev Fails closed: against a registry without the lifecycle Core the helper reverts instead of answering false.
+    function test_Helper_RevertsAgainstARegistryWithoutCore() public {
+        RetirementHelperReader reader = new RetirementHelperReader();
+        vm.etch(aclAdd, address(new ProfileAMockInputVerifier()).code);
+        vm.expectRevert();
+        reader.read(holder);
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // A1: observers (TC23 case 1, D22)
+    ////////////////////////////////////////////////////////////////////////////
+
+    /// @dev Profile A: the retired owner clears the thief's observer, and nobody can add one again. Inbound transfers
+    ///      afterwards reach no observer. What the observer read before the clear stays readable (not a clawback).
+    function test_A1_ThiefObserverClearedAndCannotBeReAdded() public {
+        bytes32 balanceAtAdd = _thiefObserverThenRetire(profileA);
+
+        vm.prank(holder);
+        profileA.setObserver(holder, address(0));
+        assertEq(profileA.observer(holder), address(0));
+
+        vm.prank(holder);
+        vm.expectRevert(abi.encodeWithSelector(ERC7984ProfileAToken.ERC7984GrantByRetiredAccount.selector, holder));
+        profileA.setObserver(holder, thiefObserver);
+        vm.prank(holder);
+        vm.expectRevert(abi.encodeWithSelector(ERC7984ProfileAToken.ERC7984GrantByRetiredAccount.selector, holder));
+        profileA.setObserver(holder, thiefObserver2);
+
+        bytes32 transferred = _transferTo(profileA, holder);
+        bytes32 balanceAfter = _balance(profileA, holder);
+        assertTrue(balanceAfter != balanceAtAdd, "the inbound transfer succeeded and changed the balance handle");
+        assertFalse(acl.persistAllowed(balanceAfter, thiefObserver), "no observer on the new balance");
+        assertFalse(acl.persistAllowed(transferred, thiefObserver), "no observer on the new amount");
+        assertTrue(acl.persistAllowed(balanceAtAdd, thiefObserver), "residual: the earlier grant stays");
+    }
+
+    /// @dev Clearing stays allowed for the observer itself, and an active account is not affected by the gate.
+    function test_A1_ObserverMayAbdicate_ActiveAccountUnaffected() public {
+        _thiefObserverThenRetire(profileA);
+        vm.prank(thiefObserver);
+        profileA.setObserver(holder, address(0));
+        assertEq(profileA.observer(holder), address(0));
+
+        profileA.mint(sender, 10);
+        vm.prank(sender);
+        profileA.setObserver(sender, friendObserver);
+        assertEq(profileA.observer(sender), friendObserver);
+        vm.prank(sender);
+        profileA.setObserver(sender, thiefObserver2);
+        assertEq(profileA.observer(sender), thiefObserver2);
+    }
+
+    /// @dev Asserted residual (the variant without Profile A): after retirement the thief adds an observer, which
+    ///      reads the current balance and every later amount. Clearing does not help: the thief adds it again.
+    function test_A1_Residual_VanillaObserverLeaksAfterRetirement() public {
+        vanilla.mint(holder, 1_000);
+        acl.cleanTransientStorage();
+        _retire(holder);
+
+        vm.prank(holder);
+        vanilla.setObserver(holder, thiefObserver);
+        assertTrue(acl.persistAllowed(_balance(vanilla, holder), thiefObserver), "leak: the current balance");
+
+        bytes32 transferred = _transferTo(vanilla, holder);
+        assertTrue(acl.persistAllowed(_balance(vanilla, holder), thiefObserver), "leak: the next balance");
+        assertTrue(acl.persistAllowed(transferred, thiefObserver), "leak: the next amount");
+
+        vm.prank(holder);
+        vanilla.setObserver(holder, address(0));
+        vm.prank(holder);
+        vanilla.setObserver(holder, thiefObserver);
+        assertEq(vanilla.observer(holder), thiefObserver, "the thief wins the clear-and-re-add race");
+    }
+
+    /// @dev D22: a naive gate that refuses every call for a retired account locks the thief's observer in. The retired
+    ///      owner cannot clear it, and every later amount reaches it.
+    function test_A1_D22_NaiveGateLocksInTheThiefObserver() public {
+        ERC7984NaiveGateToken naive = new ERC7984NaiveGateToken();
+        _thiefObserverThenRetire(naive);
+
+        vm.prank(holder);
+        vm.expectRevert(abi.encodeWithSelector(ERC7984NaiveGateToken.ERC7984AccountRetired.selector, holder));
+        naive.setObserver(holder, address(0));
+
+        bytes32 transferred = _transferTo(naive, holder);
+        assertTrue(acl.persistAllowed(_balance(naive, holder), thiefObserver), "the observer reads the next balance");
+        assertTrue(acl.persistAllowed(transferred, thiefObserver), "the observer reads the next amount");
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // A1: operators
+    ////////////////////////////////////////////////////////////////////////////
+
+    /// @dev ERC-7984 operators are valid while `block.timestamp <= until`, so `until == block.timestamp` grants
+    ///      operator status for the rest of the current timestamp. A gate on `until > block.timestamp` misses it.
+    function test_A1_OperatorUntilNowIsAGrant() public {
+        _retire(holder);
+        vm.prank(holder);
+        vanilla.setOperator(operator, uint48(block.timestamp));
+        assertTrue(vanilla.isOperator(holder, operator), "valid in the current block");
+        vm.warp(block.timestamp + 1);
+        assertFalse(vanilla.isOperator(holder, operator));
+    }
+
+    function test_A1_OperatorGate() public {
+        vm.warp(1_000_000);
+        vm.prank(holder);
+        profileA.setOperator(operator, uint48(block.timestamp + 1 days));
+        _retire(holder);
+        assertTrue(profileA.isOperator(holder, operator), "an operator set before retirement stays until revoked");
+
+        bytes memory refused = abi.encodeWithSelector(
+            ERC7984ProfileAToken.ERC7984GrantByRetiredAccount.selector,
+            holder
+        );
+        vm.prank(holder);
+        vm.expectRevert(refused);
+        profileA.setOperator(recipient, uint48(block.timestamp + 1 days));
+        vm.prank(holder);
+        vm.expectRevert(refused);
+        profileA.setOperator(recipient, uint48(block.timestamp));
+        vm.prank(holder);
+        vm.expectRevert(refused);
+        profileA.setOperator(operator, type(uint48).max);
+
+        vm.prank(holder);
+        profileA.setOperator(operator, 0);
+        assertFalse(profileA.isOperator(holder, operator), "revoking stays allowed");
+        vm.prank(holder);
+        profileA.setOperator(recipient, uint48(block.timestamp - 1));
+        assertFalse(profileA.isOperator(holder, recipient));
+
+        vm.prank(sender);
+        profileA.setOperator(operator, uint48(block.timestamp + 1 days));
+        assertTrue(profileA.isOperator(sender, operator), "an active holder is not affected");
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // A2: transfers (TC23 case 2)
+    ////////////////////////////////////////////////////////////////////////////
+
+    /// @dev Inbound: the transfer succeeds; the grant to the retired recipient is inert.
+    function test_A2_TransferToRetiredAccountSucceeds() public {
+        _retire(holder);
+        bytes32 transferred = _transferTo(profileA, holder);
+        bytes32 received = _balance(profileA, holder);
+        assertTrue(received != bytes32(0));
+        assertTrue(acl.persistAllowed(received, address(profileA)), "the token keeps access");
+        assertFalse(acl.persistAllowed(received, holder), "inert for the retired recipient");
+        assertFalse(acl.persistAllowed(transferred, holder));
+        assertTrue(acl.persistAllowed(transferred, sender));
+    }
+
+    /// @dev Outbound: Profile A adds no block. With a fresh input the retired account moves its funds, directly and
+    ///      through an operator it set while active (limit 2: oracle access only).
+    function test_A2_TransferFromRetiredAccountSucceeds() public {
+        vm.etch(inputVerifierAdd, address(new ProfileAMockInputVerifier()).code);
+        profileA.mint(holder, 1_000);
+        vm.prank(holder);
+        profileA.setOperator(operator, type(uint48).max);
+        acl.cleanTransientStorage();
+        _retire(holder);
+        bytes32 before = _balance(profileA, holder);
+
+        vm.prank(holder);
+        profileA.confidentialTransfer(recipient, externalEuint64.wrap(_freshInput("direct")), hex"01");
+        assertTrue(_balance(profileA, recipient) != bytes32(0));
+        assertTrue(_balance(profileA, holder) != before);
+
+        vm.prank(operator);
+        profileA.confidentialTransferFrom(holder, recipient, externalEuint64.wrap(_freshInput("operator")), hex"01");
+        acl.cleanTransientStorage();
+        assertTrue(acl.persistAllowed(_balance(profileA, recipient), recipient));
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // A3: no post-grant assertion
+    ////////////////////////////////////////////////////////////////////////////
+
+    /// @dev A token that asserts the recipient's access after granting breaks every transfer to a retired account.
+    ///      The Profile A token, which asserts nothing, accepts the same transfer.
+    function test_A3_PostGrantAssertionBreaksTransfersToRetiredAccounts() public {
+        ERC7984PostGrantAssertToken asserting = new ERC7984PostGrantAssertToken();
+        asserting.mint(sender, 100);
+        acl.cleanTransientStorage();
+        asserting.mint(recipient, 1);
+        acl.cleanTransientStorage();
+        _retire(holder);
+
+        bytes32 amount = _balance(asserting, sender);
+        vm.prank(sender);
+        vm.expectRevert(
+            abi.encodeWithSelector(ERC7984PostGrantAssertToken.ERC7984RecipientCannotUseBalance.selector, holder)
+        );
+        asserting.confidentialTransfer(holder, euint64.wrap(amount));
+
+        _transferTo(profileA, holder);
+        assertTrue(_balance(profileA, holder) != bytes32(0));
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // gas: the cost of the A1 gates
+    ////////////////////////////////////////////////////////////////////////////
+
+    /// @dev Execution gas of one call from `who`, with the token, the registry proxy and its implementation cold.
+    function _gasOf(address who, address target, bytes memory data) internal returns (uint256 used) {
+        vm.cool(target);
+        vm.cool(aclAdd);
+        vm.cool(aclImplementation);
+        vm.prank(who);
+        uint256 before = gasleft();
+        (bool ok, ) = target.call(data);
+        used = before - gasleft();
+        assertTrue(ok);
+    }
+
+    /// @dev The same call, by an active account, on the vanilla and the Profile A token. The difference is the gate:
+    ///      one `isAccountRetired` view through the registry proxy. The two tokens get different balance handles and
+    ///      different observers, so neither call writes a slot the other one wrote earlier in this test transaction.
+    function test_Gas_A1GateOverhead() public {
+        vm.warp(1_000_000);
+        vanilla.mint(holder, 1_000);
+        profileA.mint(holder, 1_001);
+        acl.cleanTransientStorage();
+        assertTrue(_balance(vanilla, holder) != _balance(profileA, holder));
+
+        bytes memory setOperator = abi.encodeCall(ERC7984.setOperator, (operator, uint48(block.timestamp + 1 days)));
+        uint256 operatorVanilla = _gasOf(holder, address(vanilla), setOperator);
+        uint256 operatorProfileA = _gasOf(holder, address(profileA), setOperator);
+        uint256 observerVanilla = _gasOf(
+            holder,
+            address(vanilla),
+            abi.encodeCall(ERC7984ObserverAccess.setObserver, (holder, friendObserver))
+        );
+        uint256 observerProfileA = _gasOf(
+            holder,
+            address(profileA),
+            abi.encodeCall(ERC7984ObserverAccess.setObserver, (holder, thiefObserver2))
+        );
+
+        emit log_named_uint("setOperator, vanilla", operatorVanilla);
+        emit log_named_uint("setOperator, Profile A", operatorProfileA);
+        emit log_named_uint("setObserver with a balance, vanilla", observerVanilla);
+        emit log_named_uint("setObserver with a balance, Profile A", observerProfileA);
+        emit log_named_uint("gate overhead, setOperator", operatorProfileA - operatorVanilla);
+        emit log_named_uint("gate overhead, setObserver", observerProfileA - observerVanilla);
+        assertGt(operatorProfileA, operatorVanilla);
+        assertGt(observerProfileA, observerVanilla);
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // A4: generic calls
+    ////////////////////////////////////////////////////////////////////////////
+
+    /// @dev Without A4, the generic-call path retires the contract itself: its handles are bricked (it can no longer
+    ///      share them, and the views refuse it). The registry's multicall reaches the same function.
+    function test_A4_Residual_GenericCallRetiresTheContract() public {
+        GenericCallVault vault = new GenericCallVault(admin);
+        euint64 h = vault.store(7);
+        acl.cleanTransientStorage();
+        assertTrue(acl.persistAllowed(euint64.unwrap(h), address(vault)));
+
+        vm.prank(admin);
+        vault.execute(aclAdd, abi.encodeCall(ACL.retireAccount, ()));
+        assertTrue(acl.isAccountRetired(address(vault)));
+        assertFalse(acl.persistAllowed(euint64.unwrap(h), address(vault)), "the vault's handles are bricked");
+        vm.expectRevert(abi.encodeWithSelector(ACL.SenderRetired.selector, address(vault)));
+        vault.share(h, recipient);
+
+        GenericCallVault vault2 = new GenericCallVault(admin);
+        bytes[] memory calls = new bytes[](1);
+        calls[0] = abi.encodeCall(ACL.retireAccount, ());
+        vm.prank(admin);
+        vault2.execute(aclAdd, abi.encodeCall(MulticallUpgradeable.multicall, (calls)));
+        assertTrue(acl.isAccountRetired(address(vault2)), "multicall keeps the vault as msg.sender");
+    }
+
+    /// @dev Without A4, the same path designates an attacker as the contract's successor, confirms it after the delay
+    ///      and retires the contract. The delegated view then answers true for (vault, attacker) on the vault's handle,
+    ///      in the context of an app the vault shared it with.
+    function test_A4_Residual_GenericCallHandsTheContractToASuccessor() public {
+        GenericCallVault vault = new GenericCallVault(admin);
+        address app = makeAddr("app");
+        euint64 h = vault.store(7);
+        vault.share(h, app);
+        acl.cleanTransientStorage();
+        assertFalse(acl.isHandleDelegatedForUserDecryption(address(vault), attacker, app, euint64.unwrap(h)));
+
+        vm.prank(admin);
+        vault.execute(aclAdd, abi.encodeCall(ACL.designateSuccessor, (attacker)));
+        vm.prank(attacker);
+        acl.acceptSuccession(address(vault));
+        vm.warp(block.timestamp + acl.successorDelayOf(address(vault)));
+        vm.prank(admin);
+        vault.execute(aclAdd, abi.encodeCall(ACL.confirmSuccessor, ()));
+        vm.prank(admin);
+        vault.execute(aclAdd, abi.encodeCall(ACL.retireAccount, ()));
+
+        assertEq(acl.successorOf(address(vault)), attacker);
+        assertTrue(
+            acl.isHandleDelegatedForUserDecryption(address(vault), attacker, app, euint64.unwrap(h)),
+            "the attacker reads as the vault's successor"
+        );
+    }
+
+    /// @dev Profile A (A4): the generic-call path refuses every lifecycle function on the registry, and its multicall.
+    ///      Other registry calls and calls to other targets still go through.
+    function test_A4_ProfileARefusesLifecycleCalls() public {
+        GenericCallVaultProfileA vault = new GenericCallVaultProfileA(admin);
+        bytes[] memory calls = new bytes[](1);
+        calls[0] = abi.encodeCall(ACL.retireAccount, ());
+        bytes[8] memory refused = [
+            abi.encodeCall(ACL.retireAccount, ()),
+            abi.encodeCall(ACL.designateSuccessor, (attacker)),
+            abi.encodeCall(ACL.acceptSuccession, (attacker)),
+            abi.encodeCall(ACL.cancelSuccessorDesignation, ()),
+            abi.encodeCall(ACL.confirmSuccessor, ()),
+            abi.encodeCall(ACL.resignSuccession, (attacker)),
+            abi.encodeCall(ACL.raiseSuccessorDelay, (uint64(30 days))),
+            abi.encodeCall(MulticallUpgradeable.multicall, (calls))
+        ];
+        for (uint256 i = 0; i < refused.length; i++) {
+            vm.prank(admin);
+            vm.expectRevert(
+                abi.encodeWithSelector(GenericCallVaultProfileA.LifecycleCallRefused.selector, bytes4(refused[i]))
+            );
+            vault.execute(aclAdd, refused[i]);
+        }
+        assertFalse(acl.isAccountRetired(address(vault)));
+
+        euint64 h = vault.store(7);
+        acl.cleanTransientStorage();
+        vm.prank(admin);
+        vault.execute(aclAdd, abi.encodeCall(ACL.allow, (euint64.unwrap(h), recipient)));
+        assertTrue(acl.persistAllowed(euint64.unwrap(h), recipient), "other registry calls still go through");
+    }
+}

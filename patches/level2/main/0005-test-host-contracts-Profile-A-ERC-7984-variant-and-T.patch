+// SPDX-License-Identifier: BSD-3-Clause-Clear
+pragma solidity ^0.8.24;
+
+import {FHE, euint64} from "@fhevm-host-contracts/lib/FHE.sol";
+import {CoprocessorSetup} from "@fhevm-host-contracts/lib/CoprocessorSetup.sol";
+import {FHEVMExecutor} from "@fhevm-host-contracts/contracts/FHEVMExecutor.sol";
+import {aclAdd} from "@fhevm-host-contracts/addresses/FHEVMHostAddresses.sol";
+import {ACL} from "@fhevm-host-contracts/contracts/ACL.sol";
+import {MulticallUpgradeable} from "@openzeppelin/contracts-upgradeable/utils/MulticallUpgradeable.sol";
+
+import {ERC7984} from "./oz-confidential-contracts-0.5.3/token/ERC7984/ERC7984.sol";
+import {ERC7984ObserverAccess} from "./oz-confidential-contracts-0.5.3/token/ERC7984/extensions/ERC7984ObserverAccess.sol";
+
+/**
+ * @notice OpenZeppelin ERC-7984 with `ERC7984ObserverAccess` (confidential-contracts 0.5.3, vendored test-only copy)
+ *         and a test mint. No Profile A: the vanilla behaviour.
+ */
+contract ERC7984ObserverToken is ERC7984ObserverAccess {
+    constructor() ERC7984("Observer Test Token", "OTT", "") {
+        FHE.setCoprocessor(CoprocessorSetup.defaultConfig());
+    }
+
+    function mint(address to, uint64 amount) external returns (euint64) {
+        return _mint(to, FHE.asEuint64(amount));
+    }
+}
+
+/**

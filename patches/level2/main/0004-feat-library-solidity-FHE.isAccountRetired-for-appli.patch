+++ b/host-contracts/lib/Impl.sol
@@ -425,6 +425,13 @@ interface IACL {
      */
     function isAccountDenied(address account) external view returns (bool);
 
+    /**
+     * @notice                  Returns whether the account is retired.
+     * @param account           Address of the account.
+     * @return isAccountRetired Whether the account is retired.
+     */
+    function isAccountRetired(address account) external view returns (bool);
+
     /**
      * @notice              Delegates user decryption rights to `delegate` for the specified `contractAddress`.
      * @param delegate      The delegate account.
@@ -926,6 +933,17 @@ library Impl {
         return IACL($.ACLAddress).isAccountDenied(account);
     }
 
+    /**
+     * @notice                  Returns whether the account is retired.
+     * @dev                     Requires an ACL with the lifecycle Core; against an older ACL the call reverts.
+     * @param account           Address of the account.
+     * @return isAccountRetired Whether the account is retired.
+     */
+    function isAccountRetired(address account) internal view returns (bool) {
+        CoprocessorConfig storage $ = getCoprocessorConfig();
+        return IACL($.ACLAddress).isAccountRetired(account);
+    }
+
     /**
      * @notice              Delegates user decryption rights to `delegate` for the specified `contractAddress`.
      * @param delegate      The delegate account.

+        _assertBaseStatePreserved();
+        _assertEnforced();
+        (bool ok, ) = aclAdd.staticcall(abi.encodeWithSignature("successorOf(address)", alice));
+        assertFalse(ok, "v0.5.1 has no E1 view");
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // U3: guard-less v0.4.1 -> v0.5.0 succeeds and enforcement lapses (hazard demo)
+    ////////////////////////////////////////////////////////////////////////////
+
+    /// @dev On this line the target is v0.5.0, whose reinitializer (6) equals guard-less v0.4.1's, so the upgrade goes
+    ///      without the call (U5 shows the collision).
+    function test_U3_GuardlessV041_to_v050_EnforcementLapses() public {
+        _deployProxyWith(address(new ACL_v0_4_0()));
+        _seedState();
+        _upgrade(address(new ACL_v0_4_1_noguard()), "reinitializeV5()");
+        _retireThree();
+        _assertEnforced();
+
+        _upgrade(address(new ACL_v0_5_0()), "");
+

+        assertEq(_initializedVersion(), 7);
+        _assertBaseStatePreserved();
+        _assertEnforced();
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // U6: v0.4.0 -> v0.5.1 directly, and v0.4.2 -> v0.5.1 (the reinitializer collision)
+    ////////////////////////////////////////////////////////////////////////////
+
+    function test_U6_v040_to_v051_StatePreserved_CoreActive() public {
+        _deployProxyWith(address(new ACL_v0_4_0()));
+        _seedState();
+        // v0.4.0's _authorizeUpgrade is empty; reinitializer 5 -> 7.
+        _upgrade(address(new ACL()), "reinitializeV6()");
+        assertEq(acl.getVersion(), "ACL v0.5.1");
+        assertEq(_initializedVersion(), 7);
+        _assertBaseStatePreserved();
+        _retireThree();
+        _assertEnforced();
+    }
+
+    /// @dev Our v0.13 E1 release (v0.4.2) and v0.5.1 both take reinitializer 7. The guard in v0.4.2 accepts v0.5.1,

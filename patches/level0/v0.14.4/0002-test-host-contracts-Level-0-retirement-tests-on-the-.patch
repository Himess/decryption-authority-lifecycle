+        _retireThree();
+        _assertEnforced();
+    }
+
+    ////////////////////////////////////////////////////////////////////////////
+    // U2 = U6 (v0.4.1 -> v0.5.1): bits and enforcement preserved across lines
+    ////////////////////////////////////////////////////////////////////////////
+
+    function test_U2_U6_v041_to_v051_BitsAndEnforcementPreserved() public {
+        _deployProxyWith(address(new ACL_v0_4_0()));
+        _seedState();
+        _upgrade(address(new ACL_v0_4_1()), "reinitializeV5()");
+        _retireThree();
+        _assertEnforced();
+
+        // Guard in v0.4.1 accepts v0.5.1 (declares Core, same location); reinitializer 6 -> 7.
+        _upgrade(address(new ACL()), "reinitializeV6()");
+

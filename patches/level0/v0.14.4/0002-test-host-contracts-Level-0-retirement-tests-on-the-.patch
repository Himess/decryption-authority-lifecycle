+    function _decode2(bytes memory revertData) internal pure returns (bytes4 sel, bytes32 a, address b) {
+        assembly {
+            sel := mload(add(revertData, 32))
+            a := mload(add(revertData, 36))
+            b := mload(add(revertData, 68))
+        }
+    }

+/// K8 for a deployment of `Single` nodes: no implementation runs on more than `t` nodes, so a bug in
+/// one library reaches at most t nodes. `assignment` holds each node's implementation.
+pub fn k8_assignment_ok(assignment: &[MlDsaImpl], t: usize) -> bool {
+    MlDsaImpl::ALL
+        .into_iter()
+        .all(|i| assignment.iter().filter(|a| **a == i).count() <= t)
+}
+
+/// K8 `Single` needs at least `ceil(n / t)` implementations for n nodes and threshold t.
+pub fn k8_min_implementations(n: usize, t: usize) -> Option<usize> {
+    (t > 0).then(|| n.div_ceil(t))
+}

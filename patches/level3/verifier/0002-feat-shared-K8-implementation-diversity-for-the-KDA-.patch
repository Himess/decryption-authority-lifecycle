+/// Test-only fault injection for K8 (feature `k8-fault-injection`): one implementation accepts every
+/// public key and signature of the right lengths, as a library with a broken final check would.
+#[cfg(feature = "k8-fault-injection")]
+pub mod fault {
+    use super::MlDsaImpl;
+    use std::sync::atomic::{AtomicU8, Ordering};
+
+    /// 0: no fault; `i + 1`: `MlDsaImpl::ALL[i]` accepts everything.
+    static ACCEPT_ALL: AtomicU8 = AtomicU8::new(0);
+
+    /// Makes `implementation` accept every well-sized signature, or clears the fault with `None`.
+    pub fn inject_accept_all(implementation: Option<MlDsaImpl>) {
+        let v = implementation
+            .and_then(|i| MlDsaImpl::ALL.iter().position(|x| *x == i))
+            .map_or(0, |p| p as u8 + 1);
+        ACCEPT_ALL.store(v, Ordering::SeqCst);
+    }
+
+    pub(crate) fn accepts_all(implementation: MlDsaImpl) -> bool {
+        let v = ACCEPT_ALL.load(Ordering::SeqCst);
+        v != 0 && MlDsaImpl::ALL[(v - 1) as usize] == implementation
+    }
+}

+    use libcrux_ml_dsa::{MLDSASignature, MLDSAVerificationKey};
+    macro_rules! run {
+        ($m:ident) => {{
+            let key = MLDSAVerificationKey::new(
+                public_key
+                    .try_into()
+                    .map_err(|_| KdaError::MalformedPublicKey(scheme))?,
+            );
+            let signature = MLDSASignature::new(
+                sig.try_into()
+                    .map_err(|_| KdaError::MalformedSignature(scheme))?,
+            );

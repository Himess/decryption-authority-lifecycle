+/// K8, implementation diversity, as one node applies it. The ICS states the mode.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum K8Mode {
+    /// The node runs one implementation. The deployment must keep every implementation on at most
+    /// t nodes ([`k8_assignment_ok`]).
+    Single(MlDsaImpl),
+    /// The node accepts only if two different implementations both accept.
+    Agree(MlDsaImpl, MlDsaImpl),
+}
+
+impl Default for K8Mode {
+    fn default() -> Self {
+        Self::Single(MlDsaImpl::RustCrypto)
+    }
+}
+
+impl K8Mode {
+    /// `agree` with two different implementations.
+    pub fn agree(a: MlDsaImpl, b: MlDsaImpl) -> Option<Self> {
+        (a != b).then_some(Self::Agree(a, b))
+    }
+
+    /// The implementations this mode runs.
+    pub fn implementations(self) -> Vec<MlDsaImpl> {
+        match self {
+            Self::Single(i) => vec![i],
+            Self::Agree(a, b) => vec![a, b],
+        }
+    }
+}
+
+impl fmt::Display for K8Mode {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Single(i) => write!(f, "single:{i}"),
+            Self::Agree(a, b) => write!(f, "agree:{a},{b}"),
+        }
+    }
+}
+
+impl FromStr for K8Mode {
+    type Err = String;
+
+    /// `single:<impl>` or `agree:<impl>,<impl>`, with implementation names from [`MlDsaImpl::name`].
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let parse = |name: &str| {
+            MlDsaImpl::from_name(name)
+                .ok_or_else(|| format!("unknown ML-DSA implementation `{name}`"))
+        };
+        let s = s.trim();
+        if let Some(rest) = s.strip_prefix("single:") {
+            return Ok(Self::Single(parse(rest)?));
+        }
+        if let Some(rest) = s.strip_prefix("agree:") {
+            let (a, b) = rest
+                .split_once(',')
+                .ok_or_else(|| format!("`{s}`: agree needs two implementations"))?;
+            return Self::agree(parse(a)?, parse(b)?)
+                .ok_or_else(|| format!("`{s}`: agree needs two different implementations"));
+        }
+        Err(format!(
+            "unknown K8 mode `{s}` (expected `single:<impl>` or `agree:<impl>,<impl>`)"
+        ))
+    }
+}

index 00000000..b487209e
--- /dev/null
+++ b/shared/user-decryption-signature/tests/k8.rs
@@ -0,0 +1,347 @@
+//! [lifecycle Level 3, K8] Implementation diversity, with a fault injected into one ML-DSA implementation.
+//!
+//! The fault (feature `k8-fault-injection`) makes one implementation accept every public key and signature of the
+//! right lengths, as a library with a broken final check would. A forged signature (bytes of the right length that
+//! do not verify) then shows what each K8 mode lets through:
+//! - `agree`: a node refuses as soon as its two implementations disagree, and reports the disagreement;
+//! - `single`: each node accepts what its own implementation accepts, so the bound comes from the deployment: with
+//!   n = 13 and t = 4, no implementation may run on more than 4 nodes, which needs at least 4 implementations.
+//!
+//! The 13-node runs print `K8-NODES` JSON lines; `impl/harness/phase4/k8_sim.py` feeds the accepting nodes' Shamir
+//! shares to the Phase 3 reconstruction (t + 1 = 5 shares release).
+//!
+//! The fault switch is process-wide, so every test here takes `FAULT` first.
+#![cfg(all(feature = "k8", feature = "k8-fault-injection"))]
+
+use alloy::{
+    primitives::{Address, B256, Bytes, address, b256},
+    providers::{Provider, ProviderBuilder, mock::Asserter},
+};
+use ml_dsa::{MlDsaParams, Seed, Signature, SigningKey};
+use std::sync::Mutex;
+use user_decryption_signature::{
+    AttemptState, CodeFirstMode, SignatureInput, SignaturePolicy,
+    kda::{
+        K8Mode, KdaError, KdaOutcome, KdaScheme, MlDsaImpl, fault, k8_assignment_ok,
+        k8_min_implementations, key_derived_address, request_signature, verify_native_k8,
+        verify_with_kda_k8,
+    },
+};
+
+static FAULT: Mutex<()> = Mutex::new(());
+
+const DIGEST: B256 = b256!("1111111111111111111111111111111111111111111111111111111111111111");
+const ACCOUNT: Address = address!("0x00000000000000000000000000000000000000aa");
+const N: usize = 13;
+const T: usize = 4;
+
+fn keyed<P: MlDsaParams>(seed: u8, message: &[u8]) -> (Vec<u8>, Vec<u8>) {
+    let sk = SigningKey::<P>::from_seed(&Seed::try_from(&[seed; 32][..]).unwrap());
+    let esk = sk.expanded_key();
+    let sig: Signature<P> = esk.sign_deterministic(message, &[]).unwrap();
+    (esk.verifying_key().encode().to_vec(), sig.encode().to_vec())
+}
+
+fn keyed_scheme(scheme: KdaScheme, message: &[u8]) -> (Vec<u8>, Vec<u8>) {
+    match scheme {
+        KdaScheme::MlDsa44 => keyed::<ml_dsa::MlDsa44>(44, message),
+        KdaScheme::MlDsa65 => keyed::<ml_dsa::MlDsa65>(65, message),
+        KdaScheme::MlDsa87 => keyed::<ml_dsa::MlDsa87>(87, message),
+    }
+}
+
+/// (public key, valid signature over `message`, forged signature). The forgery is the same key's well-formed
+/// signature over another message: it decodes everywhere and verifies nowhere.
+fn material(scheme: KdaScheme, message: &[u8]) -> (Vec<u8>, Vec<u8>, Vec<u8>) {
+    let (pk, sig) = keyed_scheme(scheme, message);
+    let (_, forged) = keyed_scheme(scheme, B256::repeat_byte(0x33).as_slice());
+    (pk, sig, forged)
+}
+
+/// Refused without a disagreement (libraries may name a malformed input differently).
+fn refused_alike(r: &Result<(), KdaError>) -> bool {
+    matches!(
+        r,
+        Err(KdaError::InvalidSignature(_)
+            | KdaError::MalformedSignature(_)
+            | KdaError::MalformedPublicKey(_))
+    )
+}
+
+fn pairs() -> Vec<(MlDsaImpl, MlDsaImpl)> {
+    let mut v = Vec::new();
+    for (i, a) in MlDsaImpl::ALL.into_iter().enumerate() {
+        for b in MlDsaImpl::ALL.into_iter().skip(i + 1) {
+            v.push((a, b));
+        }
+    }
+    v
+}
+
+struct Cleared;
+impl Drop for Cleared {
+    fn drop(&mut self) {
+        fault::inject_accept_all(None);
+    }
+}
+
+#[test]
+fn modes_parse_and_print() {
+    let _g = FAULT.lock().unwrap_or_else(|e| e.into_inner());
+    for s in [
+        "single:rustcrypto",
+        "single:pqclean",
+        "agree:rustcrypto,libcrux",
+        "agree:fips204,pqclean",
+    ] {
+        let m: K8Mode = s.parse().unwrap();
+        assert_eq!(m.to_string(), s);
+    }
+    assert!("agree:fips204,fips204".parse::<K8Mode>().is_err());
+    assert!("single:openssl".parse::<K8Mode>().is_err());
+    assert!("both".parse::<K8Mode>().is_err());
+    assert_eq!(K8Mode::default(), K8Mode::Single(MlDsaImpl::RustCrypto));
+}
+
+#[test]
+fn without_a_fault_every_mode_gives_the_same_verdicts() {
+    let _g = FAULT.lock().unwrap_or_else(|e| e.into_inner());
+    fault::inject_accept_all(None);
+    for scheme in KdaScheme::ALL {
+        let (pk, sig, forged) = material(scheme, DIGEST.as_slice());
+        let mut modes: Vec<K8Mode> = MlDsaImpl::ALL.into_iter().map(K8Mode::Single).collect();
+        modes.extend(pairs().into_iter().map(|(a, b)| K8Mode::Agree(a, b)));
+        for mode in modes {
+            assert_eq!(
+                verify_native_k8(mode, scheme, &pk, DIGEST.as_slice(), &sig),
+                Ok(()),
+                "{mode} {scheme}"
+            );
+            assert_eq!(
+                verify_native_k8(mode, scheme, &pk, DIGEST.as_slice(), &forged),
+                Err(KdaError::InvalidSignature(scheme)),
+                "{mode} {scheme}"
+            );
+            assert_eq!(
+                verify_native_k8(mode, scheme, &pk, B256::repeat_byte(0x22).as_slice(), &sig),
+                Err(KdaError::InvalidSignature(scheme)),
+                "{mode} {scheme}: another message"
+            );
+            // Malformed inputs: refused by every library, whatever it calls them.
+            let garbage = vec![0x5a; scheme.signature_len()];
+            for (key, s) in [
+                (&pk[..], &garbage[..]),
+                (&pk[..], &sig[..10]),
+                (&pk[..pk.len() - 1], &sig[..]),
+            ] {
+                let r = verify_native_k8(mode, scheme, key, DIGEST.as_slice(), s);
+                assert!(refused_alike(&r), "{mode} {scheme}: {r:?}");
+            }
+        }
+    }
+}
+
+#[test]
+fn agree_refuses_and_reports_when_one_library_is_faulty() {
+    let _g = FAULT.lock().unwrap_or_else(|e| e.into_inner());
+    let _c = Cleared;
+    for faulty in MlDsaImpl::ALL {
+        fault::inject_accept_all(Some(faulty));
+        for scheme in KdaScheme::ALL {
+            let (pk, sig, forged) = material(scheme, DIGEST.as_slice());
+            // The faulty library alone accepts the forgery.
+            assert_eq!(
+                verify_native_k8(
+                    K8Mode::Single(faulty),
+                    scheme,
+                    &pk,
+                    DIGEST.as_slice(),
+                    &forged
+                ),
+                Ok(())
+            );
+            for (a, b) in pairs() {
+                let mode = K8Mode::Agree(a, b);
+                let got = verify_native_k8(mode, scheme, &pk, DIGEST.as_slice(), &forged);
+                if faulty == a || faulty == b {
+                    let other = if faulty == a { b } else { a };
+                    assert_eq!(
+                        got,
+                        Err(KdaError::ImplementationsDisagree {
+                            scheme,
+                            accepted: faulty,
+                            refused: other
+                        }),
+                        "{mode} {scheme} faulty={faulty}"
+                    );
+                    println!(
+                        "K8-AGREE scheme={scheme} mode={mode} faulty={faulty} verdict=refused-disagreement"
+                    );
+                } else {
+                    assert_eq!(
+                        got,
+                        Err(KdaError::InvalidSignature(scheme)),
+                        "{mode} {scheme} faulty={faulty}"
+                    );
+                }
+                // A valid signature is still accepted: the fault only adds acceptances.
+                assert_eq!(
+                    verify_native_k8(mode, scheme, &pk, DIGEST.as_slice(), &sig),
+                    Ok(())
+                );
+            }
+        }
+    }
+}
+
+/// Runs the forged request on every node of `assignment` and returns the accepting node indices (1-based).
+fn accepting(assignment: &[K8Mode], scheme: KdaScheme, pk: &[u8], forged: &[u8]) -> Vec<usize> {
+    assignment
+        .iter()
+        .enumerate()
+        .filter(|(_, m)| verify_native_k8(**m, scheme, pk, DIGEST.as_slice(), forged).is_ok())
+        .map(|(i, _)| i + 1)
+        .collect()
+}
+
+fn single(counts: [(MlDsaImpl, usize); 4]) -> Vec<K8Mode> {
+    counts
+        .into_iter()
+        .flat_map(|(i, n)| std::iter::repeat_n(K8Mode::Single(i), n))
+        .collect()
+}
+
+#[test]
+fn thirteen_nodes_one_library_bug_reaches_at_most_t_nodes() {
+    let _g = FAULT.lock().unwrap_or_else(|e| e.into_inner());
+    let _c = Cleared;
+    use MlDsaImpl::*;
+    assert_eq!(k8_min_implementations(N, T), Some(4));
+    assert_eq!(k8_min_implementations(N, 0), None);
+
+    let deployments: Vec<(&str, Vec<K8Mode>)> = vec![
+        // K8 single: each library on at most t = 4 nodes.
+        (
+            "single-4-3-3-3",
+            single([(RustCrypto, 4), (Fips204, 3), (Libcrux, 3), (PqClean, 3)]),
+        ),
+        // Not K8: one library on t + 1 = 5 nodes.
+        (
+            "single-5-3-3-2",
+            single([(RustCrypto, 5), (Fips204, 3), (Libcrux, 3), (PqClean, 2)]),
+        ),
+        // K8 agree: every node needs two libraries, in rotating pairs.
+        (
+            "agree-rotating",
+            (0..N)
+                .map(|i| K8Mode::Agree(MlDsaImpl::ALL[i % 4], MlDsaImpl::ALL[(i + 1) % 4]))
+                .collect(),
+        ),
+    ];
+    for (name, assignment) in &deployments {
+        let singles: Vec<MlDsaImpl> = assignment
+            .iter()
+            .filter_map(|m| match m {
+                K8Mode::Single(i) => Some(*i),
+                K8Mode::Agree(..) => None,
+            })
+            .collect();
+        let k8_single_ok = singles.len() == N && k8_assignment_ok(&singles, T);
+        for faulty in MlDsaImpl::ALL {
+            fault::inject_accept_all(Some(faulty));
+            for scheme in KdaScheme::ALL {
+                let (pk, _, forged) = material(scheme, DIGEST.as_slice());
+                let nodes = accepting(assignment, scheme, &pk, &forged);
+                println!(
+                    "K8-NODES {{\"deployment\":\"{name}\",\"k8_single_ok\":{k8_single_ok},\"faulty\":\"{faulty}\",\"scheme\":\"{scheme}\",\"accepting\":{nodes:?}}}"
+                );
+                match *name {
+                    "single-4-3-3-3" => {
+                        assert!(k8_single_ok);
+                        assert!(
+                            nodes.len() <= T,
+                            "{name} faulty={faulty}: {} nodes",
+                            nodes.len()
+                        );
+                    }
+                    "single-5-3-3-2" => {
+                        assert!(!k8_single_ok);
+                        if faulty == RustCrypto {
+                            assert_eq!(nodes.len(), T + 1, "the violation lets t + 1 nodes accept");
+                        }
+                    }
+                    _ => assert!(
+                        nodes.is_empty(),
+                        "{name} faulty={faulty}: agree lets nothing through"
+                    ),
+                }
+            }
+        }
+    }
+}
+
+fn provider(asserter: &Asserter) -> impl Provider {
+    ProviderBuilder::new()
+        .disable_recommended_fillers()
+        .connect_mocked_client(asserter.clone())
+}
+
+// The guard only serialises the tests that use the process-wide fault switch; this test's runtime is single-threaded.
+#[allow(clippy::await_holding_lock)]
+#[tokio::test]
+async fn route_reports_a_disagreement_with_no_fallback() {
+    let _g = FAULT.lock().unwrap_or_else(|e| e.into_inner());
+    let _c = Cleared;
+    fault::inject_accept_all(Some(MlDsaImpl::Fips204));
+    let scheme = KdaScheme::MlDsa65;
+    let (pk, _, forged) = material(scheme, DIGEST.as_slice());
+    let signer_bytes = scheme.signer_bytes(&pk);
+    let kda = key_derived_address(&signer_bytes);
+    let signature = request_signature(&signer_bytes, &forged);
+    let policy = SignaturePolicy {
+        mode: CodeFirstMode::Enforce,
+        ..SignaturePolicy::default()
+    };
+    let input = SignatureInput {
+        signer: kda,
+        digest: DIGEST,
+        signature: &signature,
+        public_key_len: 800,
+        extra_data_len: 1,
+    };
+
+    for (mode, expected) in [
+        (
+            K8Mode::Agree(MlDsaImpl::RustCrypto, MlDsaImpl::Fips204),
+            KdaOutcome::Kda(Err(KdaError::ImplementationsDisagree {
+                scheme,
+                accepted: MlDsaImpl::Fips204,
+                refused: MlDsaImpl::RustCrypto,
+            })),
+        ),
+        (
+            K8Mode::Single(MlDsaImpl::Libcrux),
+            KdaOutcome::Kda(Err(KdaError::InvalidSignature(scheme))),
+        ),
+        // The faulty library alone: the forgery passes (what K8 exists to bound).
+        (
+            K8Mode::Single(MlDsaImpl::Fips204),
+            KdaOutcome::Kda(Ok(scheme)),
+        ),
+    ] {
+        let a = Asserter::new();
+        a.push_success(&Bytes::new()); // eth_getCode(KDA): empty. Nothing else is queued: no fallback call.
+        let out = verify_with_kda_k8(
+            &provider(&a),
+            &input,
+            &[ACCOUNT],
+            &policy,
+            &KdaScheme::ALL,
+            mode,
+            AttemptState::default(),
+        )
+        .await;
+        assert_eq!(out, expected, "{mode}");
+        assert!(a.read_q().is_empty(), "{mode}: only the code read");
+    }
+}

+++ b/shared/user-decryption-signature/tests/k8_vectors.rs
@@ -0,0 +1,381 @@
+//! [lifecycle Level 3, K7/K8] Every ML-DSA implementation of the KDA route against the published vectors:
+//!
+//! - NIST ACVP-Server `ML-DSA-sigVer-FIPS204` (`internalProjection.json`, 180 tests: ML-DSA-44, -65 and -87, each
+//!   with external/pure, external/pre-hash, internal and internal with external mu groups);
+//! - C2SP Wycheproof `mldsa_44/65/87_verify_test.json` (631 tests).
+//!
+//! Provenance (URL, commit, SHA-256) is in `tests/vectors/PROVENANCE-K8.md`; the test checks each file's SHA-256
+//! first. The pure interface with a context string is the one the KDA route uses (with an empty context, K6), and it
+//! goes through the crate's own `verify_with_impl` for every implementation. The other ACVP interfaces are run on the
+//! implementations that expose them, by calling the library directly; a vector is counted as not exposed only when
+//! the library has no entry point for its interface.
+//!
+//! Each count is printed as a `K8-VECTORS` line. Every vector run must give the expected verdict.
+#![cfg(feature = "k8")]
+
+use alloy::hex;
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+use user_decryption_signature::kda::{KdaScheme, MlDsaImpl, verify_with_impl};
+
+const ACVP: &str = include_str!("vectors/acvp/ML-DSA-sigVer-FIPS204-internalProjection.json");
+const ACVP_SHA256: &str = "47cdd6314c7f746d02421ffcba89d4dbc7bb875ac49e07a029fdfc26fba55437";
+const WYCHEPROOF: [(KdaScheme, &str, &str); 3] = [
+    (
+        KdaScheme::MlDsa44,
+        include_str!("vectors/wycheproof-20b2569/mldsa_44_verify_test.json"),
+        "f70759c95146ff3057ae9708438f6e8d25ba822e3af11d2e87bb20d9a9c39d0e",
+    ),
+    (
+        KdaScheme::MlDsa65,
+        include_str!("vectors/wycheproof-20b2569/mldsa_65_verify_test.json"),
+        "1ca235f61928421a173a171780beb00264ae9155dc33c52a11e1766cc7979034",
+    ),
+    (
+        KdaScheme::MlDsa87,
+        include_str!("vectors/wycheproof-20b2569/mldsa_87_verify_test.json"),
+        "54adffe10f6dad7941ffd97f77ad4e5c85cb3a54d44cf5ce1c95cb1757b9ba14",
+    ),
+];
+
+/// SHA-256 of a vector file as published (LF line endings; a checkout may add carriage returns).
+fn sha256_hex(text: &str) -> String {
+    hex::encode(Sha256::digest(text.replace('\r', "").as_bytes()))
+}
+
+fn bytes(v: &Value, key: &str) -> Vec<u8> {
+    v.get(key)
+        .and_then(Value::as_str)
+        .map(|s| hex::decode(s).unwrap_or_else(|e| panic!("bad hex in `{key}`: {e}")))
+        .unwrap_or_default()
+}
+
+#[derive(Default)]
+struct Tally {
+    run: usize,
+    pass: usize,
+    not_exposed: usize,
+}
+
+type Key = (&'static str, &'static str, &'static str, String);
+
+fn record(tallies: &mut BTreeMap<Key, Tally>, key: Key, outcome: Option<bool>, expected: bool) {
+    let t = tallies.entry(key).or_default();
+    match outcome {
+        None => t.not_exposed += 1,
+        Some(accepted) => {
+            t.run += 1;
+            if accepted == expected {
+                t.pass += 1;
+            }
+        }
+    }
+}
+
+fn scheme_of(parameter_set: &str) -> KdaScheme {
+    KdaScheme::from_name(parameter_set)
+        .unwrap_or_else(|| panic!("unknown parameter set {parameter_set}"))
+}
+
+/// The pure interface, through the crate's own entry point (the KDA route's code path).
+fn pure(imp: MlDsaImpl, scheme: KdaScheme, pk: &[u8], msg: &[u8], ctx: &[u8], sig: &[u8]) -> bool {
+    verify_with_impl(imp, scheme, pk, msg, ctx, sig).is_ok()
+}
+
+/// RustCrypto `ml-dsa`: decoded key and signature, or `None` when either does not decode.
+fn rustcrypto_parts<P: ml_dsa::MlDsaParams>(
+    pk: &[u8],
+    sig: &[u8],
+) -> Option<(ml_dsa::VerifyingKey<P>, ml_dsa::Signature<P>)> {
+    let key =
+        ml_dsa::VerifyingKey::<P>::decode(&ml_dsa::EncodedVerifyingKey::<P>::try_from(pk).ok()?);
+    let sig = ml_dsa::Signature::<P>::decode(&ml_dsa::EncodedSignature::<P>::try_from(sig).ok()?)?;
+    Some((key, sig))
+}
+
+fn rustcrypto_internal<P: ml_dsa::MlDsaParams>(pk: &[u8], m_prime: &[u8], sig: &[u8]) -> bool {
+    rustcrypto_parts::<P>(pk, sig).is_some_and(|(k, s)| k.verify_internal(m_prime, &s))
+}
+
+fn rustcrypto_mu<P: ml_dsa::MlDsaParams>(pk: &[u8], mu: &[u8], sig: &[u8]) -> bool {
+    use ml_dsa::common::{array::Array, typenum::U64};
+    let Ok(mu) = Array::<u8, U64>::try_from(mu) else {
+        return false;
+    };
+    rustcrypto_parts::<P>(pk, sig).is_some_and(|(k, s)| k.verify_mu(&mu, &s))
+}
+
+fn libcrux_internal(scheme: KdaScheme, pk: &[u8], m_prime: &[u8], sig: &[u8]) -> bool {
+    use libcrux_ml_dsa::{MLDSASignature, MLDSAVerificationKey};
+    macro_rules! run {
+        ($m:ident) => {{
+            let (Ok(k), Ok(s)) = (pk.try_into(), sig.try_into()) else {
+                return false;
+            };
+            libcrux_ml_dsa::$m::verify_internal(
+                &MLDSAVerificationKey::new(k),
+                m_prime,
+                &MLDSASignature::new(s),
+            )
+            .is_ok()
+        }};
+    }
+    match scheme {
+        KdaScheme::MlDsa44 => run!(ml_dsa_44),
+        KdaScheme::MlDsa65 => run!(ml_dsa_65),
+        KdaScheme::MlDsa87 => run!(ml_dsa_87),
+    }
+}
+
+fn libcrux_shake128(scheme: KdaScheme, pk: &[u8], msg: &[u8], ctx: &[u8], sig: &[u8]) -> bool {
+    use libcrux_ml_dsa::{MLDSASignature, MLDSAVerificationKey};
+    macro_rules! run {
+        ($m:ident) => {{
+            let (Ok(k), Ok(s)) = (pk.try_into(), sig.try_into()) else {
+                return false;
+            };
+            libcrux_ml_dsa::$m::verify_pre_hashed_shake128(
+                &MLDSAVerificationKey::new(k),
+                msg,
+                ctx,
+                &MLDSASignature::new(s),
+            )
+            .is_ok()
+        }};
+    }
+    match scheme {
+        KdaScheme::MlDsa44 => run!(ml_dsa_44),
+        KdaScheme::MlDsa65 => run!(ml_dsa_65),
+        KdaScheme::MlDsa87 => run!(ml_dsa_87),
+    }
+}
+
+fn fips204_prehash(
+    scheme: KdaScheme,
+    ph: &fips204::Ph,
+    pk: &[u8],
+    msg: &[u8],
+    ctx: &[u8],
+    sig: &[u8],
+) -> bool {
+    use fips204::traits::{SerDes, Verifier};
+    macro_rules! run {
+        ($m:ident) => {{
+            let (Ok(k), Ok(s)) = (
+                <[u8; fips204::$m::PK_LEN]>::try_from(pk),
+                <[u8; fips204::$m::SIG_LEN]>::try_from(sig),
+            ) else {
+                return false;
+            };
+            let Ok(key) = fips204::$m::PublicKey::try_from_bytes(k) else {
+                return false;
+            };
+            key.hash_verify(msg, &s, ctx, ph)
+        }};
+    }
+    match scheme {
+        KdaScheme::MlDsa44 => run!(ml_dsa_44),
+        KdaScheme::MlDsa65 => run!(ml_dsa_65),
+        KdaScheme::MlDsa87 => run!(ml_dsa_87),
+    }
+}
+
+/// The verdict of one implementation on one ACVP test, or `None` when it exposes no entry point for the interface.
+fn acvp_outcome(imp: MlDsaImpl, scheme: KdaScheme, interface: &str, test: &Value) -> Option<bool> {
+    let pk = bytes(test, "pk");
+    let sig = bytes(test, "signature");
+    match interface {
+        "external/pure" => Some(pure(
+            imp,
+            scheme,
+            &pk,
+            &bytes(test, "message"),
+            &bytes(test, "context"),
+            &sig,
+        )),
+        "external/preHash" => {
+            let (msg, ctx) = (bytes(test, "message"), bytes(test, "context"));
+            let hash = test["hashAlg"].as_str().unwrap_or_default();
+            match imp {
+                MlDsaImpl::Fips204 => {
+                    let ph = match hash {
+                        "SHA2-256" => fips204::Ph::SHA256,
+                        "SHA2-512" => fips204::Ph::SHA512,
+                        "SHAKE-128" => fips204::Ph::SHAKE128,
+                        _ => return None,
+                    };
+                    Some(fips204_prehash(scheme, &ph, &pk, &msg, &ctx, &sig))
+                }
+                MlDsaImpl::Libcrux if hash == "SHAKE-128" => {
+                    Some(libcrux_shake128(scheme, &pk, &msg, &ctx, &sig))
+                }
+                _ => None,
+            }
+        }
+        "internal" => {
+            let m_prime = bytes(test, "message");
+            match imp {
+                MlDsaImpl::RustCrypto => Some(match scheme {
+                    KdaScheme::MlDsa44 => {
+                        rustcrypto_internal::<ml_dsa::MlDsa44>(&pk, &m_prime, &sig)
+                    }
+                    KdaScheme::MlDsa65 => {
+                        rustcrypto_internal::<ml_dsa::MlDsa65>(&pk, &m_prime, &sig)
+                    }
+                    KdaScheme::MlDsa87 => {
+                        rustcrypto_internal::<ml_dsa::MlDsa87>(&pk, &m_prime, &sig)
+                    }
+                }),
+                MlDsaImpl::Libcrux => Some(libcrux_internal(scheme, &pk, &m_prime, &sig)),
+                _ => None,
+            }
+        }
+        "internal/externalMu" => {
+            let mu = bytes(test, "mu");
+            match imp {
+                MlDsaImpl::RustCrypto => Some(match scheme {
+                    KdaScheme::MlDsa44 => rustcrypto_mu::<ml_dsa::MlDsa44>(&pk, &mu, &sig),
+                    KdaScheme::MlDsa65 => rustcrypto_mu::<ml_dsa::MlDsa65>(&pk, &mu, &sig),
+                    KdaScheme::MlDsa87 => rustcrypto_mu::<ml_dsa::MlDsa87>(&pk, &mu, &sig),
+                }),
+                _ => None,
+            }
+        }
+        other => panic!("unexpected ACVP interface {other}"),
+    }
+}
+
+fn interface_of(group: &Value) -> &'static str {
+    match (
+        group["signatureInterface"].as_str(),
+        group["preHash"].as_str(),
+        group["externalMu"].as_bool(),
+    ) {
+        (Some("external"), Some("pure"), _) => "external/pure",
+        (Some("external"), Some("preHash"), _) => "external/preHash",
+        (Some("internal"), _, Some(false)) => "internal",
+        (Some("internal"), _, Some(true)) => "internal/externalMu",
+        other => panic!("unexpected ACVP group {other:?}"),
+    }
+}
+
+#[test]
+fn every_implementation_passes_acvp_and_wycheproof() {
+    assert_eq!(sha256_hex(ACVP), ACVP_SHA256, "ACVP vector file changed");
+    for (scheme, text, sha) in WYCHEPROOF {
+        assert_eq!(
+            sha256_hex(text),
+            sha,
+            "Wycheproof {scheme} vector file changed"
+        );
+    }
+    for imp in MlDsaImpl::ALL {
+        assert!(imp.available(), "{imp} is not compiled in (feature `k8`)");
+    }
+
+    let mut tallies: BTreeMap<Key, Tally> = BTreeMap::new();
+    let mut failures = Vec::new();
+
+    let acvp: Value = serde_json::from_str(ACVP).unwrap();
+    for group in acvp["testGroups"].as_array().unwrap() {
+        let scheme = scheme_of(group["parameterSet"].as_str().unwrap());
+        let interface = interface_of(group);
+        for test in group["tests"].as_array().unwrap() {
+            let expected = test["testPassed"].as_bool().expect("testPassed");
+            for imp in MlDsaImpl::ALL {
+                let outcome = acvp_outcome(imp, scheme, interface, test);
+                if outcome.is_some_and(|accepted| accepted != expected) {
+                    failures.push(format!(
+                        "ACVP {imp} {scheme} {interface} tcId {}",
+                        test["tcId"]
+                    ));
+                }
+                record(
+                    &mut tallies,
+                    (imp.name(), "acvp", scheme.name(), interface.to_string()),
+                    outcome,
+                    expected,
+                );
+            }
+        }
+    }
+
+    for (scheme, text, _) in WYCHEPROOF {
+        let doc: Value = serde_json::from_str(text).unwrap();
+        for group in doc["testGroups"].as_array().unwrap() {
+            let pk = bytes(group, "publicKey");
+            for test in group["tests"].as_array().unwrap() {
+                let expected = match test["result"].as_str() {
+                    Some("valid") => true,
+                    Some("invalid") => false,
+                    other => panic!("unexpected Wycheproof result {other:?}"),
+                };
+                let (msg, ctx, sig) = (bytes(test, "msg"), bytes(test, "ctx"), bytes(test, "sig"));
+                for imp in MlDsaImpl::ALL {
+                    let accepted = pure(imp, scheme, &pk, &msg, &ctx, &sig);
+                    if accepted != expected {
+                        failures.push(format!(
+                            "Wycheproof {imp} {scheme} tcId {} ({})",
+                            test["tcId"], test["comment"]
+                        ));
+                    }
+                    record(
+                        &mut tallies,
+                        (
+                            imp.name(),
+                            "wycheproof",
+                            scheme.name(),
+                            "external/pure".to_string(),
+                        ),
+                        Some(accepted),
+                        expected,
+                    );
+                }
+            }
+        }
+    }
+
+    for ((imp, source, scheme, interface), t) in &tallies {
+        println!(
+            "K8-VECTORS impl={imp} source={source} scheme={scheme} interface={interface} run={} pass={} not_exposed={}",
+            t.run, t.pass, t.not_exposed
+        );
+    }
+    let mut per_impl: BTreeMap<(&str, &str), (usize, usize, usize)> = BTreeMap::new();
+    for ((imp, source, _, _), t) in &tallies {
+        let e = per_impl.entry((imp, source)).or_default();
+        e.0 += t.run;
+        e.1 += t.pass;
+        e.2 += t.not_exposed;
+    }
+    for ((imp, source), (run, pass, not_exposed)) in &per_impl {
+        println!(
+            "K8-VECTORS-TOTAL impl={imp} source={source} run={run} pass={pass} not_exposed={not_exposed}"
+        );
+    }
+
+    // The KDA route's interface (pure, with a context) runs on every implementation, for every vector.
+    for imp in MlDsaImpl::ALL {
+        for scheme in KdaScheme::ALL {
+            let t = &tallies[&(
+                imp.name(),
+                "acvp",
+                scheme.name(),
+                "external/pure".to_string(),
+            )];
+            assert_eq!(
+                (t.run, t.not_exposed),
+                (15, 0),
+                "{imp} {scheme}: every ACVP pure vector runs"
+            );
+        }
+    }
+    assert_eq!(per_impl[&("rustcrypto", "wycheproof")].0, 180 + 210 + 241);
+    assert!(
+        failures.is_empty(),
+        "{} vector failures:\n{}",
+        failures.len(),
+        failures.join("\n")
+    );
+}

+    use pqcrypto_traits::sign::{DetachedSignature as _, PublicKey as _};
+    macro_rules! run {
+        ($m:ident) => {{
+            let key = pqcrypto_mldsa::$m::PublicKey::from_bytes(public_key)
+                .map_err(|_| KdaError::MalformedPublicKey(scheme))?;
+            if sig.len() != scheme.signature_len() {

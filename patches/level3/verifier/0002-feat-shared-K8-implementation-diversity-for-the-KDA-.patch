+/// K8: a mode that names an implementation this build does not include fails closed.
+#[cfg(not(feature = "kda-fips204"))]
+#[test]
+fn unavailable_implementation_fails_closed() {
+    use user_decryption_signature::kda::{K8Mode, MlDsaImpl, verify_native_k8};
+    let (pk, sig) = keyed_scheme(KdaScheme::MlDsa44, DIGEST.as_slice());
+    assert!(!MlDsaImpl::Fips204.available());
+    for mode in [
+        K8Mode::Single(MlDsaImpl::Fips204),
+        K8Mode::Agree(MlDsaImpl::RustCrypto, MlDsaImpl::Fips204),
+    ] {
+        let got = verify_native_k8(mode, KdaScheme::MlDsa44, &pk, DIGEST.as_slice(), &sig);
+        assert!(got.is_err(), "{mode}: {got:?}");
+    }
+}

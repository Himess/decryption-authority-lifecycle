+// SPDX-License-Identifier: BSD-3-Clause-Clear
+pragma solidity ^0.8.24;
+
+// Phase 4, P2.3: the conformance kit's adapter for Zama fhEVM `main` with the lifecycle (Core, E1, E2), branch
+// lifecycle/level3. The kit itself (DecryptionAuthorityLifecycle.t.sol in this directory) is a byte-identical copy
+// of conformance/DecryptionAuthorityLifecycle.t.sol in the project.
+
+import {ACL} from "../../contracts/ACL.sol";
+import {FHEVMExecutor} from "../../contracts/FHEVMExecutor.sol";
+import {FheType} from "../../contracts/shared/FheType.sol";
+import {PauserSet} from "../../contracts/immutable/PauserSet.sol";
+import {HostContractsDeployerTestUtils} from "../../fhevm-foundry/HostContractsDeployerTestUtils.sol";
+import {aclAdd, fhevmExecutorAdd, pauserSetAdd} from "../../addresses/FHEVMHostAddresses.sol";
+import {ACL as ACL_v0_7_0} from "../acl/retirement/fixtures/ACL_v0_7_0.sol";
+import {DecryptionAuthorityLifecycleConformance, KitAccount} from "./DecryptionAuthorityLifecycle.t.sol";
+
+/// @dev Issues real handles through the executor and grants them, in one call.
+contract ZamaKitMinter {
+    function mint(uint256 pt, address holder) external returns (bytes32 h) {
+        h = FHEVMExecutor(fhevmExecutorAdd).trivialEncrypt(pt, FheType.Uint64);
+        ACL(aclAdd).allow(h, holder);
+        ACL(aclAdd).allow(h, address(this));
+    }
+
+    function grant(bytes32 h, address to) external {
+        ACL(aclAdd).allow(h, to);
+    }
+
+    function giveTransient(bytes32 h, address to) external {
+        ACL(aclAdd).allowTransient(h, to);
+    }
+}
+
+contract ZamaMainConformanceTest is HostContractsDeployerTestUtils, DecryptionAuthorityLifecycleConformance {
+    address internal constant OWNER = address(456);
+    address internal constant PAUSER = address(789);
+    address internal constant DELEGATION_CONTRACT = address(0xC0FFEE);
+
+    ACL internal acl;
+    ZamaKitMinter internal minter;
+
+    function setUp() public {
+        _deployACL(OWNER);
+        acl = ACL(aclAdd);
+        _deployPauserSet();
+        vm.prank(OWNER);
+        PauserSet(pauserSetAdd).addPauser(PAUSER);
+        _deployFHEVMExecutor(OWNER);
+        _deployHCULimit(OWNER);
+        minter = new ZamaKitMinter();
+    }
+
+    function kitRegistry() internal view override returns (address) {
+        return aclAdd;
+    }
+
+    function kitGivePersistent(address holder, uint256 salt) internal override returns (bytes32) {
+        return minter.mint(salt, holder);
+    }
+
+    function kitTransientRight(KitAccount who, uint256 salt)
+        internal
+        override
+        returns (KitAccount.Call memory, bytes32 h)
+    {
+        h = minter.mint(salt, address(minter));
+        return (KitAccount.Call(address(minter), abi.encodeCall(ZamaKitMinter.giveTransient, (h, address(who)))), h);
+    }
+
+    function kitGrantPaths(bytes32 h, address to, address)
+        internal
+        view
+        override
+        returns (KitAccount.Call[] memory calls, string[] memory names)
+    {
+        calls = new KitAccount.Call[](5);
+        names = new string[](5);
+        bytes32[] memory list = new bytes32[](1);
+        list[0] = h;
+        bytes[] memory inner = new bytes[](1);
+        inner[0] = abi.encodeCall(ACL.allow, (h, to));
+        calls[0] = KitAccount.Call(aclAdd, abi.encodeCall(ACL.allow, (h, to)));
+        names[0] = "allow";
+        calls[1] = KitAccount.Call(aclAdd, abi.encodeCall(ACL.allowTransient, (h, to)));
+        names[1] = "allowTransient";
+        calls[2] = KitAccount.Call(aclAdd, abi.encodeCall(ACL.allowForDecryption, (list)));
+        names[2] = "allowForDecryption";
+        calls[3] = KitAccount.Call(
+            aclAdd,
+            abi.encodeCall(ACL.delegateForUserDecryption, (to, DELEGATION_CONTRACT, uint64(block.timestamp + 1 days)))
+        );
+        names[3] = "delegateForUserDecryption";
+        calls[4] = KitAccount.Call(aclAdd, abi.encodeWithSignature("multicall(bytes[])", inner));
+        names[4] = "multicall(allow)";
+    }
+
+    function kitUseViews(bytes32 h, address a)
+        internal
+        pure
+        override
+        returns (KitAccount.Call[] memory calls, string[] memory names)
+    {
+        calls = new KitAccount.Call[](2);
+        names = new string[](2);
+        calls[0] = KitAccount.Call(aclAdd, abi.encodeCall(ACL.isAllowed, (h, a)));
+        names[0] = "isAllowed";
+        calls[1] = KitAccount.Call(aclAdd, abi.encodeCall(ACL.persistAllowed, (h, a)));
+        names[1] = "persistAllowed";
+    }
+
+    function kitPublicView(bytes32 h) internal pure override returns (KitAccount.Call memory) {
+        return KitAccount.Call(aclAdd, abi.encodeCall(ACL.isAllowedForDecryption, (h)));
+    }
+
+    function kitPublish(bytes32 h) internal pure override returns (KitAccount.Call memory) {
+        bytes32[] memory list = new bytes32[](1);
+        list[0] = h;
+        return KitAccount.Call(aclAdd, abi.encodeCall(ACL.allowForDecryption, (list)));
+    }
+
+    function kitCompute(bytes32 operand) internal pure override returns (KitAccount.Call memory) {
+        return KitAccount.Call(fhevmExecutorAdd, abi.encodeCall(FHEVMExecutor.fheAdd, (operand, operand, bytes1(0x00))));
+    }
+
+    function kitEngineExempt() internal pure override returns (bool) {
+        return true;
+    }
+
+    function kitDelegate(address account, address delegate, address contractAddr, bytes32 h)
+        internal
+        override
+        returns (bool)
+    {
+        minter.grant(h, contractAddr);
+        vm.prank(account);
+        acl.delegateForUserDecryption(delegate, contractAddr, uint64(block.timestamp + 30 days));
+        return true;
+    }
+
+    function kitOnBehalfViews(address account, address delegate, address contractAddr, bytes32 h)
+        internal
+        pure
+        override
+        returns (KitAccount.Call[] memory calls, string[] memory names)
+    {
+        calls = new KitAccount.Call[](2);
+        names = new string[](2);
+        calls[0] = KitAccount.Call(
+            aclAdd, abi.encodeCall(ACL.isHandleDelegatedForUserDecryption, (account, delegate, contractAddr, h))
+        );
+        names[0] = "isHandleDelegatedForUserDecryption";
+        calls[1] =
+            KitAccount.Call(aclAdd, abi.encodeCall(ACL.isDelegatedForUserDecryption, (account, delegate, contractAddr)));
+        names[1] = "isDelegatedForUserDecryption";
+    }
+
+    function kitPermitViews(address, uint256, address, uint256, bytes32)
+        internal
+        pure
+        override
+        returns (bool, KitAccount.Call[] memory, string[] memory)
+    {
+        return (false, new KitAccount.Call[](0), new string[](0)); // no on-chain permit
+    }
+
+    function kitUpgradeGuarded() internal pure override returns (bool) {
+        return true;
+    }
+
+    function kitUpgrader() internal pure override returns (address) {
+        return OWNER;
+    }
+
+    function kitUpgradeCall(address implementation) internal pure override returns (KitAccount.Call memory) {
+        return KitAccount.Call(aclAdd, abi.encodeWithSignature("upgradeToAndCall(address,bytes)", implementation, ""));
+    }
+
+    function kitNewCoreImplementation() internal override returns (address) {
+        return address(new ACL());
+    }
+
+    function kitImplementationWithoutCore() internal override returns (address) {
+        return address(new ACL_v0_7_0());
+    }
+
+    function kitRegistryBatch(KitAccount.Call[] memory calls)
+        internal
+        pure
+        override
+        returns (bool, KitAccount.Call memory)
+    {
+        bytes[] memory inner = new bytes[](calls.length);
+        for (uint256 i = 0; i < calls.length; i++) {
+            if (calls[i].target != aclAdd) return (false, KitAccount.Call(address(0), ""));
+            inner[i] = calls[i].data;
+        }
+        return (true, KitAccount.Call(aclAdd, abi.encodeWithSignature("multicall(bytes[])", inner)));
+    }
+
+    function kitHostileConditions(address account) internal override returns (string[] memory applied) {
+        vm.prank(PAUSER);

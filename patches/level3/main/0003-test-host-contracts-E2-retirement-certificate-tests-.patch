+// SPDX-License-Identifier: BSD-3-Clause-Clear
+pragma solidity ^0.8.24;
+
+import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
+
+/**
+ * @notice Test-only ERC-1271 wallet for the retirement-certificate tests (E2): one ECDSA owner signs for it, and the
+ *         owner drives it through `execute` (for example to designate the wallet's successor).
+ */
+contract CertificateWallet1271 {
+    error NotOwner(address caller);
+
+    address public immutable owner;
+
+    constructor(address owner_) {
+        owner = owner_;
+    }
+
+    function isValidSignature(bytes32 hash, bytes calldata signature) external view returns (bytes4) {
+        (address recovered, ECDSA.RecoverError err, ) = ECDSA.tryRecover(hash, signature);
+        return err == ECDSA.RecoverError.NoError && recovered == owner ? bytes4(0x1626ba7e) : bytes4(0xffffffff);
+    }
+
+    function execute(address target, bytes calldata data) external returns (bytes memory ret) {
+        if (msg.sender != owner) revert NotOwner(msg.sender);
+        bool ok;
+        (ok, ret) = target.call(data);
+        if (!ok) {
+            assembly {
+                revert(add(ret, 32), mload(ret))
+            }
+        }
+    }
+}
+
+/// @notice Test-only EIP-7702 delegate that accepts only signatures by the delegating EOA's own key.
+contract RootKeyDelegate7702 {
+    function isValidSignature(bytes32 hash, bytes calldata signature) external view returns (bytes4) {
+        (address recovered, ECDSA.RecoverError err, ) = ECDSA.tryRecover(hash, signature);
+        return
+            err == ECDSA.RecoverError.NoError && recovered == address(this) ? bytes4(0x1626ba7e) : bytes4(0xffffffff);
+    }
+}
+
+/// @notice Test-only EIP-7702 delegate that refuses every signature.
+contract RejectAllDelegate7702 {
+    function isValidSignature(bytes32, bytes calldata) external pure returns (bytes4) {
+        return 0xffffffff;
+    }
+}

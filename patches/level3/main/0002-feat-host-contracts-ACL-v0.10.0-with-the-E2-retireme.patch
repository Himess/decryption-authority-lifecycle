+            revert SenderCannotBeContractAddress(contractAddress);
+        }
+        if (delegate == msg.sender) {
+            revert SenderCannotBeDelegate(delegate);
+        }
+        if (delegate == WILDCARD_DELEGATION_ADDRESS) {

+        _upgrade(address(new ACL()), "");
+        ACL(aclAdd).reinitializeV10();
+        assertEq(_initializedVersion(), 11);
+        vm.expectRevert(Initializable.InvalidInitialization.selector);
+        ACL(aclAdd).reinitializeV10();
+    }

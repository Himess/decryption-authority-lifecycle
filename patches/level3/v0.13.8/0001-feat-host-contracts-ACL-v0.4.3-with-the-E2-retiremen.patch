+    ////////////////////////////////////////////////////////////////////////////
+    // U9 (Level 3): v0.4.2 -> v0.4.3 (E2 adds no state)
+    ////////////////////////////////////////////////////////////////////////////
+
+    /// @dev The EIP-712 digest of a retirement certificate (E2), computed independently of the ACL.
+    function _certificateDigest(
+        address account,
+        address successor,
+        uint256[] memory chainIds
+    ) internal pure returns (bytes32) {
+        bytes32 domain = keccak256(
+            abi.encode(
+                keccak256("EIP712Domain(string name,string version)"),
+                keccak256("DecryptionAuthorityLifecycle"),
+                keccak256("1")
+            )
+        );
+        bytes32 structHash = keccak256(
+            abi.encode(
+                keccak256("RetireAccount(address account,address successor,uint256[] chainIds)"),
+                account,
+                successor,
+                keccak256(abi.encodePacked(chainIds))
+            )
+        );
+        return keccak256(abi.encodePacked("\x19\x01", domain, structHash));
+    }
+
+    /// @dev E1 state written under v0.4.2 survives the upgrade, and a certificate works on it right away.
+    function test_U9_v042_to_v043_SuccessionStatePreserved_CertificateWorks() public {
+        (address dave, uint256 daveKey) = makeAddrAndKey("dave");
+        _deployProxyWith(address(new ACL_v0_4_2()));
+        _seedState();
+        _retireThree();
+        vm.prank(dave);
+        acl.designateSuccessor(carol);
+        vm.prank(carol);
+        acl.acceptSuccession(dave);
+        vm.prank(bob);
+        acl.raiseSuccessorDelay(30 days);
+        vm.prank(bob);
+        acl.designateSuccessor(carol);
+        vm.warp(block.timestamp + 7 days);
+        vm.prank(dave);
+        acl.confirmSuccessor();
+        (, uint64 bobConfirmableAt, ) = acl.pendingSuccessorOf(bob);
+
+        _upgrade(address(new ACL()), "reinitializeV7()");
+
+        assertEq(acl.getVersion(), "ACL v0.4.3");
+        assertEq(_initializedVersion(), 8);
+        _assertBaseStatePreserved();
+        _assertEnforced();
+        assertTrue(acl.supportsInterface(0x4b9ec076), "E2 declared");
+        assertEq(acl.successorOf(dave), carol);
+        (address pending, uint64 at, bool accepted) = acl.pendingSuccessorOf(bob);
+        assertEq(pending, carol);
+        assertEq(at, bobConfirmableAt);
+        assertFalse(accepted);
+        assertEq(acl.successorDelayOf(bob), 30 days);
+
+        uint256[] memory chainIds = new uint256[](1);
+        chainIds[0] = block.chainid;
+        (uint8 v, bytes32 r, bytes32 s) = vm.sign(daveKey, _certificateDigest(dave, carol, chainIds));
+        vm.prank(bob);
+        acl.retireAccountWithSig(dave, carol, chainIds, abi.encodePacked(r, s, v));
+        assertTrue(acl.isAccountRetired(dave));
+    }
+
+    /// @dev Zama's pattern: reinitializeV7 lands on exactly 8 from v0.4.2's version 7, and a second call reverts.
+    function test_reinitializeV7SucceedsOnUpgradePath() public {
+        _deployProxyWith(address(new ACL_v0_4_2()));

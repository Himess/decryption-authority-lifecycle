+    /**
+     * @notice Retires `account` on the strength of its signed retirement certificate (E2). Anyone may submit it, and
+     *         the submitter's own state does not matter. A certificate can only trigger the handover to the successor
+     *         the account confirmed beforehand: it designates, confirms and grants nothing, and it has no nonce, no
+     *         expiry and no cancellation.
+     * @dev Not pause-gated (R3). The checks run in this order:
+     *      1. `account` is not retired, else `AccountAlreadyRetired`;
+     *      2. `block.chainid` is in `chainIds`, else `CertificateWrongChain`;
+     *      3. `successor` is not null and is `account`'s confirmed successor, else `CertificateSuccessorMismatch`;
+     *      4. the signature is valid, code-first, else `InvalidRetirementCertificate`: no code means a 65-byte low-s
+     *         ECDSA signature by `account`; any code, a 7702 delegation indicator included, means ERC-1271 on
+     *         `account`, with no fallback to ECDSA.
+     *      The effects are those of `retireAccount()` called by `account`.
+     * @param account The account to retire.
+     * @param successor The successor the certificate names; it must be `account`'s confirmed successor.
+     * @param chainIds The chains on which the certificate is valid.
+     * @param signature `account`'s signature over the EIP-712 digest of `RetireAccount(account, successor, chainIds)`
+     *        in the chain-agnostic domain ("DecryptionAuthorityLifecycle", "1").
+     */
+    function retireAccountWithSig(
+        address account,
+        address successor,
+        uint256[] calldata chainIds,
+        bytes calldata signature
+    ) public virtual {
+        ACLRetirementStorage storage $ = _retired();
+        if ($.retired[account]) {
+            revert AccountAlreadyRetired(account);
+        }
+        bool listed;
+        for (uint256 i = 0; i < chainIds.length; i++) {
+            if (chainIds[i] == block.chainid) {
+                listed = true;
+                break;
+            }
+        }
+        if (!listed) {
+            revert CertificateWrongChain(block.chainid);
+        }
+        address confirmed = $.succession[account].confirmed;
+        if (successor == address(0) || successor != confirmed) {
+            revert CertificateSuccessorMismatch(confirmed, successor);
         }
-        emit AccountRetired(msg.sender, succession.confirmed);
+        bytes32 structHash = keccak256(
+            abi.encode(RETIRE_ACCOUNT_TYPEHASH, account, successor, keccak256(abi.encodePacked(chainIds)))
+        );
+        bytes32 digest = MessageHashUtils.toTypedDataHash(RETIREMENT_CERTIFICATE_DOMAIN_SEPARATOR, structHash);
+        if (!SignatureChecker.isValidSignatureNow(account, digest, signature)) {
+            revert InvalidRetirementCertificate(account);
+        }
+        _retire($, account);
     }
 

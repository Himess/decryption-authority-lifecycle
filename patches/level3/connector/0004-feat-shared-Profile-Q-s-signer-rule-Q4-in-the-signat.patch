+//! [lifecycle Level 3] Profile Q's signer rule (Q4) in the signature check, with a mocked provider that pins the exact
+//! RPC sequence (as in `profile_h.rs`): before `B_Q` Profile H applies unchanged; at or after `B_Q` a signer
+//! authenticated by ECDSA (no code, an EIP-7702 indicator) is refused with no ERC-1271 call in both variants; regular
+//! code, an EIP-7851 ECDSA-disabled indicator included, goes to ERC-1271 only, with no fallback, in the no-root-ECDSA
+//! variant, and is refused with no call in the strict variant; E3 signers are accepted in both.
+
+use alloy::{
+    primitives::{Address, B256, Bytes, U64},
+    providers::{Provider, ProviderBuilder, mock::Asserter},
+    signers::{SignerSync, local::PrivateKeySigner},
+};
+use user_decryption_signature::{
+    AcceptPath, AttemptState, CodeFirstMode, Disposition, ERC1271_MAGIC_VALUE, Erc1271Error,
+    PqOnlyVariant, ProfileQ, SignatureInput, SignaturePolicy, verify_user_decryption_signature,
+};
+
+const BLOCK: u64 = 100;
+const VARIANTS: [PqOnlyVariant; 2] = [PqOnlyVariant::NoRootEcdsa, PqOnlyVariant::Strict];
+
+fn provider(asserter: &Asserter) -> impl Provider {
+    ProviderBuilder::new()
+        .disable_recommended_fillers()
+        .connect_mocked_client(asserter.clone())
+}
+
+fn rpcs_left(a: &Asserter) -> usize {
+    a.read_q().len()
+}
+
+/// Profile H in `mode`, with Profile Q `variant` activated at `b_q`.
+fn policy(mode: CodeFirstMode, variant: PqOnlyVariant, b_q: u64) -> SignaturePolicy {
+    SignaturePolicy {
+        mode,
+        profile_q: Some(ProfileQ {
+            variant,
+            activation_block: b_q,
+        }),
+        ..SignaturePolicy::default()
+    }
+}
+
+/// A key, its address and a valid 65-byte signature over `digest`.
+fn signed(digest: B256) -> (Address, Vec<u8>) {
+    let key = PrivateKeySigner::random();
+    let sig = key.sign_hash_sync(&digest).unwrap().as_bytes().to_vec();
+    (key.address(), sig)
+}
+
+fn input(signer: Address, digest: B256, signature: &[u8]) -> SignatureInput<'_> {
+    SignatureInput {
+        signer,
+        digest,
+        signature,
+        public_key_len: 800,
+        extra_data_len: 1,
+    }
+}
+
+fn magic() -> Bytes {
+    let mut r = [0u8; 32];
+    r[..4].copy_from_slice(&ERC1271_MAGIC_VALUE);
+    Bytes::copy_from_slice(&r)
+}
+
+fn indicator(prefix: [u8; 3], delegate: Address) -> Bytes {
+    let mut c = prefix.to_vec();
+    c.extend_from_slice(delegate.as_slice());
+    Bytes::from(c)
+}
+
+fn regular_code() -> Bytes {
+    Bytes::from(vec![0x60, 0x80, 0x60, 0x40, 0x52])
+}
+
+fn assert_refused_without_call(
+    out: &user_decryption_signature::Outcome,
+    variant: PqOnlyVariant,
+    signer: Address,
+) {
+    let r = out.result.as_ref().expect_err("refused");
+    assert!(
+        matches!(&r.error, Erc1271Error::ProfileQRefused { account, variant: v, .. } if *account == signer && *v == variant),
+        "{:?}",
+        r.error
+    );
+    assert_eq!(r.disposition, Disposition::Final);
+    assert_eq!(r.erc1271_calls, 0);
+    assert_eq!(r.block, Some(BLOCK));
+}
+
+#[tokio::test]
+async fn before_b_q_profile_h_applies_unchanged() {
+    let digest = B256::repeat_byte(1);
+    let (signer, sig) = signed(digest);
+    for variant in VARIANTS {
+        // Enforce: block (read once, shared with Profile H), then the code: no code, a 65-byte ECDSA signature.
+        let a = Asserter::new();
+        a.push_success(&U64::from(BLOCK));
+        a.push_success(&Bytes::new());
+        let out = verify_user_decryption_signature(
+            &provider(&a),
+            &input(signer, digest, &sig),
+            &policy(CodeFirstMode::Enforce, variant, BLOCK + 1),
+            AttemptState::default(),
+        )
+        .await;
+        assert_eq!(out.result.unwrap().path, AcceptPath::Ecrecover, "{variant}");
+        assert_eq!(rpcs_left(&a), 0);
+    }
+}
+
+#[tokio::test]
+async fn ecdsa_signers_are_refused_without_any_erc1271_call() {
+    let digest = B256::repeat_byte(2);
+    let (signer, sig) = signed(digest);
+    for variant in VARIANTS {
+        // Engaged at B_Q exactly; the mode does not matter once engaged.
+        for mode in [
+            CodeFirstMode::Off,
+            CodeFirstMode::Shadow,
+            CodeFirstMode::Enforce,
+        ] {
+            // No code: the account's own key, outside the E3 route.
+            let a = Asserter::new();
+            a.push_success(&U64::from(BLOCK));
+            a.push_success(&Bytes::new());
+            let out = verify_user_decryption_signature(
+                &provider(&a),
+                &input(signer, digest, &sig),
+                &policy(mode, variant, BLOCK),
+                AttemptState::default(),
+            )
+            .await;
+            assert_refused_without_call(&out, variant, signer);
+            assert_eq!(rpcs_left(&a), 0);
+
+            // An EIP-7702 indicator, whatever the delegate would answer: nothing is called (no shim either).
+            let a = Asserter::new();
+            a.push_success(&U64::from(BLOCK));
+            a.push_success(&indicator([0xef, 0x01, 0x00], Address::repeat_byte(9)));
+            let out = verify_user_decryption_signature(
+                &provider(&a),
+                &input(signer, digest, &sig),
+                &policy(mode, variant, BLOCK - 5),
+                AttemptState::default(),
+            )
+            .await;
+            assert_refused_without_call(&out, variant, signer);
+            assert_eq!(rpcs_left(&a), 0);
+        }
+    }
+}
+
+#[tokio::test]
+async fn no_root_ecdsa_accepts_regular_code_and_eip7851_through_erc1271_only() {
+    let digest = B256::repeat_byte(3);
+    let signer = Address::repeat_byte(4);
+    let sig = vec![0x55u8; 2_420]; // what the wallet checks is its business; the mock answers the magic value
+    for code in [
+        regular_code(),
+        indicator([0xef, 0x01, 0x01], Address::repeat_byte(9)),
+    ] {
+        let a = Asserter::new();
+        a.push_success(&U64::from(BLOCK));
+        a.push_success(&code);
+        a.push_success(&magic());
+        let out = verify_user_decryption_signature(
+            &provider(&a),
+            &input(signer, digest, &sig),
+            &policy(CodeFirstMode::Enforce, PqOnlyVariant::NoRootEcdsa, BLOCK),
+            AttemptState::default(),
+        )
+        .await;
+        let v = out.result.unwrap();
+        assert_eq!(v.path, AcceptPath::Erc1271);
+        assert_eq!(v.erc1271_calls, 1);
+        assert_eq!(rpcs_left(&a), 0);
+    }
+}
+
+#[tokio::test]
+async fn no_fallback_of_any_kind_under_profile_q() {
+    // An EIP-7851 account whose delegate returns nothing, signed with the (disabled) root key: under Profile H the shim
+    // is for 0xef0100 only; under Profile Q there is no shim at all. The empty return is a counted negative.
+    let digest = B256::repeat_byte(5);
+    let (signer, sig) = signed(digest);
+    let a = Asserter::new();
+    a.push_success(&U64::from(BLOCK));
+    a.push_success(&indicator([0xef, 0x01, 0x01], Address::repeat_byte(9)));
+    a.push_success(&Bytes::new());
+    let out = verify_user_decryption_signature(
+        &provider(&a),
+        &input(signer, digest, &sig),
+        &policy(CodeFirstMode::Enforce, PqOnlyVariant::NoRootEcdsa, BLOCK),
+        AttemptState::default(),
+    )
+    .await;
+    let r = out.result.unwrap_err();
+    assert_eq!(r.error, Erc1271Error::EmptyReturn(signer));
+    assert_eq!(r.disposition, Disposition::RetryNextBlock);
+    assert_eq!(out.attempts.negatives, 1);
+    assert_eq!(rpcs_left(&a), 0);
+}
+
+#[tokio::test]
+async fn strict_refuses_regular_code_without_any_call() {
+    let digest = B256::repeat_byte(6);
+    let signer = Address::repeat_byte(7);
+    let sig = vec![0x55u8; 2_420];
+    for code in [
+        regular_code(),
+        indicator([0xef, 0x01, 0x01], Address::repeat_byte(9)),
+    ] {
+        let a = Asserter::new();
+        a.push_success(&U64::from(BLOCK));
+        a.push_success(&code);
+        let out = verify_user_decryption_signature(
+            &provider(&a),
+            &input(signer, digest, &sig),
+            &policy(CodeFirstMode::Enforce, PqOnlyVariant::Strict, BLOCK),
+            AttemptState::default(),
+        )
+        .await;
+        assert_refused_without_call(&out, PqOnlyVariant::Strict, signer);
+        assert_eq!(rpcs_left(&a), 0);
+    }
+}
+
+#[tokio::test]
+async fn h4_attempts_still_bound_erc1271_under_profile_q() {
+    let digest = B256::repeat_byte(8);
+    let signer = Address::repeat_byte(10);
+    let sig = vec![0x55u8; 2_420];
+    // A negative at B already: the retry must wait for a later block, and nothing is called.
+    let a = Asserter::new();
+    a.push_success(&U64::from(BLOCK));
+    a.push_success(&regular_code());
+    let out = verify_user_decryption_signature(
+        &provider(&a),
+        &input(signer, digest, &sig),
+        &policy(CodeFirstMode::Enforce, PqOnlyVariant::NoRootEcdsa, BLOCK),
+        AttemptState {
+            negatives: 1,
+            last_negative_block: Some(BLOCK),
+        },
+    )
+    .await;
+    let r = out.result.unwrap_err();
+    assert_eq!(r.disposition, Disposition::AwaitingNextBlock);
+    assert_eq!(r.erc1271_calls, 0);
+    assert_eq!(rpcs_left(&a), 0);
+}
+
+#[tokio::test]
+async fn caps_come_first_and_transport_errors_are_left_to_the_caller() {
+    let digest = B256::repeat_byte(11);
+    let signer = Address::repeat_byte(12);
+    // H1 caps: before any RPC (nothing queued).
+    let big = vec![0x11u8; 65_537];
+    let a = Asserter::new();
+    let out = verify_user_decryption_signature(
+        &provider(&a),
+        &input(signer, digest, &big),
+        &policy(CodeFirstMode::Enforce, PqOnlyVariant::Strict, 0),
+        AttemptState::default(),
+    )
+    .await;
+    assert!(matches!(
+        out.result.unwrap_err().error,
+        Erc1271Error::CapExceeded { .. }
+    ));
+    // The block read fails: Transport, so the caller retries; nothing is decided.
+    let a = Asserter::new();
+    a.push_failure_msg("connection refused");
+    let out = verify_user_decryption_signature(
+        &provider(&a),
+        &input(signer, digest, &[0x11u8; 65]),
+        &policy(CodeFirstMode::Enforce, PqOnlyVariant::Strict, 0),
+        AttemptState::default(),
+    )
+    .await;
+    assert_eq!(out.result.unwrap_err().disposition, Disposition::Transport);
+}
+
+#[test]
+fn variants_parse_and_print() {
+    for v in VARIANTS {
+        assert_eq!(v.to_string().parse::<PqOnlyVariant>().unwrap(), v);
+    }
+    assert!("no-root".parse::<PqOnlyVariant>().is_err());
+    let q = ProfileQ {
+        variant: PqOnlyVariant::Strict,
+        activation_block: 10,
+    };
+    assert!(!q.engaged_at(9));
+    assert!(q.engaged_at(10));
+    assert!(q.engaged_at(11));
+}
+
+#[cfg(feature = "kda")]
+mod e3 {
+    //! E3 signers are accepted in both variants; a KDA that is not routed (it has code) is not an E3 signer.
+    use super::*;
+    use ml_dsa::{MlDsa44, Seed, Signature, SigningKey};
+    use user_decryption_signature::kda::{
+        KdaOutcome, KdaScheme, KdaSkip, key_derived_address, request_signature, verify_with_kda,
+    };
+
+    const OWNER: Address = Address::repeat_byte(0xaa);
+
+    fn kda_request(digest: B256) -> (Address, Vec<u8>) {
+        let sk = SigningKey::<MlDsa44>::from_seed(&Seed::try_from(&[44u8; 32][..]).unwrap());
+        let esk = sk.expanded_key();
+        let sig: Signature<MlDsa44> = esk.sign_deterministic(digest.as_slice(), &[]).unwrap();
+        let pk = esk.verifying_key().encode().to_vec();
+        let signer_bytes = KdaScheme::MlDsa44.signer_bytes(&pk);
+        (
+            key_derived_address(&signer_bytes),
+            request_signature(&signer_bytes, &sig.encode()),
+        )
+    }
+
+    #[tokio::test]
+    async fn e3_signers_are_accepted_in_both_variants() {
+        let digest = B256::repeat_byte(13);
+        let (kda, signature) = kda_request(digest);
+        for variant in VARIANTS {
+            let a = Asserter::new();
+            a.push_success(&Bytes::new()); // eth_getCode(KDA): empty, the route is taken
+            let out = verify_with_kda(
+                &provider(&a),
+                &input(kda, digest, &signature),
+                &[OWNER],
+                &policy(CodeFirstMode::Enforce, variant, 0),
+                &KdaScheme::ALL,
+                AttemptState::default(),
+            )
+            .await;
+            assert_eq!(out, KdaOutcome::Kda(Ok(KdaScheme::MlDsa44)), "{variant}");
+            assert_eq!(rpcs_left(&a), 0);
+        }
+    }
+
+    #[tokio::test]
+    async fn a_kda_with_code_is_not_an_e3_signer_under_strict() {
+        let digest = B256::repeat_byte(14);
+        let (kda, signature) = kda_request(digest);
+        let a = Asserter::new();
+        a.push_success(&regular_code()); // the route's read: the KDA has code, so no route (K5)
+        a.push_success(&U64::from(BLOCK)); // Profile Q: block, then code at B
+        a.push_success(&regular_code());
+        let out = verify_with_kda(
+            &provider(&a),
+            &input(kda, digest, &signature),
+            &[OWNER],
+            &policy(CodeFirstMode::Enforce, PqOnlyVariant::Strict, BLOCK),
+            &KdaScheme::ALL,
+            AttemptState::default(),
+        )
+        .await;
+        let KdaOutcome::ProfileH { skip, outcome } = out else {
+            panic!("expected the Profile H path, got {out:?}");
+        };
+        assert_eq!(skip, KdaSkip::RequesterHasCode);
+        assert_refused_without_call(&outcome, PqOnlyVariant::Strict, kda);
+        assert_eq!(rpcs_left(&a), 0);
+    }
+}

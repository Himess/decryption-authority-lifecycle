+/// [lifecycle Level 3] Profile Q (Q4), engaged at `B`. A signer authenticated by ECDSA, that is one with no code or
+/// with an EIP-7702 delegation indicator, is refused with no ERC-1271 call; so is regular code in the strict variant.
+/// In the no-root-ECDSA variant regular code goes to ERC-1271 only, with no fallback of any kind: an EIP-7851
+/// ECDSA-disabled indicator (`0xef0101 ‖ delegate`) is regular code under H2, so such an account is treated as
+/// migrated.
+async fn profile_q_step<P: Provider>(
+    ctx: &mut Ctx<'_, P>,
+    q: ProfileQ,
+    attempts: &AttemptState,
+) -> Step {
+    let signer = ctx.input.signer;
+    let block = match ctx.block().await {
+        Ok(block) => block,
+        Err(e) => return Step::Reject(e, Kind::Transport),
+    };
+    let code = match ctx.code().await {
+        Ok(code) => code,
+        Err(e) => return Step::Reject(e, Kind::Transport),
+    };
+    let refuse = |reason: &'static str| {
+        Step::Reject(
+            Erc1271Error::ProfileQRefused {
+                account: signer,
+                variant: q.variant,
+                reason,
+            },
+            Kind::Final,
+        )
+    };
+    match (code, q.variant) {
+        (AccountCode::Empty, _) => {
+            return refuse("no code: an ECDSA-authenticated signer outside the E3 route");
+        }
+        (AccountCode::Eip7702 { .. }, _) => {
+            return refuse(
+                "an EIP-7702 delegation indicator: the account's ECDSA key still signs for it",
+            );
+        }
+        (AccountCode::Regular { .. }, PqOnlyVariant::Strict) => {
+            return refuse("the strict variant accepts E3 signers only");
+        }
+        (AccountCode::Regular { .. }, PqOnlyVariant::NoRootEcdsa) => {}
+    }
+    if let Some(held) = ctx.gate(attempts, block) {
+        return held;
+    }
+    match ctx.call().await {
+        Ok(CallOutcome::Magic) => Step::Accept(AcceptPath::Erc1271),
+        Ok(CallOutcome::EmptyReturn) => {
+            Step::Reject(Erc1271Error::EmptyReturn(signer), Kind::Negative)
+        }
+        Ok(CallOutcome::Short(len)) => Step::Reject(
+            Erc1271Error::Rejected(signer, format!("returndata length {len} < 32")),
+            Kind::Negative,
+        ),
+        Ok(CallOutcome::WrongMagic(magic)) => {
+            Step::Reject(Erc1271Error::WrongMagic(signer, magic), Kind::Negative)
+        }
+        Err(e) => negative_or_transport(e),
+    }
+}

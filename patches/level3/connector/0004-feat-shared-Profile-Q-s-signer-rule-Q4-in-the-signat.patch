+    /// Signers with regular code through ERC-1271 (an EIP-7851 ECDSA-disabled indicator included), and E3 signers.
+    NoRootEcdsa,
+    /// E3 signers only.
+    Strict,
+}
+
+impl PqOnlyVariant {
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::NoRootEcdsa => "no-root-ecdsa",
+            Self::Strict => "strict",
+        }
+    }
+}
+
+impl fmt::Display for PqOnlyVariant {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+impl FromStr for PqOnlyVariant {
+    type Err = String;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s.trim().to_ascii_lowercase().as_str() {
+            "no-root-ecdsa" => Ok(Self::NoRootEcdsa),
+            "strict" => Ok(Self::Strict),
+            other => Err(format!(
+                "unknown Profile Q variant `{other}` (expected `no-root-ecdsa` or `strict`)"
+            )),
+        }
+    }
+}

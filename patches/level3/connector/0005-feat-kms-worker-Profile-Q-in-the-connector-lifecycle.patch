+    /// [lifecycle Level 3, Profile Q1] Reads the operators' keys, the signed statement and the ICS, and establishes
+    /// Profile Q only if at least `threshold` operators' signatures verify under this node's K8 mode. A missing or
+    /// malformed file is a startup error; too few valid signatures leave the profile off. Profile Q requires Profile H
+    /// (Q2): its signer rule (Q4) runs inside Profile H's signature check.
+    fn establish_profile_q(
+        config: &Config,
+        profile_h: Option<&ProfileH>,
+        host_clients: &HashMap<u64, HostRpcClient<HP>>,
+    ) -> Option<Established> {
+        let q = &config.profile_q;
+        if !q.enabled {
+            return None;
+        }
+        let profile_h = profile_h.unwrap_or_else(|| panic!("profile_q requires profile_h (Q2)"));
+        if profile_h.kda_schemes.is_empty() {
+            warn!("PROFILE-Q: E3 is not enabled on this node; Q2 requires it before activation");
+        }
+        // The ACL this node actually reads on that chain.
+        let acl = host_clients
+            .get(&q.chain_id)
+            .map(|c| c.acl_address())
+            .unwrap_or_else(|| {
+                panic!(
+                    "profile_q.chain_id {} is not a configured host chain",
+                    q.chain_id
+                )
+            });
+        let file = |p: &Option<std::path::PathBuf>, name: &str| {
+            p.clone()
+                .unwrap_or_else(|| panic!("profile_q.{name} is required"))
+        };
+        let operators: profile_q::Operators =
+            profile_q::read_json(&file(&q.operators_file, "operators_file"))
+                .unwrap_or_else(|e| panic!("profile_q.operators_file: {e}"));
+        let signed: profile_q::SignedStatement =
+            profile_q::read_json(&file(&q.statement_file, "statement_file"))
+                .unwrap_or_else(|e| panic!("profile_q.statement_file: {e}"));
+        let ics = profile_q::file_keccak256(&file(&q.ics_file, "ics_file"))
+            .unwrap_or_else(|e| panic!("profile_q.ics_file: {e}"));
+        match profile_q::establish(
+            &signed,
+            &operators,
+            q.threshold,
+            q.chain_id,
+            acl,
+            ics,
+            profile_h.k8,
+        ) {
+            Ok(e) => {
+                info!(
+                    "PROFILE-Q established chain={} acl={} variant={} b_q={} statements={}/{} threshold={} k8={}",
+                    e.chain_id,
+                    e.acl,
+                    e.profile_q.variant,
+                    e.profile_q.activation_block,
+                    e.verified,
+                    e.operators,
+                    e.threshold,
+                    profile_h.k8,
+                );
+                Some(e)
+            }
+            Err(e) => {
+                warn!("PROFILE-Q not established chain={}: {e}", q.chain_id);
+                None
+            }
+        }
+    }
+
+    /// [lifecycle Level 3] Profile H's policy for a request on `host_client`'s chain, with Profile Q's signer rule (Q4)
+    /// when the profile is established for that chain.
+    fn signature_policy(
+        &self,
+        profile_h: &ProfileH,
+        host_client: &HostRpcClient<HP>,
+    ) -> SignaturePolicy {
+        let mut policy = profile_h.policy;
+        if let Some(q) = &self.profile_q
+            && q.chain_id == host_client.chain_id()
+        {
+            policy.profile_q = Some(q.profile_q);
+        }
+        policy
+    }
+
+    /// [lifecycle Level 3] Profile Q as established for `host_client`'s chain, if it is engaged at the latest block.
+    async fn profile_q_engaged(
+        &self,
+        host_client: &HostRpcClient<HP>,
+    ) -> Result<Option<(Established, u64)>, RequestCheckError> {
+        let Some(q) = self
+            .profile_q
+            .filter(|q| q.chain_id == host_client.chain_id())
+        else {
+            return Ok(None);
+        };
+        let block = host_client.block_number().await?;
+        Ok(q.profile_q.engaged_at(block).then_some((q, block)))
+    }
+
+    /// [lifecycle Level 3, Profile Q5] The delegation cutoff, after the registry's delegated view answered true: a
+    /// delegation from an ECDSA-rooted delegator counts only if one of its records (the per-contract one or the
+    /// wildcard) is active and unchanged since `B_Q`. Every read is at one block N. The records are read from the
+    /// ACL's storage, for a known layout only. A refusal is final: a record's last change can only move later.
+    async fn profile_q_cutoff(
+        &self,
+        host_client: &HostRpcClient<HP>,
+        delegator: Address,
+        delegate: Address,
+        contract: Address,
+    ) -> Result<(), RequestCheckError> {
+        let Some((q, block)) = self.profile_q_engaged(host_client).await? else {
+            return Ok(());
+        };
+        let b_q = q.profile_q.activation_block;
+        let slots = [
+            profile_q::delegation_slot(delegator, delegate, contract),
+            profile_q::delegation_slot(delegator, delegate, WILDCARD_DELEGATION_ADDRESS),
+        ];
+        let reads = host_client.cutoff_reads(delegator, slots, block).await?;
+        let Some(rooted) = profile_q::cutoff_applies(&reads.code) else {
+            info!(
+                "PROFILE-Q cutoff not applied delegator={delegator} delegate={delegate} contract={contract} \
+                block={block} b_q={b_q}: regular code"
+            );
+            return Ok(());
+        };
+        let refuse = |why: String| {
+            warn!(
+                "PROFILE-Q cutoff refused delegator={delegator} delegate={delegate} contract={contract} block={block} \
+                b_q={b_q} delegator_code=\"{rooted}\": {why}"
+            );
+            RequestCheckError::irrecoverable(
+                RequestCheckKind::Acl,
+                ErrorCode::AclDenied,
+                anyhow!(
+                    "Profile Q (Q5): the delegation from {delegator} to {delegate} does not count: {why}"
+                ),
+            )
+        };
+        if !profile_q::KNOWN_LAYOUT_VERSIONS.contains(&reads.version.as_str()) {
+            return Err(refuse(format!(
+                "unknown ACL layout `{}`, the cutoff cannot be established",
+                reads.version
+            )));
+        }
+        let records = reads.words.map(DelegationRecord::decode);
+        let rows = format!(
+            "contract(exp={},last={}) wildcard(exp={},last={}) timestamp={}",
+            records[0].expiration_date,
+            records[0].last_block_delegate_or_revoke,
+            records[1].expiration_date,
+            records[1].last_block_delegate_or_revoke,
+            reads.timestamp,
+        );
+        if records.iter().any(|r| r.counts(reads.timestamp, b_q)) {
+            info!(
+                "PROFILE-Q cutoff passed delegator={delegator} delegate={delegate} contract={contract} block={block} \
+                b_q={b_q} delegator_code=\"{rooted}\" {rows}"
+            );
+            Ok(())
+        } else {
+            Err(refuse(format!(
+                "no active record unchanged since B_Q; {rows}"
+            )))
         }
     }
 

+//! [lifecycle Level 3] Profile Q: the PQ-only operator policy of the Decryption Authority Lifecycle draft, for the
+//! off-chain request path. It is never an on-chain flag.
+//!
+//! - **Q1, trigger.** The profile is established only from the operators' statements: one statement (host chain, ACL,
+//!   variant, activation block `B_Q`, the ICS's keccak256), signed by each operator with a FIPS 204 key (ML-DSA-65).
+//!   It is established when at least `threshold` (n − t) distinct operators' signatures verify, under this node's K8
+//!   mode. Fewer never establish it, and no on-chain read can.
+//! - **Q4, signers.** Applied by the shared signature crate ([`ProfileQ`] in the policy); the ECDSA-only (legacy
+//!   gateway) path is refused by the worker.
+//! - **Q5, delegation cutoff.** A delegation from an ECDSA-rooted delegator counts only if its last change is at or
+//!   before `B_Q`. The registry has no getter for that block, so it is read from the ACL's ERC-7201 storage
+//!   (`UserDecryptionDelegation.lastBlockDelegateOrRevoke`) with `eth_getStorageAt`, only for an ACL version whose
+//!   layout is known; any other version fails closed.
+
+use alloy::primitives::{Address, B256, U256, keccak256};
+use serde::Deserialize;
+use std::{fmt, path::Path};
+use user_decryption_signature::{
+    PqOnlyVariant, ProfileQ,
+    kda::{K8Mode, KdaScheme, verify_native_k8},
+};
+
+/// Domain separator of a Profile Q activation statement (the signed bytes start with it).
+pub const STATEMENT_TAG: &[u8] = b"ERC-XXXX Profile Q activation statement v1\0";
+/// The operators' signature scheme.
+pub const OPERATOR_SCHEME: KdaScheme = KdaScheme::MlDsa65;
+
+/// ERC-7201 location of Zama's `ACLStorage` (namespace `fhevm.storage.ACL`), the same in ACL v0.7.0 (`main`) and in
+/// every lifecycle release on that line (v0.8.0, v0.9.0, v0.10.0).
+pub const ACL_STORAGE_LOCATION: B256 =
+    alloy::primitives::b256!("a688f31953c2015baaf8c0a488ee1ee22eb0e05273cc1fd31ea4cbee42febc00");
+/// Index of `userDecryptionDelegations` in `ACLStorage`.
+pub const DELEGATIONS_FIELD: u64 = 2;
+/// `ACL.WILDCARD_DELEGATION_ADDRESS`: `address(type(uint160).max)`.
+pub const WILDCARD_DELEGATION_ADDRESS: Address = Address::repeat_byte(0xff);
+/// ACL versions whose `ACLStorage` and `UserDecryptionDelegation` layout this module reads.
+pub const KNOWN_LAYOUT_VERSIONS: [&str; 4] =
+    ["ACL v0.7.0", "ACL v0.8.0", "ACL v0.9.0", "ACL v0.10.0"];
+
+/// One Profile Q activation statement (Q1). The operators sign [`Statement::message`].
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+pub struct Statement {
+    pub chain_id: u64,
+    pub acl: Address,
+    pub variant: String,
+    pub activation_block: u64,
+    pub ics_keccak256: B256,
+}
+
+impl Statement {
+    pub fn variant(&self) -> Result<PqOnlyVariant, String> {
+        self.variant.parse()
+    }
+
+    /// The signed bytes: tag ‖ chain id (8, big-endian) ‖ ACL (20) ‖ variant (1: no-root-ecdsa, 2: strict) ‖
+    /// `B_Q` (8, big-endian) ‖ the ICS's keccak256 (32).
+    pub fn message(&self) -> Result<Vec<u8>, String> {
+        let variant = match self.variant()? {
+            PqOnlyVariant::NoRootEcdsa => 1u8,
+            PqOnlyVariant::Strict => 2u8,
+        };
+        let mut m = STATEMENT_TAG.to_vec();
+        m.extend_from_slice(&self.chain_id.to_be_bytes());
+        m.extend_from_slice(self.acl.as_slice());
+        m.push(variant);
+        m.extend_from_slice(&self.activation_block.to_be_bytes());
+        m.extend_from_slice(self.ics_keccak256.as_slice());
+        Ok(m)
+    }
+}
+
+/// The signed statement file: the statement and one entry per signing operator.
+#[derive(Clone, Debug, Deserialize)]
+pub struct SignedStatement {
+    pub statement: Statement,
+    pub signatures: Vec<OperatorSignature>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct OperatorSignature {
+    /// Index into the operators file.
+    pub operator: usize,
+    pub signature: alloy::primitives::Bytes,
+}
+
+/// The operators file: the ML-DSA-65 public keys of the n operators, in index order.
+#[derive(Clone, Debug, Deserialize)]
+pub struct Operators {
+    pub scheme: String,
+    pub public_keys: Vec<alloy::primitives::Bytes>,
+}
+
+/// Profile Q as established for one host chain.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Established {
+    pub chain_id: u64,
+    pub acl: Address,
+    pub profile_q: ProfileQ,
+    /// Distinct operators whose signature verified, and how many were needed.
+    pub verified: usize,
+    pub threshold: usize,
+    pub operators: usize,
+}
+
+/// Why the statements did not establish Profile Q.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NotEstablished {
+    pub verified: usize,
+    pub threshold: usize,
+    pub operators: usize,
+    pub reason: String,
+}
+
+impl fmt::Display for NotEstablished {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            f,
+            "{} of {} operators' statements verify, {} needed: {}",
+            self.verified, self.operators, self.threshold, self.reason
+        )
+    }
+}
+
+/// Q1: counts the distinct operators whose signature over the statement verifies (under `k8`), and establishes Profile
+/// Q for `(chain_id, acl)` only if there are at least `threshold`. A statement for another chain or ACL, or bound to
+/// another ICS, establishes nothing. Signatures from unknown indices, duplicates and invalid signatures are not counted.
+pub fn establish(
+    signed: &SignedStatement,
+    operators: &Operators,
+    threshold: usize,
+    chain_id: u64,
+    acl: Address,
+    ics_keccak256: B256,
+    k8: K8Mode,
+) -> Result<Established, NotEstablished> {
+    let n = operators.public_keys.len();
+    let not = |verified: usize, reason: String| NotEstablished {
+        verified,
+        threshold,
+        operators: n,
+        reason,
+    };
+    if KdaScheme::from_name(&operators.scheme) != Some(OPERATOR_SCHEME) {
+        return Err(not(
+            0,
+            format!(
+                "operator scheme `{}`, expected {OPERATOR_SCHEME}",
+                operators.scheme
+            ),
+        ));
+    }
+    if threshold == 0 || threshold > n {
+        return Err(not(0, format!("threshold {threshold} with {n} operators")));
+    }
+    let s = &signed.statement;
+    if s.chain_id != chain_id || s.acl != acl {
+        return Err(not(
+            0,
+            format!(
+                "the statement is for chain {} ACL {}, this node serves chain {chain_id} ACL {acl}",
+                s.chain_id, s.acl
+            ),
+        ));
+    }
+    if s.ics_keccak256 != ics_keccak256 {
+        return Err(not(
+            0,
+            format!(
+                "the statement binds ICS {}, this node's ICS is {ics_keccak256}",
+                s.ics_keccak256
+            ),
+        ));
+    }
+    let variant = s.variant().map_err(|e| not(0, e))?;
+    let message = s.message().map_err(|e| not(0, e))?;
+    let mut counted = vec![false; n];
+    for entry in &signed.signatures {
+        let Some(pk) = operators.public_keys.get(entry.operator) else {
+            continue;
+        };
+        if counted[entry.operator] {
+            continue;
+        }
+        if verify_native_k8(k8, OPERATOR_SCHEME, pk, &message, &entry.signature).is_ok() {
+            counted[entry.operator] = true;
+        }
+    }
+    let verified = counted.iter().filter(|c| **c).count();
+    if verified < threshold {
+        return Err(not(verified, "below the threshold".to_string()));
+    }
+    Ok(Established {
+        chain_id,
+        acl,
+        profile_q: ProfileQ {
+            variant,
+            activation_block: s.activation_block,
+        },
+        verified,
+        threshold,
+        operators: n,
+    })
+}
+
+/// Reads a JSON file (a configuration error is a startup error).
+pub fn read_json<T: for<'de> Deserialize<'de>>(path: &Path) -> Result<T, String> {
+    let text = std::fs::read_to_string(path).map_err(|e| format!("{}: {e}", path.display()))?;
+    serde_json::from_str(&text).map_err(|e| format!("{}: {e}", path.display()))
+}
+
+/// `keccak256` of a file's bytes (the ICS the statement binds).
+pub fn file_keccak256(path: &Path) -> Result<B256, String> {
+    std::fs::read(path)
+        .map(keccak256)
+        .map_err(|e| format!("{}: {e}", path.display()))
+}
+
+/// `keccak256(abi.encode(key, slot))`: the slot of `mapping[key]` stored at `slot`.
+fn mapping_slot(key: Address, slot: B256) -> B256 {
+    let mut buf = [0u8; 64];
+    buf[12..32].copy_from_slice(key.as_slice());
+    buf[32..].copy_from_slice(slot.as_slice());
+    keccak256(buf)
+}
+
+/// Storage slot of `$.userDecryptionDelegations[delegator][delegate][contract]` in the ACL.
+pub fn delegation_slot(delegator: Address, delegate: Address, contract: Address) -> B256 {
+    let base =
+        B256::from(U256::from_be_bytes(ACL_STORAGE_LOCATION.0) + U256::from(DELEGATIONS_FIELD));
+    mapping_slot(
+        contract,
+        mapping_slot(delegate, mapping_slot(delegator, base)),
+    )
+}
+
+/// One `UserDecryptionDelegation` record: three `uint64` packed in one slot, the first field lowest.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct DelegationRecord {
+    pub expiration_date: u64,
+    pub last_block_delegate_or_revoke: u64,
+    pub delegation_counter: u64,
+}
+
+impl DelegationRecord {
+    pub fn decode(word: U256) -> Self {
+        let limbs = word.as_limbs();
+        Self {
+            expiration_date: limbs[0],
+            last_block_delegate_or_revoke: limbs[1],
+            delegation_counter: limbs[2],
+        }
+    }
+
+    /// Q5: active at `timestamp` and unchanged since `B_Q`.
+    pub fn counts(&self, timestamp: u64, activation_block: u64) -> bool {
+        self.expiration_date > timestamp && self.last_block_delegate_or_revoke <= activation_block
+    }
+}
+
+/// Whether Q5's cutoff applies to a delegator with this code, and why: no code and an EIP-7702 indicator are
+/// ECDSA-rooted; for an EIP-7851 ECDSA-disabled indicator this node cannot establish when the key was disabled, so the
+/// cutoff applies to every change. `None` for other code: not ECDSA-rooted, no cutoff.
+pub fn cutoff_applies(code: &[u8]) -> Option<&'static str> {
+    if code.is_empty() {
+        return Some("no code");
+    }
+    if code.len() == 23 && code[0] == 0xef && code[1] == 0x01 {
+        return match code[2] {
+            0x00 => Some("an EIP-7702 indicator"),
+            0x01 => Some("an EIP-7851 indicator, disabling block unknown"),
+            _ => None,
+        };
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alloy::primitives::address;
+
+    #[test]
+    fn delegation_slot_matches_an_independent_computation() {
+        // `cast index address <key> <slot>` three times from ACL_STORAGE_LOCATION + 2 (Foundry 1.8.5).
+        let delegator = address!("0x1111111111111111111111111111111111111111");
+        let delegate = address!("0x2222222222222222222222222222222222222222");
+        let contract = address!("0x3333333333333333333333333333333333333333");
+        assert_eq!(
+            delegation_slot(delegator, delegate, contract),
+            alloy::primitives::b256!(
+                "1a1838ba3d3be88d43697ca6abefe328c9de28c11d40fae2e727ceafb8da1416"
+            )
+        );
+    }
+
+    #[test]
+    fn record_decodes_the_packed_fields_lowest_first() {
+        let word =
+            U256::from(7u64) << 128 | U256::from(1234u64) << 64 | U256::from(1_800_000_000u64);
+        let r = DelegationRecord::decode(word);
+        assert_eq!(r.expiration_date, 1_800_000_000);
+        assert_eq!(r.last_block_delegate_or_revoke, 1234);
+        assert_eq!(r.delegation_counter, 7);
+        assert!(r.counts(1_799_999_999, 1234));
+        assert!(
+            !r.counts(1_800_000_000, 1234),
+            "expired at its expiration date"
+        );
+        assert!(!r.counts(1_700_000_000, 1233), "changed after B_Q");
+    }
+
+    #[test]
+    fn cutoff_applies_to_ecdsa_rooted_and_eip7851_delegators_only() {
+        let d = [0xabu8; 20];
+        let ind = |p: u8| [&[0xef, 0x01, p][..], &d[..]].concat();
+        assert_eq!(cutoff_applies(&[]), Some("no code"));
+        assert!(cutoff_applies(&ind(0x00)).is_some());
+        assert!(cutoff_applies(&ind(0x01)).is_some());
+        assert_eq!(cutoff_applies(&ind(0x02)), None);
+        assert_eq!(cutoff_applies(&[0x60, 0x80]), None);
+        assert_eq!(cutoff_applies(&[&ind(0x00)[..], &[0u8][..]].concat()), None);
+    }
+
+    #[test]
+    fn statement_message_layout() {
+        let s = Statement {
+            chain_id: 12345,
+            acl: Address::repeat_byte(0x11),
+            variant: "strict".into(),
+            activation_block: 77,
+            ics_keccak256: B256::repeat_byte(0x22),
+        };
+        let m = s.message().unwrap();
+        assert_eq!(m.len(), STATEMENT_TAG.len() + 8 + 20 + 1 + 8 + 32);
+        assert_eq!(&m[..STATEMENT_TAG.len()], STATEMENT_TAG);
+        assert_eq!(m[STATEMENT_TAG.len() + 28], 2);
+        let bad = Statement {
+            variant: "nope".into(),
+            ..s
+        };
+        assert!(bad.message().is_err());
+    }
+}

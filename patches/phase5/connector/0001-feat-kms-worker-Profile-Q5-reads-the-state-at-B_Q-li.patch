 }
 
 /// [lifecycle Level 3, Profile Q5] The host-chain reads behind one delegation cutoff decision, all at one block.
@@ -201,6 +206,47 @@ impl<P: Provider> HostRpcClient<P> {
             .map_err(|e| self.acl_err(e))
     }
 
+    /// [Phase 5, Profile Q5] An account's raw code at `block` (`B_Q`). `None` if the node cannot serve that state, for
+    /// example a pruned node: the caller then fails closed.
+    pub async fn code_at(&self, account: Address, block: u64) -> Option<Vec<u8>> {
+        self.acl_contract
+            .provider()
+            .get_code_at(account)
+            .block_id(BlockId::number(block))
+            .await
+            .ok()
+            .map(|c| c.to_vec())
+    }
+
+    /// [Phase 5, Profile Q5] `isAccountRetired(account)` and `successorOf(account)` at `block`. `None` for a value the
+    /// node cannot serve, or that the registry does not answer.
+    pub async fn retired_and_successor_at(&self, account: Address, block: u64) -> (Option<bool>, Option<Address>) {
+        let provider = self.acl_contract.provider();
+        let at = BlockId::number(block);
+        let acl = *self.acl_contract.address();
+        let retired = provider
+            .call(
+                TransactionRequest::default()
+                    .to(acl)
+                    .input(IAclLifecycleCore::isAccountRetiredCall { account }.abi_encode().into()),
+            )
+            .block(at)
+            .await
+            .ok()
+            .and_then(|r| IAclLifecycleCore::isAccountRetiredCall::abi_decode_returns(&r).ok());
+        let successor = provider
+            .call(
+                TransactionRequest::default()
+                    .to(acl)
+                    .input(IAclLifecycleSuccessor::successorOfCall { account }.abi_encode().into()),
+            )
+            .block(at)
+            .await
+            .ok()
+            .and_then(|r| IAclLifecycleSuccessor::successorOfCall::abi_decode_returns(&r).ok());
+        (retired, successor)
+    }
+

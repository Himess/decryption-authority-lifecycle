@@ -19,6 +19,11 @@ alloy::sol! {
     interface IAclLifecycleCore {
         function isAccountRetired(address account) external view returns (bool);
     }
+
+    /// [Phase 5] The E1 Successor view, for Profile Q5's succession cutoff.
+    interface IAclLifecycleSuccessor {

 use alloy::primitives::{Address, B256, U256, keccak256};
 use serde::Deserialize;
@@ -257,6 +260,31 @@ impl DelegationRecord {
     }
 }
 
+/// [Phase 5] Whether Q5's cutoff applies to a delegator, from its code now and its code at `B_Q`. Code adopted from a
+/// deployed contract (EIP-8298) reads like a contract's, so a delegator whose code is regular now but was empty or an
+/// indicator at `B_Q` adopted it after `B_Q`; this node cannot establish the adoption block, so the cutoff applies to
+/// every change since `B_Q`. `code_at_bq` is `None` when the state at `B_Q` cannot be read: a regular-code delegator
+/// then gets the cutoff too.
+pub fn cutoff_applies_at(code_now: &[u8], code_at_bq: Option<&[u8]>) -> Option<&'static str> {
+    if let Some(why) = cutoff_applies(code_now) {
+        return Some(why);
+    }
+    match code_at_bq {
+        None => Some("regular code, state at B_Q unavailable"),
+        Some(at_bq) if cutoff_applies(at_bq).is_some() => {
+            Some("regular code adopted after B_Q (adoption block unknown)")
+        }
+        Some(_) => None,
+    }
+}
+
+/// [Phase 5] Q5 for a succession: the registry's delegated view answers true for a retired account's confirmed
+/// successor, which a key that is still accepted after `B_Q` could have designated and confirmed. It counts only if the
+/// same successor was already confirmed at `B_Q` (`successor_at_bq`; `None` when the state at `B_Q` cannot be read).
+pub fn succession_counts(successor_now: Address, successor_at_bq: Option<Address>, delegate: Address) -> bool {
+    successor_now == delegate && delegate != Address::ZERO && successor_at_bq == Some(delegate)
+}
+
 /// Whether Q5's cutoff applies to a delegator with this code, and why: no code and an EIP-7702 indicator are
 /// ECDSA-rooted; for an EIP-7851 ECDSA-disabled indicator this node cannot establish when the key was disabled, so the
 /// cutoff applies to every change. `None` for other code: not ECDSA-rooted, no cutoff.
@@ -321,6 +349,36 @@ mod tests {
         assert_eq!(cutoff_applies(&[&ind(0x00)[..], &[0u8][..]].concat()), None);
     }
 
+    #[test]
+    fn cutoff_applies_to_code_adopted_after_b_q() {
+        let d = [0xabu8; 20];
+        let ind = |p: u8| [&[0xef, 0x01, p][..], &d[..]].concat();
+        let wallet = [0x60u8, 0x80, 0x60, 0x40, 0x52];
+        // Rooted now: as before, whatever the code at B_Q.
+        assert_eq!(cutoff_applies_at(&[], Some(&wallet)), Some("no code"));
+        assert!(cutoff_applies_at(&ind(0x01), None).is_some());
+        // Regular now and at B_Q: a contract, no cutoff.
+        assert_eq!(cutoff_applies_at(&wallet, Some(&wallet)), None);
+        // Regular now, empty or an indicator at B_Q: adopted after B_Q (EIP-8298), cutoff.
+        assert!(cutoff_applies_at(&wallet, Some(&[])).is_some());
+        assert!(cutoff_applies_at(&wallet, Some(&ind(0x00))).is_some());
+        assert!(cutoff_applies_at(&wallet, Some(&ind(0x01))).is_some());
+        // Regular now, state at B_Q unavailable: cutoff (fails closed).
+        assert!(cutoff_applies_at(&wallet, None).is_some());
+    }
+
+    #[test]
+    fn a_succession_counts_only_if_confirmed_at_b_q() {
+        let w = Address::repeat_byte(0x11);
+        let x = Address::repeat_byte(0x22);
+        assert!(succession_counts(w, Some(w), w));
+        assert!(!succession_counts(w, Some(Address::ZERO), w), "confirmed after B_Q");
+        assert!(!succession_counts(w, Some(x), w), "another successor at B_Q");
+        assert!(!succession_counts(w, None, w), "state at B_Q unavailable");
+        assert!(!succession_counts(x, Some(w), w), "not the successor now");
+        assert!(!succession_counts(Address::ZERO, Some(Address::ZERO), Address::ZERO));
+    }
+
